// Generated by tools/populate_case_matrix.py.
// openbsd/amd64: functional workload 1 and target data transport.
// Stack-machine execution with payload variants, generic results and large
// aggregate returns. Error paths must preserve the last committed stack.
variant Op { Push(i64), Add, Multiply, Divide, Duplicate, Halt }
struct Stack { slots: array<i64, 16>; used: i64; steps: i64; }
variant Run<T> { Done(T), Fault(i32, T) }

fun empty_stack() -> Stack {
    var result: Stack;
    var i: i64 = 0;
    while (i < 16) { result.slots[i] = 0; i += 1; }
    result.used = 0;
    result.steps = 0;
    return result;
}

fun execute(code: ptr<Op>, count: i64, initial: Stack) -> Run<Stack> {
    var state: Stack = initial;
    var pc: i64 = 0;
    while (pc < count) {
        var op: Op = code[pc];
        match op {
            Op::Push(value) => {
                if (state.used == 16) { return Run::Fault(1, state); }
                state.slots[state.used] = value;
                state.used += 1;
            }
            Op::Add => {
                if (state.used < 2) { return Run::Fault(2, state); }
                var right: i64 = state.used - 1;
                var left: i64 = state.used - 2;
                var rhs: i64 = state.slots[right];
                state.slots[left] += rhs;
                state.used -= 1;
            }
            Op::Multiply => {
                if (state.used < 2) { return Run::Fault(2, state); }
                var right: i64 = state.used - 1;
                var left: i64 = state.used - 2;
                var rhs: i64 = state.slots[right];
                state.slots[left] *= rhs;
                state.used -= 1;
            }
            Op::Divide => {
                if (state.used < 2) { return Run::Fault(2, state); }
                var right: i64 = state.used - 1;
                var left: i64 = state.used - 2;
                var rhs: i64 = state.slots[right];
                if (rhs == 0) { return Run::Fault(3, state); }
                state.slots[left] /= rhs;
                state.used -= 1;
            }
            Op::Duplicate => {
                if (state.used == 0) { return Run::Fault(2, state); }
                if (state.used == 16) { return Run::Fault(1, state); }
                var last: i64 = state.used - 1;
                state.slots[state.used] = state.slots[last];
                state.used += 1;
            }
            Op::Halt => { return Run::Done(state); }
        }
        state.steps += 1;
        pc += 1;
    }
    return Run::Fault(4, state);
}

fun exercise_language() -> i32 {
    var initial: Stack = empty_stack();
    var program: array<Op, 8> = [
        Op::Push(7), Op::Push(5), Op::Add, Op::Duplicate,
        Op::Multiply, Op::Push(3), Op::Divide, Op::Halt
    ];
    var success: Run<Stack> = execute(&program[0], 8, initial);
    match success {
        Run::Done(state) => {
            if (state.used != 1 || state.slots[0] != 48 || state.steps != 7) { return 1; }
        }
        Run::Fault(_, _) => { return 2; }
    }
    if (initial.used != 0 || initial.steps != 0 || initial.slots[0] != 0) { return 3; }
    var broken: array<Op, 4> = [Op::Push(41), Op::Push(0), Op::Divide, Op::Halt];
    var failure: Run<Stack> = execute(&broken[0], 4, initial);
    match failure {
        Run::Done(_) => { return 4; }
        Run::Fault(code, state) => {
            if (code != 3 || state.used != 2 || state.steps != 2) { return 5; }
            if (state.slots[0] != 41 || state.slots[1] != 0) { return 6; }
        }
    }
    var underflow: array<Op, 1> = [Op::Add];
    match execute(&underflow[0], 1, initial) {
        Run::Done(_) => { return 7; }
        Run::Fault(code, state) => {
            if (code != 2 || state.used != 0 || state.steps != 0) { return 8; }
        }
    }
    var full: Stack = empty_stack();
    full.used = 16;
    full.slots[15] = 9000000000;
    var overflow: array<Op, 1> = [Op::Duplicate];
    match execute(&overflow[0], 1, full) {
        Run::Done(_) => { return 9; }
        Run::Fault(code, state) => {
            if (code != 1 || state.used != 16 || state.slots[15] != 9000000000) { return 10; }
        }
    }
    return 0;
}

fun target_mix(state: u64, word: u64) -> u64 {
    var result: u64 = asm {
        "imul rax, rax, 33"
        "xor rax, rcx"
        in("rax") state
        in("rcx") word
        out("rax") result
    };
    return result % 65521;
}

// Feed actual records through the target's register calling convention, then
// compare each checkpoint to Wave arithmetic. Live copies and guard words must
// survive every call; the low and high halves of inputs both carry data.
struct TargetBlock { words: array<u64, 16>; digest: u64; guard: u64; }
fun target_block(seed: u64) -> TargetBlock {
    var block: TargetBlock;
    var i: i64 = 0;
    while (i < 16) {
        block.words[i] = 4294967296 + seed * 97 + (i as u64) * 65537;
        i += 1;
    }
    block.digest = seed;
    block.guard = 0xFEDCBA9876543210;
    return block;
}
fun target_workload() -> i32 {
    var round: u64 = 0;
    while (round < 65) {
        var block: TargetBlock = target_block(round);
        var snapshot: TargetBlock = block;
        var reference: u64 = round;
        var i: i64 = 0;
        while (i < 16) {
            var word: u64 = block.words[i];
            block.digest = target_mix(block.digest, word);
            reference = ((reference * 33) ^ word) % 65521;
            if (block.digest != reference) { return 201; }
            if (snapshot.words[i] != word || snapshot.digest != round) { return 202; }
            i += 1;
        }
        if (block.guard != 0xFEDCBA9876543210 || snapshot.guard != block.guard) { return 203; }
        round += 1;
    }
    return 0;
}

fun main() -> i32 {
    var status: i32 = exercise_language();
    if (status != 0) { return status; }
    status = target_workload();
    if (status != 0) { return status; }
    return 0;
}
