variant Slot { Empty, Deleted, Used(i64, i64) }
variant Found<T> { Value(T), Missing }
struct Table { slots: array<Slot, 32>; count: i64; rejected: bool; }
fun empty_table() -> Table {
    var table: Table;
    var i: i64 = 0;
    while (i < 32) { table.slots[i] = Slot::Empty; i += 1; }
    table.count = 0;
    table.rejected = false;
    return table;
}
fun put(table: Table, key: i64, value: i64) -> Table {
    var result: Table = table;
    result.rejected = false;
    var index: i64 = key % 32;
    var vacant: i64 = -1;
    var probes: i64 = 0;
    while (probes < 32) {
        match result.slots[index] {
            Slot::Used(stored, _) => {
                if (stored == key) {
                    result.slots[index] = Slot::Used(key, value);
                    return result;
                }
            }
            Slot::Deleted => { if (vacant == -1) { vacant = index; } }
            Slot::Empty => {
                if (vacant == -1) { vacant = index; }
                break;
            }
        }
        index = (index + 1) % 32;
        probes += 1;
    }
    if (vacant == -1) { result.rejected = true; return result; }
    result.slots[vacant] = Slot::Used(key, value);
    result.count += 1;
    return result;
}
fun get(table: Table, key: i64) -> Found<i64> {
    var index: i64 = key % 32;
    var probes: i64 = 0;
    while (probes < 32) {
        match table.slots[index] {
            Slot::Empty => { return Found::Missing; }
            Slot::Deleted => {}
            Slot::Used(stored, value) => {
                if (stored == key) { return Found::Value(value); }
            }
        }
        index = (index + 1) % 32;
        probes += 1;
    }
    return Found::Missing;
}
fun erase(table: Table, key: i64) -> Table {
    var result: Table = table;
    var index: i64 = key % 32;
    var probes: i64 = 0;
    while (probes < 32) {
        match result.slots[index] {
            Slot::Empty => { return result; }
            Slot::Deleted => {}
            Slot::Used(stored, _) => {
                if (stored == key) {
                    result.slots[index] = Slot::Deleted;
                    result.count -= 1;
                    return result;
                }
            }
        }
        index = (index + 1) % 32;
        probes += 1;
    }
    return result;
}
fun matches_value(value: Found<i64>, expected: i64) -> bool {
    match value {
        Found::Value(actual) => { return actual == expected; }
        Found::Missing => { return false; }
    }
}
fun exercise_language() -> i32 {
    var table: Table = empty_table();
    var i: i64 = 0;
    while (i < 24) { table = put(table, i * 32 + 3, i * i - 17); i += 1; }
    var snapshot: Table = table;
    i = 0;
    while (i < 24) { table = erase(table, i * 32 + 3); i += 2; }
    if (table.count != 12 || snapshot.count != 24) { return 1; }
    i = 24;
    while (i < 44) { table = put(table, i * 32 + 3, -i); i += 1; }
    if (table.count != 32 || table.rejected) { return 2; }
    i = 0;
    while (i < 44) {
        if (i < 24 && i % 2 == 0) {
            match get(table, i * 32 + 3) {
                Found::Value(_) => { return 3; }
                Found::Missing => {}
            }
        } else {
            var expected: i64 = -i;
            if (i < 24) { expected = i * i - 17; }
            if (!matches_value(get(table, i * 32 + 3), expected)) { return 4; }
        }
        i += 1;
    }
    table = put(table, 7 * 32 + 3, -9000000000);
    if (table.count != 32 || table.rejected) { return 5; }
    if (!matches_value(get(table, 227), -9000000000)) { return 6; }
    table = put(table, 55 * 32 + 3, 99);
    if (!table.rejected || table.count != 32) { return 7; }
    if (!matches_value(get(snapshot, 3), -17)) { return 8; }
    if (!matches_value(get(snapshot, 227), 32)) { return 9; }
    return 0;
}

fun target_mix(state: u64, word: u64) -> u64 {
    var result: u64 = asm {
        "imul rax, rax, 33"
        "xor rax, rcx"
        in("rax") state
        in("rcx") word
        out("rax") result
    };
    return result % 65521;
}

// Feed actual records through the target's register calling convention, then
// compare each checkpoint to Wave arithmetic. Live copies and guard words must
// survive every call; the low and high halves of inputs both carry data.
struct TargetBlock { words: array<u64, 16>; digest: u64; guard: u64; }
fun target_block(seed: u64) -> TargetBlock {
    var block: TargetBlock;
    var i: i64 = 0;
    while (i < 16) {
        block.words[i] = 4294967296 + seed * 97 + (i as u64) * 65537;
        i += 1;
    }
    block.digest = seed;
    block.guard = 0xFEDCBA9876543210;
    return block;
}
fun target_workload() -> i32 {
    var round: u64 = 0;
    while (round < 65) {
        var block: TargetBlock = target_block(round);
        var snapshot: TargetBlock = block;
        var reference: u64 = round;
        var i: i64 = 0;
        while (i < 16) {
            var word: u64 = block.words[i];
            block.digest = target_mix(block.digest, word);
            reference = ((reference * 33) ^ word) % 65521;
            if (block.digest != reference) { return 201; }
            if (snapshot.words[i] != word || snapshot.digest != round) { return 202; }
            i += 1;
        }
        if (block.guard != 0xFEDCBA9876543210 || snapshot.guard != block.guard) { return 203; }
        round += 1;
    }
    return 0;
}

fun main() -> i32 {
    var status: i32 = exercise_language();
    if (status != 0) { return status; }
    status = target_workload();
    if (status != 0) { return status; }
    return 0;
}
