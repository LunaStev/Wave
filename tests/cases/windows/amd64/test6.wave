// Windows page-backed storage grows across page boundaries and then shrinks.
// Counting sort uses a fixed 256-bin workspace, regardless of allocation size.
import("std::mem::alloc")::{mem_alloc_zeroed, mem_realloc, mem_free, mem_page_size};

struct Allocation {
    data: ptr<u8>;
    size: i64;
}

fun exercise(allocation: ptr<Allocation>, page: i64) -> i32 {
    var length: i64 = page + 19;
    var memory: ptr<u8> = allocation.data;
    var i: i64 = 0;
    while (i < allocation.size) {
        if (memory[i] != 0) {
            return 2;
        }
        i += 1;
    }
    i = 0;
    while (i < 8) {
        memory[i] = 173;
        var tail: i64 = 8 + length + i;
        memory[tail] = 219;
        i += 1;
    }
    i = 0;
    while (i < length) {
        var offset: i64 = i + 8;
        memory[offset] = ((i * 73 + 19) % 256) as u8;
        i += 1;
    }
    var grown_size: i64 = page * 2 + 35;
    var grown: ptr<u8> = mem_realloc(memory, allocation.size, grown_size);
    if (grown == null) {
        return 3;
    }
    allocation.data = grown;
    allocation.size = grown_size;
    i = 0;
    while (i < length) {
        var offset: i64 = i + 8;
        if (grown[offset] as i64 != (i * 73 + 19) % 256) {
            return 4;
        }
        i += 1;
    }
    i = 0;
    while (i < 8) {
        var tail: i64 = 8 + length + i;
        if (grown[i] != 173 || grown[tail] != 219) {
            return 5;
        }
        i += 1;
    }
    // Newly allocated bytes have no assumed value; initialize every byte read below.
    var old_length: i64 = length;
    length = page * 2 + 19;
    i = old_length;
    while (i < length) {
        var offset: i64 = i + 8;
        grown[offset] = ((i * 73 + 19) % 256) as u8;
        i += 1;
    }
    i = 0;
    while (i < 8) {
        var tail: i64 = 8 + length + i;
        grown[tail] = 219;
        i += 1;
    }
    var bins: array<i64, 256>;
    i = 0;
    while (i < 256) {
        bins[i] = 0;
        i += 1;
    }
    i = 0;
    while (i < length) {
        var offset: i64 = i + 8;
        var value: i64 = grown[offset] as i64;
        bins[value] += 1;
        i += 1;
    }
    var written: i64 = 0;
    var value: i64 = 0;
    while (value < 256) {
        // 73 has inverse 249 modulo 256; compute each bucket independently.
        var residue: i64 = ((value + 256 - 19) * 249) % 256;
        var expected: i64 = length / 256;
        if (residue < length % 256) {
            expected += 1;
        }
        if (bins[value] != expected) {
            return 6;
        }
        var count: i64 = 0;
        while (count < bins[value]) {
            var offset: i64 = written + 8;
            grown[offset] = value as u8;
            written += 1;
            count += 1;
        }
        value += 1;
    }
    if (written != length) {
        return 7;
    }
    i = 0;
    while (i < 8) {
        var tail: i64 = 8 + length + i;
        if (grown[i] != 173 || grown[tail] != 219) {
            return 8;
        }
        i += 1;
    }
    var retained: i64 = page + 19;
    var shrunk: ptr<u8> = mem_realloc(grown, grown_size, retained + 8);
    if (shrunk == null) {
        return 9;
    }
    allocation.data = shrunk;
    allocation.size = retained + 8;
    i = 0;
    while (i < 8) {
        if (shrunk[i] != 173) {
            return 10;
        }
        i += 1;
    }
    var position: i64 = 0;
    value = 0;
    while (value < 256 && position < retained) {
        var count: i64 = 0;
        while (count < bins[value] && position < retained) {
            var offset: i64 = position + 8;
            if (shrunk[offset] as i64 != value) {
                return 11;
            }
            position += 1;
            count += 1;
        }
        value += 1;
    }
    if (position != retained) {
        return 12;
    }
    return 0;
}

fun main() -> i32 {
    var page: i64 = mem_page_size();
    if (page <= 0 || page > 65536) {
        return 1;
    }
    var allocation: Allocation = Allocation {
        data: mem_alloc_zeroed(page + 35),
        size: page + 35
    };
    if (allocation.data == null) {
        return 1;
    }
    var status: i32 = exercise(&allocation, page);
    if (mem_free(allocation.data, allocation.size) < 0 && status == 0) {
        status = 13;
    }
    return status;
}
