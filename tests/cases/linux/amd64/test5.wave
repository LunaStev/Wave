// wave-test: runner=server
// =========================
// Linux x86_64 syscalls
// args: rax, rdi, rsi, rdx, r10, r8, r9
// =========================

fun len(s: str) -> i32 {
    var i: i32 = 0;
    while (s[i] != 0) {
        i += 1;
    }
    return i;
}

fun syscall0(id: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        out("rax") ret
    }
    return ret;
}

fun syscall1(id: i64, a1: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        out("rax") ret
    }
    return ret;
}

fun syscall2(id: i64, a1: i64, a2: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        in("rsi") a2
        out("rax") ret
    }
    return ret;
}

fun syscall3(id: i64, a1: i64, a2: i64, a3: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        in("rsi") a2
        in("rdx") a3
        out("rax") ret
    }
    return ret;
}

fun syscall3pi(id: i64, a1: i64, p2: ptr<i8>, a3: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        in("rsi") p2
        in("rdx") a3
        out("rax") ret
    }
    return ret;
}

fun syscall4(id: i64, a1: i64, a2: i64, a3: i64, a4: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        in("rsi") a2
        in("rdx") a3
        in("r10") a4
        out("rax") ret
    }
    return ret;
}

fun syscall5(id: i64, a1: i64, a2: i64, a3: i64, p4: ptr<i8>, a5: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        in("rsi") a2
        in("rdx") a3
        in("r10") p4
        in("r8")  a5
        out("rax") ret
    }
    return ret;
}


// =========================
// socket helpers
// =========================

fun htons(x: i16) -> i16 {
    var a: i32 = x;
    var y: i32 = ((a & 255) << 8) | ((a >> 8) & 255);
    return y as i16;
}

fun _setsockopt_reuseaddr(sockfd: i64) {
    // SOL_SOCKET = 1, SO_REUSEADDR = 2
    var one: i32 = 1;
    syscall5(54, sockfd, 1, 2, &one as ptr<i8>, 4);
}

struct SockAddrIn {
    sin_family: i16;        // AF_INET = 2
    sin_port: i16;          // network byte order
    sin_addr: i32;          // INADDR_ANY = 0
    sin_zero: array<u8, 8>;
}

// bind needs sockaddr* typed pointer.
// If your compiler cannot pass ptr<SockAddrIn> into ptr<i8>,
// keep this specialized syscall for sockaddr.
fun syscall3p_sockaddr(id: i64, a1: i64, p2: ptr<SockAddrIn>, a3: i64) -> i64 {
    var ret: i64;
    asm {
        "syscall"
        in("rax") id
        in("rdi") a1
        in("rsi") p2
        in("rdx") a3
        out("rax") ret
    }
    return ret;
}

fun _socket_create_tcp() -> i64 {
    return syscall3(41, 2, 1, 0);
}

fun _socket_bind_any(sockfd: i64, port: i16) -> i64 {
    var addr: SockAddrIn = SockAddrIn {
        sin_family: 2,
        sin_port: htons(port),
        sin_addr: 0,
        sin_zero: [0,0,0,0,0,0,0,0]
    };

    return syscall3p_sockaddr(49, sockfd, &addr, 16);
}

fun _socket_listen(sockfd: i64, backlog: i64) -> i64 {
    return syscall2(50, sockfd, backlog);
}

fun _socket_accept(sockfd: i64) -> i64 {
    return syscall3(43, sockfd, 0, 0);
}

fun _socket_close(fd: i64) {
    syscall1(3, fd);
}

fun _write(fd: i64, buf: str, len: i64) -> i64 {
    // If your compiler represents `str` as i8*, this will work with syscall3pi.
    return syscall3pi(1, fd, buf, len);
}

// =========================
// server logic
// =========================

fun new_server(port: i16) -> i64 {
    var sockfd: i64 = _socket_create_tcp();
    if (sockfd < 0) {
        if (sockfd == -1 || sockfd == -13) { println("WAVE-SERVER-UNAVAILABLE {}", sockfd); }
        return -1;
    }
    _setsockopt_reuseaddr(sockfd);

    var b: i64 = _socket_bind_any(sockfd, port);
    println("bind ret = {}", b);

    if (b < 0) {
        if (b == -1 || b == -13) { println("WAVE-SERVER-UNAVAILABLE {}", b); }
        _socket_close(sockfd);
        return -1;
    }

    return sockfd;
}

fun listen(server_fd: i64, backlog: i64) -> i64 {
    if (_socket_listen(server_fd, backlog) < 0) {
        println("Error: Failed to listen on socket.");
        return -1;
    }
    println("Server is listening...");
    return server_fd;
}

fun start(server_fd: i64) {
    println("Server accepting connections...");

    while (true) {
        var client_fd: i64 = _socket_accept(server_fd);

        if (client_fd < 0) {
            println("accept failed: {}", client_fd);
            continue;
        }

        println("Client connected! fd: {}", client_fd);

        var request: array<u8, 1024>;
        var used: i64 = 0;
        while (used < 1024) {
            var count: i64 = syscall3pi(0, client_fd, &request[used] as ptr<i8>, 1024 - used);
            if (count <= 0) { break; }
            used += count;
            if (used >= 4 && request[used - 4] == 13 && request[used - 3] == 10 && request[used - 2] == 13 && request[used - 1] == 10) { break; }
        }
        var response: str = "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nWelcome to the Wave HTTP Server!\n";
        write_all(client_fd, response as ptr<i8>, len(response) as i64);
        write_all(client_fd, &request[0] as ptr<i8>, used);

        _socket_close(client_fd);
        println("Client disconnected.");
    }
}

fun write_all(fd: i64, buffer: ptr<i8>, size: i64) {
    var sent: i64 = 0;
    while (sent < size) {
        var count: i64 = syscall3pi(1, fd, buffer + sent, size - sent);
        if (count <= 0) { return; }
        sent += count;
    }
}

fun main() -> i32 {
    var server_instance: i64 = new_server(0).listen(10);
    if (server_instance < 0) { return 1; }
    var address: SockAddrIn;
    var address_size: i32 = 16;
    var result: i64 = syscall3(51, server_instance, &address as i64, &address_size as i64);
    if (result < 0) { return 2; }
    var network_port: u16 = address.sin_port as u16;
    var port: u32 = ((network_port as u32 & 255) << 8) | (network_port as u32 >> 8);
    // The runner captures stdout, so publish readiness without stdio buffering.
    var prefix: str = "WAVE-SERVER-READY ";
    _write(1, prefix, len(prefix) as i64);
    var digits: array<u8, 6>;
    digits[5] = 10;
    var offset: i64 = 5;
    var remaining: u32 = port;
    while (remaining > 0) {
        offset -= 1;
        digits[offset] = (remaining % 10 + 48) as u8;
        remaining /= 10;
    }
    write_all(1, &digits[offset] as ptr<i8>, 6 - offset);
    server_instance.start();
    return 0;
}
