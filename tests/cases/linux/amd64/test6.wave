// Three independent Linux pipes are demultiplexed by epoll tokens. Seven-byte
// reads exercise short records, re-registration, EOF, and bounded cleanup.
import("std::io::fd")::{io_pipe, io_read, io_write_all, io_close};
import("std::sys::linux::event")::{
    NativeEvent, event_create, event_add, event_remove, event_wait, event_close
};

struct Channel {
    reader: i64;
    writer: i64;
    token: u64;
    consumed: i64;
    weighted: i64;
    retagged: bool;
}

struct Resources {
    queue: i64;
    channels: array<Channel, 3>;
}

fun exercise(resources: ptr<Resources>) -> i32 {
    resources.queue = event_create(3);
    if (resources.queue < 0) {
        return 1;
    }
    var channel: i64 = 0;
    while (channel < 3) {
        var descriptors: array<i32, 2> = [-1, -1];
        if (io_pipe(&descriptors[0]) < 0) {
            return 2;
        }
        resources.channels[channel].reader = descriptors[0] as i64;
        resources.channels[channel].writer = descriptors[1] as i64;
        resources.channels[channel].token = 4294967296 + (channel as u64);
        var bytes: array<u8, 96>;
        var i: i64 = 0;
        while (i < 96) {
            bytes[i] = ((channel * 31 + i * 7) % 251) as u8;
            i += 1;
        }
        var current: Channel = resources.channels[channel];
        if (event_add(resources.queue, current.reader, current.token, 1) < 0) {
            return 3;
        }
        if (io_write_all(current.writer, &bytes[0], 96) != 96) {
            return 4;
        }
        if (io_close(current.writer) < 0) {
            return 5;
        }
        resources.channels[channel].writer = -1;
        channel += 1;
    }
    var finished: i64 = 0;
    var turns: i64 = 0;
    while (finished < 3 && turns < 128) {
        var events: array<NativeEvent, 3>;
        var count: i64 = event_wait(resources.queue, &events[0], 3, 20);
        if (count < 0) {
            return 6;
        }
        var index: i64 = 0;
        while (index < count) {
            var event: NativeEvent = events[index];
            var owner: i64 = -1;
            channel = 0;
            while (channel < 3) {
                if (resources.channels[channel].reader >= 0 && resources.channels[channel].token == event.token) {
                    owner = channel;
                }
                channel += 1;
            }
            if (owner < 0) {
                return 7;
            }
            var current: Channel = resources.channels[owner];
            var buffer: array<u8, 9>;
            buffer[0] = 173;
            buffer[8] = 219;
            var received: i64 = io_read(current.reader, &buffer[1], 7);
            if (received < 0 || received > 7 || buffer[0] != 173 || buffer[8] != 219) {
                return 8;
            }
            var i: i64 = 0;
            while (i < received) {
                var position: i64 = current.consumed + i;
                var offset: i64 = i + 1;
                var expected: i64 = (owner * 31 + position * 7) % 251;
                if (position >= 96 || buffer[offset] as i64 != expected) {
                    return 9;
                }
                current.weighted += (position + 1) * (buffer[offset] as i64);
                i += 1;
            }
            current.consumed += received;
            resources.channels[owner] = current;
            if (received == 0) {
                if (current.consumed != 96) {
                    return 10;
                }
                if (event_remove(resources.queue, current.reader) < 0) {
                    return 11;
                }
                if (io_close(current.reader) < 0) {
                    return 12;
                }
                resources.channels[owner].reader = -1;
                finished += 1;
            } else if (current.consumed >= 40 && !current.retagged) {
                if (event_remove(resources.queue, current.reader) < 0) {
                    return 13;
                }
                current.token += 65536;
                current.retagged = true;
                if (event_add(resources.queue, current.reader, current.token, 1) < 0) {
                    return 14;
                }
                resources.channels[owner] = current;
            }
            index += 1;
        }
        turns += 1;
    }
    if (finished != 3) {
        return 15;
    }
    channel = 0;
    while (channel < 3) {
        var expected: i64 = 0;
        var i: i64 = 0;
        while (i < 96) {
            expected += (i + 1) * ((channel * 31 + i * 7) % 251);
            i += 1;
        }
        if (!resources.channels[channel].retagged || resources.channels[channel].weighted != expected) {
            return 16;
        }
        channel += 1;
    }
    var empty: NativeEvent;
    if (event_wait(resources.queue, &empty, 1, 0) != 0) {
        return 17;
    }
    return 0;
}

fun main() -> i32 {
    var resources: Resources;
    resources.queue = -1;
    var i: i64 = 0;
    while (i < 3) {
        resources.channels[i] = Channel {
            reader: -1,
            writer: -1,
            token: 0,
            consumed: 0,
            weighted: 0,
            retagged: false
        };
        i += 1;
    }
    var status: i32 = exercise(&resources);
    i = 0;
    while (i < 3) {
        if (resources.channels[i].writer >= 0) {
            if (io_close(resources.channels[i].writer) < 0 && status == 0) {
                status = 18;
            }
        }
        if (resources.channels[i].reader >= 0) {
            if (io_close(resources.channels[i].reader) < 0 && status == 0) {
                status = 19;
            }
        }
        i += 1;
    }
    if (resources.queue >= 0) {
        if (event_close(resources.queue) < 0 && status == 0) {
            status = 20;
        }
    }
    return status;
}
