// Generated by tools/populate_case_matrix.py.
// linux/loong64: functional workload 6 and target data transport.
// Base-10000 multi-precision multiplication, with carries crossing every limb.
// Exact independently computed limbs exercise wide intermediates and copies.
struct Big { limb: array<u64, 16>; }
fun zero() -> Big {
    var result: Big;
    var i: i64 = 0;
    while (i < 16) { result.limb[i] = 0; i += 1; }
    return result;
}
fun multiply(a: Big, b: Big) -> Big {
    var result: Big = zero();
    var i: i64 = 0;
    while (i < 8) {
        var carry: u64 = 0;
        var j: i64 = 0;
        while (j < 8) {
            var index: i64 = i + j;
            var total: u64 = result.limb[index] + a.limb[i] * b.limb[j] + carry;
            result.limb[index] = total % 10000;
            carry = total / 10000;
            j += 1;
        }
        var index: i64 = i + 8;
        while (carry != 0 && index < 16) {
            var total: u64 = result.limb[index] + carry;
            result.limb[index] = total % 10000;
            carry = total / 10000;
            index += 1;
        }
        i += 1;
    }
    return result;
}
fun equal(a: Big, b: Big) -> bool {
    var i: i64 = 0;
    while (i < 16) {
        if (a.limb[i] != b.limb[i]) { return false; }
        i += 1;
    }
    return true;
}
fun exercise_language() -> i32 {
    var a: Big = zero();
    var b: Big = zero();
    a.limb[0] = 7890; a.limb[1] = 3456; a.limb[2] = 12;
    b.limb[0] = 4321; b.limb[1] = 8765; b.limb[2] = 9;
    var product: Big = multiply(a, b);
    // 1234567890 * 987654321 = 1219326311126352690.
    var expected: Big = zero();
    expected.limb[0] = 2690; expected.limb[1] = 2635;
    expected.limb[2] = 3111; expected.limb[3] = 9326; expected.limb[4] = 121;
    if (!equal(product, expected)) { return 1; }
    if (!equal(multiply(b, a), product)) { return 2; }
    if (!equal(multiply(a, zero()), zero())) { return 3; }
    var one: Big = zero(); one.limb[0] = 1;
    if (!equal(multiply(a, one), a)) { return 4; }
    var maximal: Big = zero();
    var i: i64 = 0;
    while (i < 8) { maximal.limb[i] = 9999; i += 1; }
    var square: Big = multiply(maximal, maximal);
    if (square.limb[0] != 1 || square.limb[8] != 9998) { return 5; }
    i = 1;
    while (i < 8) { if (square.limb[i] != 0) { return 6; } i += 1; }
    i = 9;
    while (i < 16) { if (square.limb[i] != 9999) { return 7; } i += 1; }
    if (maximal.limb[0] != 9999 || a.limb[1] != 3456) { return 8; }
    return 0;
}

fun target_mix(state: u64, word: u64) -> u64 {
    var result: u64 = asm {
        "slli.d $t0, $a0, 5"
        "add.d $a0, $a0, $t0"
        "xor $a0, $a0, $a1"
        in("a0") state
        in("a1") word
        out("a0") result
        clobber("t0")
    };
    return result % 65521;
}

// Feed actual records through the target's register calling convention, then
// compare each checkpoint to Wave arithmetic. Live copies and guard words must
// survive every call; the low and high halves of inputs both carry data.
struct TargetBlock { words: array<u64, 16>; digest: u64; guard: u64; }
fun target_block(seed: u64) -> TargetBlock {
    var block: TargetBlock;
    var i: i64 = 0;
    while (i < 16) {
        block.words[i] = 4294967296 + seed * 97 + (i as u64) * 65537;
        i += 1;
    }
    block.digest = seed;
    block.guard = 0xFEDCBA9876543210;
    return block;
}
fun target_workload() -> i32 {
    var round: u64 = 0;
    while (round < 65) {
        var block: TargetBlock = target_block(round);
        var snapshot: TargetBlock = block;
        var reference: u64 = round;
        var i: i64 = 0;
        while (i < 16) {
            var word: u64 = block.words[i];
            block.digest = target_mix(block.digest, word);
            reference = ((reference * 33) ^ word) % 65521;
            if (block.digest != reference) { return 201; }
            if (snapshot.words[i] != word || snapshot.digest != round) { return 202; }
            i += 1;
        }
        if (block.guard != 0xFEDCBA9876543210 || snapshot.guard != block.guard) { return 203; }
        round += 1;
    }
    return 0;
}

fun main() -> i32 {
    var status: i32 = exercise_language();
    if (status != 0) { return status; }
    status = target_workload();
    if (status != 0) { return status; }
    return 0;
}
