// Recursively build and traverse an indexed binary search tree. Validate
// subtree totals, unsuccessful searches and traversal order across 63 nodes.
struct Node { key: i64; left: i64; right: i64; }
struct Tree { nodes: array<Node, 63>; root: i64; }
fun build(nodes: ptr<Node>, low: i64, high: i64) -> i64 {
    if (low >= high) { return -1; }
    var mid: i64 = (low + high) / 2;
    var left: i64 = build(nodes, low, mid);
    var right: i64 = build(nodes, mid + 1, high);
    nodes[mid] = Node { key: mid * 3 + 1, left: left, right: right };
    return mid;
}
fun total(nodes: ptr<Node>, root: i64) -> i64 {
    if (root == -1) { return 0; }
    var node: Node = nodes[root];
    return node.key + total(nodes, node.left) + total(nodes, node.right);
}
fun search(nodes: ptr<Node>, root: i64, key: i64) -> i64 {
    var cursor: i64 = root;
    var steps: i64 = 0;
    while (cursor != -1 && steps < 7) {
        var node: Node = nodes[cursor];
        if (key == node.key) { return cursor; }
        if (key < node.key) { cursor = node.left; }
        else { cursor = node.right; }
        steps += 1;
    }
    return -1;
}
fun traverse(nodes: ptr<Node>, root: i64, output: ptr<i64>, used: ptr<i64>) {
    if (root == -1) { return; }
    var node: Node = nodes[root];
    traverse(nodes, node.left, output, used);
    var index: i64 = deref used;
    output[index] = node.key;
    deref used += 1;
    traverse(nodes, node.right, output, used);
}
fun exercise_language() -> i32 {
    var tree: Tree;
    tree.root = build(&tree.nodes[0], 0, 63);
    if (tree.root != 31 || total(&tree.nodes[0], tree.root) != 5922) { return 1; }
