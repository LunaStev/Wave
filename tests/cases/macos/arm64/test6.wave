// Darwin kqueue drives a three-byte streaming number decoder. Read readiness
// remains level-triggered until drained, and EOF must not discard buffered data.
import("std::io::fd")::{io_pipe, io_read, io_write_all, io_close};
import("std::sys::macos::event")::{
    NativeEvent, event_create, event_add, event_remove, event_wait, event_close
};

struct Decoder {
    values: array<i64, 8>;
    count: i64;
    magnitude: i64;
    digits: i64;
    negative: bool;
    error: i32;
}

struct Resources {
    reader: i64;
    writer: i64;
    queue: i64;
}

fun decoder() -> Decoder {
    return Decoder {
        values: [0, 0, 0, 0, 0, 0, 0, 9000000000],
        count: 0,
        magnitude: 0,
        digits: 0,
        negative: false,
        error: 0
    };
}

fun consume(state: Decoder, octet: u8) -> Decoder {
    var result: Decoder = state;
    if (result.error != 0) {
        return result;
    }
    if (octet == 45) {
        if (result.negative || result.digits != 0) {
            result.error = 1;
        } else {
            result.negative = true;
        }
    } else if (octet >= 48 && octet <= 57) {
        var digit: i64 = (octet as i64) - 48;
        if (result.magnitude > (1000 - digit) / 10) {
            result.error = 2;
        } else {
            result.magnitude = result.magnitude * 10 + digit;
            result.digits += 1;
        }
    } else if (octet == 44 || octet == 10) {
        if (result.digits == 0 || result.count >= 7) {
            result.error = 3;
        } else {
            var value: i64 = result.magnitude;
            if (result.negative) {
                value = -value;
            }
            result.values[result.count] = value;
            result.count += 1;
            result.magnitude = 0;
            result.digits = 0;
            result.negative = false;
        }
    } else {
        result.error = 4;
    }
    return result;
}

fun exercise(resources: ptr<Resources>) -> i32 {
    if (io_pipe(null) != -14) {
        return 20;
    }
    var descriptors: array<i32, 4> = [173, -1, -1, 219];
    if (io_pipe(&descriptors[1]) != 0) {
        return 1;
    }
    resources.reader = descriptors[1] as i64;
    resources.writer = descriptors[2] as i64;
    if (resources.reader < 0 || resources.writer < 0 || resources.reader == resources.writer) {
        return 21;
    }
    if (descriptors[0] != 173 || descriptors[3] != 219) {
        return 22;
    }
    resources.queue = event_create(1);
    if (resources.queue < 0) {
        return 2;
    }
    var token: u64 = 0x123456789ABCDE;
    var registered: i64 = event_add(resources.queue, resources.reader, token, 1);
    if (registered < 0) {
        println("kqueue registration failed: {}", registered);
        return 3;
    }
    // "12,-3,45,0,999,-128\n" deliberately splits signs and multi-digit numbers.
    var encoded: array<u8, 20> = [
        49, 50, 44,
        45, 51, 44,
        52, 53, 44,
        48, 44,
        57, 57, 57, 44,
        45, 49, 50, 56, 10
    ];
    if (io_write_all(resources.writer, &encoded[0], 20) != 20) {
        return 4;
    }
    if (io_close(resources.writer) < 0) {
        return 5;
    }
    resources.writer = -1;
    var state: Decoder = decoder();
    var turns: i64 = 0;
    var ended: bool = false;
    while (turns < 32 && !ended) {
        var event: NativeEvent;
        var ready: i64 = event_wait(resources.queue, &event, 1, 20);
        if (ready != 1 || event.token != token || event.fd != resources.reader) {
            return 6;
        }
        if (turns == 0) {
            var repeated: NativeEvent;
            if (event_wait(resources.queue, &repeated, 1, 0) != 1 || repeated.token != token) {
                return 7;
            }
        }
        var bytes: array<u8, 5> = [173, 0, 0, 0, 219];
        var count: i64 = io_read(resources.reader, &bytes[1], 3);
        if (count < 0 || count > 3 || bytes[0] != 173 || bytes[4] != 219) {
            return 8;
        }
        var i: i64 = 0;
        while (i < count) {
            var offset: i64 = i + 1;
            state = consume(state, bytes[offset]);
            i += 1;
        }
        ended = count == 0;
        turns += 1;
    }
    if (!ended || state.error != 0 || state.count != 6 || state.digits != 0) {
        return 9;
    }
    if (event_remove(resources.queue, resources.reader) < 0) {
        return 10;
    }
    var empty: NativeEvent;
    if (event_wait(resources.queue, &empty, 1, 0) != 0) {
        return 11;
    }
    var expected: array<i64, 6> = [12, -3, 45, 0, 999, -128];
    var i: i64 = 0;
    while (i < 6) {
        if (state.values[i] != expected[i]) {
            return 12;
        }
        i += 1;
    }
    var sorted: Decoder = state;
    i = 1;
    while (i < 6) {
        var value: i64 = sorted.values[i];
        var position: i64 = i;
        while (position > 0) {
            var previous: i64 = position - 1;
            if (sorted.values[previous] <= value) {
                break;
            }
            sorted.values[position] = sorted.values[previous];
            position -= 1;
        }
        sorted.values[position] = value;
        i += 1;
    }
    var ordered: array<i64, 6> = [-128, -3, 0, 12, 45, 999];
    i = 0;
    while (i < 6) {
        if (sorted.values[i] != ordered[i] || state.values[i] != expected[i]) {
            return 13;
        }
        i += 1;
    }
    var broken: Decoder = consume(consume(state, 45), 45);
    if (broken.error != 1 || broken.count != 6 || broken.values[5] != -128) {
        return 14;
    }
    var overflow: Decoder = decoder();
    i = 0;
    while (i < 4) {
        overflow = consume(overflow, 57);
        i += 1;
    }
    if (overflow.error != 2 || overflow.count != 0) {
        return 15;
    }
    if (state.values[7] != 9000000000 || sorted.values[7] != 9000000000) {
        return 16;
    }
    return 0;
}

fun main() -> i32 {
    var resources: Resources = Resources {
        reader: -1,
        writer: -1,
        queue: -1
    };
    var status: i32 = exercise(&resources);
    if (resources.queue >= 0) {
        if (event_close(resources.queue) < 0 && status == 0) {
            status = 17;
        }
    }
    if (resources.writer >= 0) {
        if (io_close(resources.writer) < 0 && status == 0) {
            status = 18;
        }
    }
    if (resources.reader >= 0) {
        if (io_close(resources.reader) < 0 && status == 0) {
            status = 19;
        }
    }
    return status;
}
