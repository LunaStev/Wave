// wave-test: mode=build, runner=compile, target=x86_64-unknown-freebsd, emit=obj
// A page-backed 256-vertex graph uses one bit per edge and a fixed BFS queue.
// The oracle minimizes modular +1/+17 paths independently of graph traversal.
import("std::mem::alloc")::{mem_alloc_zeroed, mem_free, mem_page_size};

fun add_edge(graph: ptr<u8>, from: i64, to: i64) {
    var offset: i64 = from * 32 + to / 8;
    var mask: u8 = (1 as u8) << ((to % 8) as u8);
    graph[offset] = graph[offset] | mask;
}

fun connected(graph: ptr<u8>, from: i64, to: i64) -> bool {
    var offset: i64 = from * 32 + to / 8;
    var mask: u8 = (1 as u8) << ((to % 8) as u8);
    return (graph[offset] & mask) != 0;
}

fun shortest_reference(vertex: i64) -> i64 {
    var best: i64 = 256;
    var jumps: i64 = 0;
    while (jumps < 256) {
        var residue: i64 = (17 * jumps) % 256;
        var singles: i64 = (vertex + 256 - residue) % 256;
        if (singles + jumps < best) {
            best = singles + jumps;
        }
        jumps += 1;
    }
    return best;
}

fun exercise(storage: ptr<u8>) -> i32 {
    var graph: ptr<u8> = storage + 8;
    var i: i64 = 0;
    while (i < 8208) {
        if (storage[i] != 0) {
            return 2;
        }
        i += 1;
    }
    i = 0;
    while (i < 8) {
        storage[i] = 173;
        var tail: i64 = 8200 + i;
        storage[tail] = 219;
        i += 1;
    }
    i = 0;
    while (i < 256) {
        add_edge(graph, i, (i + 1) % 256);
        add_edge(graph, i, (i + 17) % 256);
        i += 1;
    }
    var distances: array<i64, 256>;
    var queue: array<i64, 257>;
    queue[256] = -9000000000;
    i = 0;
    while (i < 256) {
        distances[i] = -1;
        i += 1;
    }
    distances[0] = 0;
    queue[0] = 0;
    var head: i64 = 0;
    var tail: i64 = 1;
    while (head < tail) {
        var from: i64 = queue[head];
        head += 1;
        var to: i64 = 0;
        while (to < 256) {
            if (connected(graph, from, to) && distances[to] == -1) {
                if (tail >= 256) {
                    return 3;
                }
                distances[to] = distances[from] + 1;
                queue[tail] = to;
                tail += 1;
            }
            to += 1;
        }
    }
    if (head != 256 || tail != 256 || queue[256] != -9000000000) {
        return 4;
    }
    i = 0;
    while (i < 256) {
        if (distances[i] != shortest_reference(i)) {
            return 5;
        }
        var edges: i64 = 0;
        var to: i64 = 0;
        while (to < 256) {
            if (connected(graph, i, to)) {
                edges += 1;
                if (to != (i + 1) % 256 && to != (i + 17) % 256) {
                    return 6;
                }
            }
            to += 1;
        }
        if (edges != 2) {
            return 7;
        }
        i += 1;
    }
    i = 0;
    while (i < 8) {
        var offset: i64 = 8200 + i;
        if (storage[i] != 173 || storage[offset] != 219) {
            return 8;
        }
        i += 1;
    }
    return 0;
}

fun main() -> i32 {
    if (mem_page_size() <= 0) {
        return 1;
    }
    var storage: ptr<u8> = mem_alloc_zeroed(8208);
    if (storage == null) {
        return 1;
    }
    var status: i32 = exercise(storage);
    if (mem_free(storage, 8208) < 0 && status == 0) {
        status = 9;
    }
    return status;
}
