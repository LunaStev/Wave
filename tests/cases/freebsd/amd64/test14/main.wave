// wave-test: mode=build, runner=compile, target=x86_64-unknown-freebsd, emit=obj, object-arch=x86_64, object-bits=64
// SPDX-License-Identifier: MPL-2.0
import("std::env::cwd")::{env_getcwd};
fun main() -> i32 {
    var buffer: array<u8, 4096>;
    var length: i64 = env_getcwd(&buffer[0], 4096);
    if (length <= 0 || length >= 4096 || buffer[length] != 0) { return 1; }
    var i: i64 = 0;
    while (i < length) {
        if (buffer[i] == 0) { return 2; }
        i += 1;
    }
    if (env_getcwd(&buffer[0], 1) != -1) { return 3; }
    if (env_getcwd(null, 4096) != -1 || env_getcwd(&buffer[0], 0) != -1) { return 4; }
    return 0;
}
