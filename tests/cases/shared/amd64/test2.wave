// wave-test: runtime=portable
// amd64: aggregate returns exceed scalar return registers. Caller-owned
// snapshots and adjacent guards must survive nested returned-value copies.
struct Packet {
    words: array<u64, 3>;
    signed: i8;
    guard: u64;
}

export(c) fun packet(seed: u64, narrow: i8) -> Packet {
    var value: Packet;
    var index: i64 = 0;
    while (index < 3) {
        value.words[index] = 4294967296 + seed * 17 + (index as u64) * 65537;
        index += 1;
    }
    value.signed = narrow;
    value.guard = 0xFEDCBA9876543210;
    return value;
}

fun main() -> i32 {
    var round: u64 = 0;
    while (round < 31) {
        var left: Packet = packet(round, -113);
        var snapshot: Packet = left;
        var right: Packet = packet(round + 1, -97);
        var index: i64 = 0;
        while (index < 3) {
            var expected: u64 = 4294967296 + round * 17 + (index as u64) * 65537;
            if (left.words[index] != expected || snapshot.words[index] != expected) {
                return 1;
            }
            if (right.words[index] != expected + 17) {
                return 2;
            }
            index += 1;
        }
        if (left.signed != -113 || snapshot.signed != -113 || right.signed != -97) {
            return 3;
        }
        if (left.guard != 0xFEDCBA9876543210 || snapshot.guard != left.guard || right.guard != left.guard) {
            return 4;
        }
        round += 1;
    }
    return 0;
}
