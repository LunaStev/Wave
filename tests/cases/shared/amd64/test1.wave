// wave-test: runtime=portable
// Fourteen integer arguments exceed the six SysV integer argument registers.
// The independent weighted oracle observes every position and extension. O0
// retains real calls; optimized runs additionally check value preservation.
export(c) fun spill_digest(
    a0: u64,
    a1: u64,
    a2: u64,
    a3: u64,
    a4: u64,
    a5: u64,
    a6: u64,
    a7: u64,
    a8: u64,
    a9: u64,
    a10: u64,
    a11: u64,
    a12: u64,
    a13: u64
) -> i64 {
    return (a0 as i64) * 1 +
        (a1 as i64) * 2 +
        (a2 as i64) * 3 +
        (a3 as i64) * 4 +
        (a4 as i64) * 5 +
        (a5 as i64) * 6 +
        (a6 as i64) * 7 +
        (a7 as i64) * 8 +
        (a8 as i64) * 9 +
        (a9 as i64) * 10 +
        (a10 as i64) * 11 +
        (a11 as i64) * 12 +
        (a12 as i64) * 13 +
        (a13 as i64) * 14;
}

fun main() -> i32 {
    var round: i64 = 0;
    while (round < 31) {
        var a0: u64 = (4294967296 + round) as u64;
        var a1: u64 = (4294967296 + round) as u64;
        var a2: u64 = (4294967296 + round) as u64;
        var a3: u64 = (4294967296 + round) as u64;
        var a4: u64 = (4294967296 + round) as u64;
        var a5: u64 = (4294967296 + round) as u64;
        var a6: u64 = (4294967296 + round) as u64;
        var a7: u64 = (4294967296 + round) as u64;
        var a8: u64 = (4294967296 + round) as u64;
        var a9: u64 = (4294967296 + round) as u64;
        var a10: u64 = (4294967296 + round) as u64;
        var a11: u64 = (4294967296 + round) as u64;
        var a12: u64 = (4294967296 + round) as u64;
        var a13: u64 = (4294967296 + round) as u64;
        var actual: i64 = spill_digest(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13);
        if (actual != 450971566080 + round * 105) {
            return 1;
        }
        round += 1;
    }
    return 0;
}
