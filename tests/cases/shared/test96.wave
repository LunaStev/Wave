// Nested loops, continue, break, and for-loop update ordering.

fun main() -> i32 {
    var total: i32 = 0;
    for (var row: i32 = 0; row < 4; row += 1) {
        if (row == 1) { continue; }
        var column: i32 = 0;
        while (column < 5) {
            column += 1;
            if (column == 4) { break; }
            total += row + column;
        }
    }
    if (total != 33) { return 1; }
    return 0;
}
