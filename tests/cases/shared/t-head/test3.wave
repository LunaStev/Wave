// Generated by tools/populate_case_matrix.py.
// shared/t-head: functional workload 3 and target data transport.
// Weighted routing: disconnected vertices, predecessor reconstruction and
// independently known distances. Graph and route snapshots travel by value.
struct Graph { weights: array<i64, 81>; }
struct Routes { distance: array<i64, 9>; previous: array<i64, 9>; }
fun edge(weights: ptr<i64>, a: i64, b: i64, cost: i64) {
    var forward: i64 = a * 9 + b;
    var reverse: i64 = b * 9 + a;
    weights[forward] = cost;
    weights[reverse] = cost;
}
fun network() -> Graph {
    var graph: Graph;
    var i: i64 = 0;
    while (i < 81) { graph.weights[i] = 0; i += 1; }
    edge(&graph.weights[0], 0, 1, 4);
    edge(&graph.weights[0], 0, 7, 8);
    edge(&graph.weights[0], 1, 2, 8);
    edge(&graph.weights[0], 1, 7, 11);
    edge(&graph.weights[0], 2, 3, 7);
    edge(&graph.weights[0], 2, 5, 4);
    edge(&graph.weights[0], 3, 4, 9);
    edge(&graph.weights[0], 3, 5, 14);
    edge(&graph.weights[0], 4, 5, 10);
    edge(&graph.weights[0], 5, 6, 2);
    edge(&graph.weights[0], 6, 7, 1);
    return graph;
}
fun shortest(graph: Graph, start: i64) -> Routes {
    var result: Routes;
    var settled: array<bool, 9>;
    var i: i64 = 0;
    while (i < 9) {
        result.distance[i] = 1000000;
        result.previous[i] = -1;
        settled[i] = false;
        i += 1;
    }
    result.distance[start] = 0;
    var pass: i64 = 0;
    while (pass < 9) {
        var best: i64 = -1;
        var cost: i64 = 1000000;
        i = 0;
        while (i < 9) {
            if (!settled[i] && result.distance[i] < cost) {
                best = i;
                cost = result.distance[i];
            }
            i += 1;
        }
        if (best == -1) { break; }
        settled[best] = true;
        i = 0;
        while (i < 9) {
            var index: i64 = best * 9 + i;
            var weight: i64 = graph.weights[index];
            if (weight != 0 && cost + weight < result.distance[i]) {
                result.distance[i] = cost + weight;
                result.previous[i] = best;
            }
            i += 1;
        }
        pass += 1;
    }
    return result;
}
fun exercise_language() -> i32 {
    var graph: Graph = network();
    var routes: Routes = shortest(graph, 0);
    var expected: array<i64, 9> = [0, 4, 12, 19, 21, 11, 9, 8, 1000000];
    var i: i64 = 0;
    while (i < 9) {
        if (routes.distance[i] != expected[i]) { return 1; }
        i += 1;
    }
    var cursor: i64 = 4;
    var total: i64 = 0;
    var hops: i64 = 0;
    while (cursor != 0 && hops < 9) {
        var parent: i64 = routes.previous[cursor];
        if (parent < 0 || parent >= 9) { return 2; }
        var index: i64 = parent * 9 + cursor;
        if (graph.weights[index] == 0) { return 3; }
        total += graph.weights[index];
        cursor = parent;
        hops += 1;
    }
    if (cursor != 0 || total != 21 || hops != 4) { return 4; }
    if (routes.previous[8] != -1) { return 5; }
    var isolated: Routes = shortest(graph, 8);
    if (isolated.distance[8] != 0 || isolated.distance[0] != 1000000) { return 6; }
    edge(&graph.weights[0], 0, 4, 1);
    var shortcut: Routes = shortest(graph, 0);
    if (shortcut.distance[4] != 1 || routes.distance[4] != 21) { return 7; }
    return 0;
}

fun target_mix(state: u64, word: u64) -> u64 {
    var result: u64 = asm {
        "slli t0, a0, 5"
        "add a0, a0, t0"
        "xor a0, a0, a1"
        in("a0") state
        in("a1") word
        out("a0") result
        clobber("t0")
    };
    return result % 65521;
}

// Feed actual records through the target's register calling convention, then
// compare each checkpoint to Wave arithmetic. Live copies and guard words must
// survive every call; the low and high halves of inputs both carry data.
struct TargetBlock { words: array<u64, 16>; digest: u64; guard: u64; }
fun target_block(seed: u64) -> TargetBlock {
    var block: TargetBlock;
    var i: i64 = 0;
    while (i < 16) {
        block.words[i] = 4294967296 + seed * 97 + (i as u64) * 65537;
        i += 1;
    }
    block.digest = seed;
    block.guard = 0xFEDCBA9876543210;
    return block;
}
fun target_workload() -> i32 {
    var round: u64 = 0;
    while (round < 65) {
        var block: TargetBlock = target_block(round);
        var snapshot: TargetBlock = block;
        var reference: u64 = round;
        var i: i64 = 0;
        while (i < 16) {
            var word: u64 = block.words[i];
            block.digest = target_mix(block.digest, word);
            reference = ((reference * 33) ^ word) % 65521;
            if (block.digest != reference) { return 201; }
            if (snapshot.words[i] != word || snapshot.digest != round) { return 202; }
            i += 1;
        }
        if (block.guard != 0xFEDCBA9876543210 || snapshot.guard != block.guard) { return 203; }
        round += 1;
    }
    return 0;
}

fun main() -> i32 {
    var status: i32 = exercise_language();
    if (status != 0) { return status; }
    status = target_workload();
    if (status != 0) { return status; }
    return 0;
}
