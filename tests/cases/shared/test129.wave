// #682: IEEE unordered inequality, across concrete integer/float operands.
import("std::math::float")::{float_from_bits_f32, float_from_bits_f64};
fun ne_ff32(a: f32, b: f32) -> bool { return a != b; }
fun ne_if32(a: i32, b: f32) -> bool { return a != b; }
fun ne_fi32(a: f32, b: i32) -> bool { return a != b; }
fun same_if32(a: i32, b: f32) -> bool { return ((a != b) as i32) == ((!(a == b)) as i32); }
fun same_fi32(a: f32, b: i32) -> bool { return ((a != b) as i32) == ((!(a == b)) as i32); }
fun same32(a: f32, b: f32) -> bool { return ((a != b) as i32) == ((!(a == b)) as i32); }
fun ne_ff64(a: f64, b: f64) -> bool { return a != b; }
fun ne_if64(a: i64, b: f64) -> bool { return a != b; }
fun ne_fi64(a: f64, b: i64) -> bool { return a != b; }
fun same_if64(a: i64, b: f64) -> bool { return ((a != b) as i32) == ((!(a == b)) as i32); }
fun same_fi64(a: f64, b: i64) -> bool { return ((a != b) as i32) == ((!(a == b)) as i32); }
fun same64(a: f64, b: f64) -> bool { return ((a != b) as i32) == ((!(a == b)) as i32); }
fun main() -> i32 {
    var n32: f32 = float_from_bits_f32(0x7fc00001);
    var inf32: f32 = float_from_bits_f32(0x7f800000);
    var nz32: f32 = float_from_bits_f32(0x80000000);
    if (!ne_ff32(n32, n32) || !ne_ff32(n32, 1.0) || !ne_ff32(1.0, n32)) { return 1; }
    if (!ne_if32(1, n32) || !ne_fi32(n32, 1)) { return 2; }
    if (ne_if32(1, 1.0) || ne_fi32(1.0, 1) || !ne_ff32(1.0, 2.0)) { return 3; }
    if (ne_ff32(inf32, inf32) || !ne_ff32(inf32, -inf32) || ne_ff32(0.0, nz32)) { return 4; }
    if (!same32(n32, n32) || !same32(n32, 1.0) || !same32(1.0, n32) || !same32(0.0, nz32)) { return 5; }
    if (!same_if32(1, n32) || !same_fi32(n32, 1) || !same_if32(1, 1.0) || !same_fi32(2.0, 1)) { return 7; }
    if (n32 < 0.0 || n32 > 0.0 || n32 <= 0.0 || n32 >= 0.0 || n32 == n32) { return 6; }
    var n64: f64 = float_from_bits_f64(0x7ff8000000000001);
    var inf64: f64 = float_from_bits_f64(0x7ff0000000000000);
    var nz64: f64 = float_from_bits_f64(0x8000000000000000);
    if (!ne_ff64(n64, n64) || !ne_ff64(n64, 1.0) || !ne_ff64(1.0, n64)) { return 1; }
    if (!ne_if64(1, n64) || !ne_fi64(n64, 1)) { return 2; }
    if (ne_if64(1, 1.0) || ne_fi64(1.0, 1) || !ne_ff64(1.0, 2.0)) { return 3; }
    if (ne_ff64(inf64, inf64) || !ne_ff64(inf64, -inf64) || ne_ff64(0.0, nz64)) { return 4; }
    if (!same64(n64, n64) || !same64(n64, 1.0) || !same64(1.0, n64) || !same64(0.0, nz64)) { return 5; }
    if (!same_if64(1, n64) || !same_fi64(n64, 1) || !same_if64(1, 1.0) || !same_fi64(2.0, 1)) { return 7; }
    if (n64 < 0.0 || n64 > 0.0 || n64 <= 0.0 || n64 >= 0.0 || n64 == n64) { return 6; }
    return 0;
}
