    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 100000000 }, Duration { seconds: -1, nanoseconds: 900000000 }, false, true, Duration { seconds: 9223372036854775807, nanoseconds: 0 })) { return 5; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 100000000 }, Duration { seconds: -1, nanoseconds: 900000000 }, true, true, Duration { seconds: 9223372036854775807, nanoseconds: 200000000 })) { return 6; }
    if (!check(Duration { seconds: -1, nanoseconds: 900000000 }, Duration { seconds: 9223372036854775807, nanoseconds: 100000000 }, false, true, Duration { seconds: 9223372036854775807, nanoseconds: 0 })) { return 7; }
    if (!check(Duration { seconds: -1, nanoseconds: 900000000 }, Duration { seconds: 9223372036854775807, nanoseconds: 100000000 }, true, true, Duration { seconds: -9223372036854775808, nanoseconds: 800000000 })) { return 8; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 0 }, Duration { seconds: -1, nanoseconds: 0 }, false, false, Duration { seconds: -9223372036854775808, nanoseconds: 0 })) { return 9; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 0 }, Duration { seconds: -1, nanoseconds: 0 }, true, true, Duration { seconds: -9223372036854775807, nanoseconds: 0 })) { return 10; }
    if (!check(Duration { seconds: -1, nanoseconds: 0 }, Duration { seconds: -9223372036854775808, nanoseconds: 0 }, false, false, Duration { seconds: -9223372036854775808, nanoseconds: 0 })) { return 11; }
    if (!check(Duration { seconds: -1, nanoseconds: 0 }, Duration { seconds: -9223372036854775808, nanoseconds: 0 }, true, true, Duration { seconds: 9223372036854775807, nanoseconds: 0 })) { return 12; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, Duration { seconds: 0, nanoseconds: 1 }, false, false, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 13; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, Duration { seconds: 0, nanoseconds: 1 }, true, true, Duration { seconds: 9223372036854775807, nanoseconds: 999999998 })) { return 14; }
    if (!check(Duration { seconds: 0, nanoseconds: 1 }, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, false, false, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 15; }
    if (!check(Duration { seconds: 0, nanoseconds: 1 }, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, true, true, Duration { seconds: -9223372036854775808, nanoseconds: 2 })) { return 16; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 0 }, Duration { seconds: 0, nanoseconds: 999999999 }, false, true, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 17; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 0 }, Duration { seconds: 0, nanoseconds: 999999999 }, true, true, Duration { seconds: 9223372036854775806, nanoseconds: 1 })) { return 18; }
    if (!check(Duration { seconds: 0, nanoseconds: 999999999 }, Duration { seconds: 9223372036854775807, nanoseconds: 0 }, false, true, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 19; }
    if (!check(Duration { seconds: 0, nanoseconds: 999999999 }, Duration { seconds: 9223372036854775807, nanoseconds: 0 }, true, true, Duration { seconds: -9223372036854775807, nanoseconds: 999999999 })) { return 20; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 0 }, Duration { seconds: 0, nanoseconds: 1 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 21; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 0 }, Duration { seconds: 0, nanoseconds: 1 }, true, false, Duration { seconds: -9223372036854775808, nanoseconds: 0 })) { return 22; }
    if (!check(Duration { seconds: 0, nanoseconds: 1 }, Duration { seconds: -9223372036854775808, nanoseconds: 0 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 23; }
    if (!check(Duration { seconds: 0, nanoseconds: 1 }, Duration { seconds: -9223372036854775808, nanoseconds: 0 }, true, false, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 24; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 999999999 }, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, false, true, Duration { seconds: 0, nanoseconds: 999999998 })) { return 25; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 999999999 }, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, true, false, Duration { seconds: -9223372036854775808, nanoseconds: 0 })) { return 26; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, Duration { seconds: -9223372036854775808, nanoseconds: 999999999 }, false, true, Duration { seconds: 0, nanoseconds: 999999998 })) { return 27; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, Duration { seconds: -9223372036854775808, nanoseconds: 999999999 }, true, false, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 28; }
