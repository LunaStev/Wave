    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 0 }, Duration { seconds: -9223372036854775808, nanoseconds: 999999999 }, true, true, Duration { seconds: -1, nanoseconds: 1 })) { return 30; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 999999999 }, Duration { seconds: -9223372036854775808, nanoseconds: 0 }, false, false, Duration { seconds: -9223372036854775808, nanoseconds: 0 })) { return 31; }
