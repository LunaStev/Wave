    if (!check(Duration { seconds: 9223372036854775806, nanoseconds: 999999999 }, Duration { seconds: -1, nanoseconds: 0 }, true, true, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 50; }
