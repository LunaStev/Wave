// #522: independent exact normalized results at carry/borrow and overflow boundaries.
import("std::time::duration")::{Duration, DurationResult, time_duration_checked_add, time_duration_checked_sub, time_duration_add, time_duration_sub};
fun equal(a: Duration, b: Duration) -> bool { return a.seconds == b.seconds && a.nanoseconds == b.nanoseconds; }
fun check(a: Duration, b: Duration, subtract: bool, ok: bool, expected: Duration) -> bool {
    var actual: DurationResult;
    var saturated: Duration;
    if (subtract) { actual = time_duration_checked_sub(a, b); saturated = time_duration_sub(a, b); }
    else { actual = time_duration_checked_add(a, b); saturated = time_duration_add(a, b); }
    if ((actual.ok as i32) != (ok as i32) || !equal(saturated, expected)) { return false; }
    if (ok && !equal(actual.value, expected)) { return false; }
    return true;
}
fun main() -> i32 {
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 900000000 }, Duration { seconds: -1, nanoseconds: 200000000 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 100000000 })) { return 1; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 900000000 }, Duration { seconds: -1, nanoseconds: 200000000 }, true, true, Duration { seconds: -9223372036854775807, nanoseconds: 700000000 })) { return 2; }
