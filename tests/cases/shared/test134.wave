    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 0 }, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, false, false, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 33; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 0 }, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, true, true, Duration { seconds: -1, nanoseconds: 1 })) { return 34; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, Duration { seconds: 9223372036854775807, nanoseconds: 0 }, false, false, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 35; }
    if (!check(Duration { seconds: 9223372036854775807, nanoseconds: 999999999 }, Duration { seconds: 9223372036854775807, nanoseconds: 0 }, true, true, Duration { seconds: 0, nanoseconds: 999999999 })) { return 36; }
    if (!check(Duration { seconds: 0, nanoseconds: 0 }, Duration { seconds: -9223372036854775808, nanoseconds: 1 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 37; }
    if (!check(Duration { seconds: 0, nanoseconds: 0 }, Duration { seconds: -9223372036854775808, nanoseconds: 1 }, true, true, Duration { seconds: 9223372036854775807, nanoseconds: 999999999 })) { return 38; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 1 }, Duration { seconds: 0, nanoseconds: 0 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 39; }
    if (!check(Duration { seconds: -9223372036854775808, nanoseconds: 1 }, Duration { seconds: 0, nanoseconds: 0 }, true, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 40; }
    if (!check(Duration { seconds: -1, nanoseconds: 900000000 }, Duration { seconds: 0, nanoseconds: 200000000 }, false, true, Duration { seconds: 0, nanoseconds: 100000000 })) { return 41; }
    if (!check(Duration { seconds: -1, nanoseconds: 900000000 }, Duration { seconds: 0, nanoseconds: 200000000 }, true, true, Duration { seconds: -1, nanoseconds: 700000000 })) { return 42; }
    if (!check(Duration { seconds: 0, nanoseconds: 200000000 }, Duration { seconds: -1, nanoseconds: 900000000 }, false, true, Duration { seconds: 0, nanoseconds: 100000000 })) { return 43; }
    if (!check(Duration { seconds: 0, nanoseconds: 200000000 }, Duration { seconds: -1, nanoseconds: 900000000 }, true, true, Duration { seconds: 0, nanoseconds: 300000000 })) { return 44; }
    if (!check(Duration { seconds: -9223372036854775807, nanoseconds: 0 }, Duration { seconds: -1, nanoseconds: 1 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 45; }
    if (!check(Duration { seconds: -9223372036854775807, nanoseconds: 0 }, Duration { seconds: -1, nanoseconds: 1 }, true, true, Duration { seconds: -9223372036854775807, nanoseconds: 999999999 })) { return 46; }
    if (!check(Duration { seconds: -1, nanoseconds: 1 }, Duration { seconds: -9223372036854775807, nanoseconds: 0 }, false, true, Duration { seconds: -9223372036854775808, nanoseconds: 1 })) { return 47; }
    if (!check(Duration { seconds: -1, nanoseconds: 1 }, Duration { seconds: -9223372036854775807, nanoseconds: 0 }, true, true, Duration { seconds: 9223372036854775806, nanoseconds: 1 })) { return 48; }
