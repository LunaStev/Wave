// wave-test: runtime=portable
// Narrow signed/unsigned values cross all eight integer argument registers and stack slots.
// The independent weighted oracle observes every position and extension. O0
// retains real calls; optimized runs additionally check value preservation.
export(c) fun spill_digest(
    a0: i8,
    a1: u8,
    a2: i16,
    a3: u16,
    a4: i32,
    a5: u32,
    a6: i64,
    a7: u64,
    a8: i8,
    a9: u8,
    a10: i16,
    a11: u16,
    a12: i32,
    a13: u32,
    a14: i64,
    a15: u64
) -> i64 {
    return (a0 as i64) * 1 +
        (a1 as i64) * 2 +
        (a2 as i64) * 3 +
        (a3 as i64) * 4 +
        (a4 as i64) * 5 +
        (a5 as i64) * 6 +
        (a6 as i64) * 7 +
        (a7 as i64) * 8 +
        (a8 as i64) * 9 +
        (a9 as i64) * 10 +
        (a10 as i64) * 11 +
        (a11 as i64) * 12 +
        (a12 as i64) * 13 +
        (a13 as i64) * 14 +
        (a14 as i64) * 15 +
        (a15 as i64) * 16;
}

fun main() -> i32 {
    var round: i64 = 0;
    while (round < 31) {
        var a0: i8 = (-97 + round) as i8;
        var a1: u8 = (201 + round) as u8;
        var a2: i16 = (-30001 + round) as i16;
        var a3: u16 = (50001 + round) as u16;
        var a4: i32 = (-2000000001 + round) as i32;
        var a5: u32 = (3000000001 + round) as u32;
        var a6: i64 = (-9000000001 + round) as i64;
        var a7: u64 = (4294967296 + round) as u64;
        var a8: i8 = (-97 + round) as i8;
        var a9: u8 = (201 + round) as u8;
        var a10: i16 = (-30001 + round) as i16;
        var a11: u16 = (50001 + round) as u16;
        var a12: i32 = (-2000000001 + round) as i32;
        var a13: u32 = (3000000001 + round) as u32;
        var a14: i64 = (-9000000001 + round) as i64;
        var a15: u64 = (4294967296 + round) as u64;
        var actual: i64 = spill_digest(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15);
        if (actual != -70920403472 + round * 136) {
            return 1;
        }
        round += 1;
    }
    return 0;
}
