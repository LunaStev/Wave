// shared/riscv64: functional workload 8 and target data transport.
// Cooperative round-robin scheduling with payload states, cancellation,
// repeated queue wraparound and exact per-task accounting.
struct Progress { remaining: i64; sum: i64; }
variant Task { Ready(Progress), Done(i64), Cancelled }
struct Scheduler { tasks: array<Task, 8>; queue: array<i64, 8>; head: i64; count: i64; ticks: i64; }
fun schedule() -> Scheduler {
    var state: Scheduler;
    var i: i64 = 0;
    while (i < 8) {
        state.tasks[i] = Task::Ready(Progress { remaining: i + 1, sum: 0 });
        state.queue[i] = i;
        i += 1;
    }
    state.head = 0; state.count = 8; state.ticks = 0;
    return state;
}
fun drive(initial: Scheduler) -> Scheduler {
    var state: Scheduler = initial;
    var watchdog: i64 = 0;
    while (state.count > 0 && watchdog < 100) {
        var id: i64 = state.queue[state.head];
        state.head = (state.head + 1) % 8;
        state.count -= 1;
        match state.tasks[id] {
            Task::Ready(progress) => {
                var next: Progress = progress;
                next.remaining -= 1;
                next.sum += id + 1;
                state.ticks += 1;
                if (next.remaining == 0) {
                    state.tasks[id] = Task::Done(next.sum);
                } else {
                    state.tasks[id] = Task::Ready(next);
                    var tail: i64 = (state.head + state.count) % 8;
                    state.queue[tail] = id;
                    state.count += 1;
                }
            }
            Task::Cancelled => {}
            Task::Done(_) => {}
        }
        watchdog += 1;
    }
    return state;
}
fun exercise_language() -> i32 {
    var initial: Scheduler = schedule();
    initial.tasks[3] = Task::Cancelled;
    var result: Scheduler = drive(initial);
    if (result.count != 0 || result.ticks != 32) { return 1; }
    var total: i64 = 0;
    var i: i64 = 0;
    while (i < 8) {
        match result.tasks[i] {
            Task::Ready(_) => { return 2; }
            Task::Cancelled => { if (i != 3) { return 3; } }
            Task::Done(sum) => {
                if (sum != (i + 1) * (i + 1)) { return 4; }
                total += sum;
            }
        }
        i += 1;
    }
    if (total != 188 || initial.count != 8 || initial.ticks != 0) { return 5; }
    var again: Scheduler = drive(result);
    if (again.ticks != 32 || again.count != 0) { return 6; }
    match initial.tasks[7] {
        Task::Ready(progress) => {
            if (progress.remaining != 8 || progress.sum != 0) { return 7; }
        }
        Task::Done(_) => { return 8; }
        Task::Cancelled => { return 9; }
    }
    return 0;
}

fun target_mix(state: u64, word: u64) -> u64 {
    var result: u64 = asm {
        "slli t0, a0, 5"
        "add a0, a0, t0"
        "xor a0, a0, a1"
        in("a0") state
        in("a1") word
        out("a0") result
        clobber("t0")
    };
    return result % 65521;
}

// Feed actual records through the target's register calling convention, then
// compare each checkpoint to Wave arithmetic. Live copies and guard words must
// survive every call; the low and high halves of inputs both carry data.
struct TargetBlock { words: array<u64, 16>; digest: u64; guard: u64; }
fun target_block(seed: u64) -> TargetBlock {
    var block: TargetBlock;
    var i: i64 = 0;
    while (i < 16) {
        block.words[i] = 4294967296 + seed * 97 + (i as u64) * 65537;
        i += 1;
    }
    block.digest = seed;
    block.guard = 0xFEDCBA9876543210;
    return block;
}
fun target_workload() -> i32 {
    var round: u64 = 0;
    while (round < 65) {
        var block: TargetBlock = target_block(round);
        var snapshot: TargetBlock = block;
        var reference: u64 = round;
        var i: i64 = 0;
        while (i < 16) {
            var word: u64 = block.words[i];
            block.digest = target_mix(block.digest, word);
            reference = ((reference * 33) ^ word) % 65521;
            if (block.digest != reference) { return 201; }
            if (snapshot.words[i] != word || snapshot.digest != round) { return 202; }
            i += 1;
        }
        if (block.guard != 0xFEDCBA9876543210 || snapshot.guard != block.guard) { return 203; }
        round += 1;
    }
    return 0;
}

fun main() -> i32 {
    var status: i32 = exercise_language();
    if (status != 0) { return status; }
    status = target_workload();
    if (status != 0) { return status; }
    return 0;
}
