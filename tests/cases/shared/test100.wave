// Portable path-library root, trailing-separator, and extension boundaries.

import("std::path::analyze")::{
    path_basename_len,
    path_basename_start,
    path_dirname_len,
    path_ext_start,
    path_has_ext,
};
import("std::path::core")::{path_is_abs, path_len};

fun main() -> i32 {
    if (path_len("") != 0 || path_is_abs("")) { return 1; }
    if (!path_is_abs("/")) { return 2; }
    if (path_basename_start("/") != 1 || path_basename_len("/") != 0) { return 3; }
    if (path_dirname_len("name") != 0) { return 4; }
    if (path_has_ext("archive") || path_ext_start("archive") != -1) { return 5; }
    if (!path_has_ext("archive.tar") || path_ext_start("archive.tar") != 7) { return 6; }
    if (path_has_ext(".hidden")) { return 7; }
    return 0;
}
