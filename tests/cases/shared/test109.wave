// Base-10000 multi-precision multiplication, with carries crossing every limb.
// Exact independently computed limbs exercise wide intermediates and copies.
struct Big { limb: array<u64, 16>; }
fun zero() -> Big {
    var result: Big;
    var i: i64 = 0;
    while (i < 16) { result.limb[i] = 0; i += 1; }
    return result;
}
fun multiply(a: Big, b: Big) -> Big {
    var result: Big = zero();
    var i: i64 = 0;
    while (i < 8) {
        var carry: u64 = 0;
        var j: i64 = 0;
        while (j < 8) {
            var index: i64 = i + j;
            var total: u64 = result.limb[index] + a.limb[i] * b.limb[j] + carry;
            result.limb[index] = total % 10000;
            carry = total / 10000;
            j += 1;
        }
        var index: i64 = i + 8;
        while (carry != 0 && index < 16) {
            var total: u64 = result.limb[index] + carry;
            result.limb[index] = total % 10000;
            carry = total / 10000;
            index += 1;
        }
        i += 1;
    }
    return result;
}
fun equal(a: Big, b: Big) -> bool {
    var i: i64 = 0;
    while (i < 16) {
        if (a.limb[i] != b.limb[i]) { return false; }
        i += 1;
    }
    return true;
}
fun main() -> i32 {
    var a: Big = zero();
    var b: Big = zero();
    a.limb[0] = 7890; a.limb[1] = 3456; a.limb[2] = 12;
    b.limb[0] = 4321; b.limb[1] = 8765; b.limb[2] = 9;
    var product: Big = multiply(a, b);
    // 1234567890 * 987654321 = 1219326311126352690.
    var expected: Big = zero();
    expected.limb[0] = 2690; expected.limb[1] = 2635;
    expected.limb[2] = 3111; expected.limb[3] = 9326; expected.limb[4] = 121;
    if (!equal(product, expected)) { return 1; }
    if (!equal(multiply(b, a), product)) { return 2; }
    if (!equal(multiply(a, zero()), zero())) { return 3; }
    var one: Big = zero(); one.limb[0] = 1;
    if (!equal(multiply(a, one), a)) { return 4; }
    var maximal: Big = zero();
    var i: i64 = 0;
    while (i < 8) { maximal.limb[i] = 9999; i += 1; }
    var square: Big = multiply(maximal, maximal);
    if (square.limb[0] != 1 || square.limb[8] != 9998) { return 5; }
    i = 1;
    while (i < 8) { if (square.limb[i] != 0) { return 6; } i += 1; }
    i = 9;
    while (i < 16) { if (square.limb[i] != 9999) { return 7; } i += 1; }
    if (maximal.limb[0] != 9999 || a.limb[1] != 3456) { return 8; }
    return 0;
}
