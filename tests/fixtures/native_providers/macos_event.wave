import("std::sys::macos::syscall")::{syscall4};
import("std::sys::fs")::{close};
import("std::sys::event")::{NativeEvent, event_create, event_add, event_modify, event_remove, event_wait, event_close, EVENT_READABLE, EVENT_WRITABLE};
fun main() -> i32 {
    if (event_remove(-1, 0) != -9 || event_modify(-1, 0, 1, EVENT_READABLE) != -9) { return 1; }
    var fds: array<i32, 2>;
    // Pass the BSD socketpair number; the amd64 wrapper adds the syscall class.
    if (syscall4(135, 1, 1, 0, &fds[0] as i64) != 0) { return 2; }
    var queue: i64 = event_create(4);
    if (queue < 0) { return 3; }
    var fd: i64 = fds[0] as i64;
    var events: array<NativeEvent, 4>;
    var flags: i32 = 1;
    while (flags <= 3) {
        if (event_add(queue, fd, 7, flags) != 0) { return 4; }
        if (event_remove(queue, fd) != 0) { return 5; }
        if (event_wait(queue, &events[0], 4, 0) != 0) { return 6; }
        if (event_remove(queue, fd) != -2) { return 7; }
        flags += 1;
    }
    if (event_add(queue, fd, 7, EVENT_WRITABLE) != 0) { return 8; }
    if (event_modify(queue, fd, 8, 0) != -22) { return 9; }
    if (event_wait(queue, &events[0], 4, 0) != 1 || events[0].token != 7) { return 10; }
    if (event_modify(queue, fd, 8, EVENT_READABLE) != 0) { return 11; }
    if (event_wait(queue, &events[0], 4, 0) != 0) { return 12; }
    if (event_remove(queue, fd) != 0 || event_close(queue) != 0) { return 13; }
    if (event_remove(queue, fd) != -9 || event_modify(queue, fd, 9, EVENT_READABLE) != -9) { return 14; }
    close(fd); close(fds[1] as i64);
    return 0;
}
