// Inputs and references are supplied by the Rust harness from checked-in data.
fun main() -> i32 {
    var i: i32 = 0;
    while (i < CASES) {
        var x: f64 = float_from_bits_f64(inputs[i]);
        var s: f64 = float_from_bits_f64(sines[i]);
        var c: f64 = float_from_bits_f64(cosines[i]);
        var t: f64 = float_from_bits_f64(tangents[i]);
        var actual: SinCosF64 = sin_cos_f64(x);
        if (abs_f64(actual.sin - s) > 1e-12 || abs_f64(actual.cos - c) > 1e-12) {
            println("sin/cos vector {} failed", i); return 1;
        }
        if (sin_f64(x) != actual.sin || cos_f64(x) != actual.cos) { return 2; }
        var tangent: f64 = tan_f64(x);
        if (abs_f64(c) >= 1e-6 && abs_f64(tangent - t) > 1e-12 + 1e-9 * abs_f64(t)) {
            println("tan vector {} failed", i); return 3;
        }
        // Pole-near samples are checked separately: preserve side/quadrant;
        // a broad absolute/relative bound detects loss of the small remainder.
        if (abs_f64(c) < 1e-6) {
            if (((tangent < 0.0) as i32) != ((t < 0.0) as i32) || ((actual.cos < 0.0) as i32) != ((c < 0.0) as i32)) { return 4; }
            if (abs_f64(tangent - t) > 1e-8 * abs_f64(t)) { return 5; }
        }
        var wrapped: f64 = wrap_angle_pi_f64(x);
        if (wrapped < -MATH_PI_F64 || wrapped > MATH_PI_F64) { return 6; }
        if (x == 0.0) {
            if (float_to_bits_f64(actual.sin) != inputs[i] || float_to_bits_f64(tangent) != inputs[i]) { return 7; }
            if (float_to_bits_f64(wrapped) != inputs[i]) { return 8; }
        }
        i += 1;
    }
    i = 0;
    while (i < SINGLE_CASES) {
        var x: f32 = float_from_bits_f64(inputs32[i]) as f32;
        var s: f64 = float_from_bits_f64(sines32[i]);
        var c: f64 = float_from_bits_f64(cosines32[i]);
        var t: f64 = float_from_bits_f64(tangents32[i]);
        var actual: SinCosF32 = sin_cos_f32(x);
        if (abs_f64(actual.sin as f64 - s) > 1e-6 || abs_f64(actual.cos as f64 - c) > 1e-6) { return 12; }
        if (sin_f32(x) != actual.sin || cos_f32(x) != actual.cos) { return 13; }
        var tangent: f64 = tan_f32(x) as f64;
        if (abs_f64(c) >= 1e-6 && abs_f64(tangent - t) > 1e-6 + 1e-5 * abs_f64(t)) { return 14; }
        if (abs_f64(c) < 1e-6 && (((tangent < 0.0) as i32) != ((t < 0.0) as i32) || abs_f64(tangent - t) > 1e-5 * abs_f64(t))) { return 15; }
        i += 1;
    }
    var nan: f64 = nan_f64();
    var inf: f64 = infinity_f64();
    if (!is_nan_f64(sin_f64(nan)) || !is_nan_f64(cos_f64(inf)) || !is_nan_f64(tan_f64(-inf))) { return 9; }
    var negative_zero: f32 = float_from_bits_f32(2147483648);
    if (float_to_bits_f32(sin_f32(negative_zero)) != 2147483648) { return 10; }
    if (float_to_bits_f32(tan_f32(negative_zero)) != 2147483648) { return 11; }
    return 0;
}
