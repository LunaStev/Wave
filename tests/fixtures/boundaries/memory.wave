// Controlled allocator for #676: distinct allocations are deterministically
// adjacent. Freed bytes are poisoned so stale self-append pointers are visible.
static arena: array<u8, 4096>;
static used: i64 = 0;
static fail: bool = false;
pub fun fail_allocations(value: bool) { fail = value; }
pub fun sys_page_size() -> i64 { return 4096; }
pub fun sys_alloc(size: i64) -> ptr<u8> {
    if (fail || size <= 0 || size > 4096 - used) { return null; }
    var result: ptr<u8> = &arena[used];
    used += size;
    return result;
}
pub fun sys_free(data: ptr<u8>, size: i64) -> i64 {
    var i: i64 = 0;
    while (i < size) { data[i] = 238; i += 1; }
    return 0;
}
