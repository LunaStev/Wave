import("std::sys::macos::common::env")::{env_read, test_setup};
fun main() -> i32 {
    var output: array<u8, 64>;
    output[0] = 91;
    test_setup(null, 1);
    if (env_read(null, 1) != -22 || env_read(&output[0], 0) != -22) {
        return 1;
    }
    if (env_read(&output[0], 64) != -5 || output[0] != 91) {
        return 2;
    }
    test_setup(null, 0);
    if (env_read(&output[0], 64) != 0 || output[0] != 91) {
        return 3;
    }
    var entries: array<ptr<u8>, 3> = ["A=" as ptr<u8>, "B=xyz" as ptr<u8>, null];
    test_setup(&entries[0], 0);
    if (env_read(&output[0], 8) != -28 || output[0] != 91) {
        return 4;
    }
    if (env_read(&output[0], 9) != 9) {
        return 5;
    }
    if (output[0] != 65 || output[1] != 61 || output[2] != 0 || output[3] != 66 || output[4] != 61 || output[5] != 120 || output[6] != 121 || output[7] != 122 || output[8] != 0) {
        return 6;
    }
    if (env_read(&output[0], 9223372036854775807) != 9) {
        return 7;
    }
    entries[0] = "" as ptr<u8>;
    entries[1] = null;
    if (env_read(&output[0], 1) != 1 || output[0] != 0) {
        return 8;
    }
    entries[0] = null;
    output[0] = 91;
    if (env_read(&output[0], 1) != 0 || output[0] != 91) {
        return 9;
    }
    return 0;
}
