import("std::sys::wasm64::memory")::{mmap, munmap};
extern(c, "llvm.wasm.memory.size.i64") fun memory_size(index: i32) -> i64;
fun reject() -> bool {
    return mmap(null, 16, 0, 34, -1, 0) == null
        && mmap(null, 16, 1, 34, -1, 0) == null
        && mmap(null, 16, 2, 34, -1, 0) == null
        && mmap(null, 16, 7, 34, -1, 0) == null
        && mmap(null, 16, 3, 35, -1, 0) == null
        && mmap(null, 16, 3, 2, -1, 0) == null
        && mmap(null, 16, 3, 34, 0, 0) == null
        && mmap(null, 16, 3, 34, -1, 1) == null
        && mmap(16 as ptr<i8>, 16, 3, 34, -1, 0) == null
        && mmap(null, 0, 3, 34, -1, 0) == null
        && mmap(null, -1, 3, 34, -1, 0) == null;
}
pub fun verify() -> i32 {
    var before: i64 = memory_size(0);
    if (!reject() || memory_size(0) != before) { return 1; }
    var p: ptr<i8> = mmap(null, 16, 3, 34, -1, 0);
    if (p == null) { return 2; }
    deref p = 42;
    if (deref p != 42 || munmap(p, 16) != 0) { return 3; }
    before = memory_size(0);
    if (!reject() || memory_size(0) != before) { return 4; }
    var q: ptr<i8> = mmap(null, 16, 3, 34, -1, 0);
    if (q != p || munmap(q, 16) != 0) { return 5; }
    return 0;
}
fun main() -> i32 { return verify(); }
