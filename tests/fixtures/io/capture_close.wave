import("./diagnostic")::{phase, observed};
import("std::process::spawn")::{ProcSpawnStdoutResult, proc_spawn_capture_stdout};
import("std::process::wait")::{proc_wait, proc_status_exit_code, proc_status_exited};
import("std::io::fd")::{io_close};
fun main() -> i32 {
    var args: array<ptr<i8>, 2> = ["capture-child" as ptr<i8>, null];
    phase("capture-close: spawn");
    var child: ProcSpawnStdoutResult = proc_spawn_capture_stdout("./capture-child", &args[0], null);
    observed("spawn status", child.status);
    if (child.status < 0) {
        return 10;
    }
    io_close(child.read_fd);
    var status: i32 = 0;
    phase("capture-close: wait");
    var waited: i64 = proc_wait(child.pid, &status);
    observed("wait result", waited);
    observed("wait status", status as i64);
    if (waited != child.pid || !proc_status_exited(status)) {
        return 11;
    }
    return proc_status_exit_code(status);
}
