// Appended to the production environ provider with only env_read substituted.
fun env_read(dst: ptr<u8>, cap: i64) -> i64 {
    var blob: array<u8, 18> = [69, 61, 0, 65, 61, 120, 0, 76, 61, 97, 98, 99, 100, 101, 102, 103, 104, 0];
    var i: i64 = 0;
    while (i < 18) { dst[i] = blob[i]; i += 1; }
    return 18;
}
fun main() -> i32 {
    if (!env_exists("E") || !env_exists("A") || !env_exists("L") || env_exists("missing") || env_exists("")) { return 1; }
    var value: i64 = 123;
    if (!_env_parse_i64("9223372036854775807" as ptr<u8>, &value) || value != 9223372036854775807) { return 2; }
    if (!_env_parse_i64("-9223372036854775808" as ptr<u8>, &value) || value != -9223372036854775808) { return 3; }
    var invalid: array<str, 7> = ["9223372036854775808", "-9223372036854775809", "999999999999999999999999999999999999", "", "+", "-", "12x"];
    var i: i32 = 0;
    while (i < 7) {
        value = 123;
        if (_env_parse_i64(invalid[i] as ptr<u8>, &value) || value != 123) { return 4; }
        i += 1;
    }
    if (!_env_parse_i64("+42" as ptr<u8>, &value) || value != 42) { return 5; }
    if (!_env_parse_i64("-0" as ptr<u8>, &value) || value != 0) { return 6; }
    return 0;
}
