// SPDX-License-Identifier: MPL-2.0
import("std::net::address")::{Ipv6ParseResult, ipv6_parse, ipv6_format};

fun same(left: str, right: str) -> bool {
    var a: Ipv6ParseResult = ipv6_parse(left);
    var b: Ipv6ParseResult = ipv6_parse(right);
    if (!a.ok || !b.ok) {
        return false;
    }
    var i: i32 = 0;
    while (i < 16) {
        if (a.value.octets[i] != b.value.octets[i]) {
            return false;
        }
        i += 1;
    }
    var text: array<u8, 64>;
    if (ipv6_format(a.value, &text[0], 64) < 0) {
        return false;
    }
    var roundtrip: Ipv6ParseResult = ipv6_parse(&text[0] as str);
    if (!roundtrip.ok) {
        return false;
    }
    i = 0;
    while (i < 16) {
        if (a.value.octets[i] != roundtrip.value.octets[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

fun main() -> i32 {
    if (!same("::ffff:192.0.2.1", "::ffff:c000:201")) {
        return 1;
    }
    if (!same("0:0:0:0:0:ffff:192.0.2.1", "::ffff:c000:201")) {
        return 2;
    }
    if (!same("::192.0.2.1", "::c000:201")) {
        return 3;
    }
    if (!same("1:2:3:4:5:6:255.255.255.255", "1:2:3:4:5:6:ffff:ffff")) {
        return 4;
    }
    if (!same("1::0.0.0.0", "1::") || !same("::", "0:0:0:0:0:0:0:0")) {
        return 5;
    }
    if (ipv6_parse("::ffff:192.0.2").ok || ipv6_parse("::ffff:192.0.2.1.3").ok
        || ipv6_parse("::ffff:256.0.2.1").ok || ipv6_parse("::ffff:192.0.2.1:").ok
        || ipv6_parse("::ffff:192.0.2.1:1").ok || ipv6_parse("1:2:3:4:5:6:7:192.0.2.1").ok
        || ipv6_parse("1:2:3:4:5::6:192.0.2.1").ok || ipv6_parse("1::2::192.0.2.1").ok
        || ipv6_parse("192.0.2.1").ok || ipv6_parse("1:2:3:4:5:192.0.2.1").ok
        || ipv6_parse("::ffff:.0.2.1").ok || ipv6_parse("::ffff:192..2.1").ok
        || ipv6_parse("::ffff:192.0.2.").ok || ipv6_parse("::ffff:+192.0.2.1").ok
        || ipv6_parse("::ffff:192.0.2.1 ").ok || ipv6_parse("::ffff:1234.0.2.1").ok
        || !ipv6_parse("1:2:3:4:5:6:7:8").ok) { return 6; }
    return 0;
}
