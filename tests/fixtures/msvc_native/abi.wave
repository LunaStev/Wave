struct Bytes1 {
    data: array<u8, 1>;
}

extern(c) fun c_bytes1(value: Bytes1) -> Bytes1;

export(c) fun wave_bytes1(value: Bytes1) -> Bytes1 {
    for (var i: i64 = 0; i < 1; i += 1) {
        value.data[i] = value.data[i] ^ ((i + 37) as u8);
    }
    return value;
}

