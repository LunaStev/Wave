    data: array<u8, 2>;
}

extern(c) fun c_bytes2(value: Bytes2) -> Bytes2;

export(c) fun wave_bytes2(value: Bytes2) -> Bytes2 {
    for (var i: i64 = 0; i < 2; i += 1) {
        value.data[i] = value.data[i] ^ ((i + 37) as u8);
