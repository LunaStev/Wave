import("std::sys::windows::fs")::{
    Stat, open, close, write, read, stat, rename_path, unlink, mkdir, rmdir,
    getcwd, chdir, FS_O_CREAT, FS_O_RDWR, FS_O_RDONLY
};

fun main() -> i32 {
    var saved: array<u8, 32768>;
    var saved_length: i64 = getcwd(&saved[0], 32768);
    if (saved_length < 0) {
        return 1;
    }
    if (mkdir("경로_😀", 0) != 0 || chdir("경로_😀") != 0) {
        return 2;
    }
    var cwd: array<u8, 32768>;
    var length: i64 = getcwd(&cwd[0], 32768);
    if (length <= saved_length || cwd[length] != 0) {
        return 3;
    }
    if (chdir(&saved[0] as str) != 0 || chdir(&cwd[0] as str) != 0) {
        return 4;
    }
    var short_buffer: array<u8, 2> = [85, 86];
    if (getcwd(&short_buffer[0], 2) != -34 || short_buffer[0] != 85 || short_buffer[1] != 86) {
        return 5;
    }
    var fd: i64 = open("자료_😀.bin", FS_O_CREAT | FS_O_RDWR, 0);
    var data: array<u8, 4> = [1, 3, 5, 7];
    if (fd < 0 || write(fd, &data[0], 4) != 4 || close(fd) != 0) {
        return 6;
    }
    var info: Stat;
    if (stat("자료_😀.bin", &info) != 0 || info.size != 4
        || rename_path("자료_😀.bin", "변경_🚀.bin") != 0) {
        return 7;
    }
    fd = open("변경_🚀.bin", FS_O_RDONLY, 0);
    var copied: array<u8, 4>;
    if (fd < 0 || read(fd, &copied[0], 4) != 4 || close(fd) != 0
        || copied[0] != 1 || copied[3] != 7) {
        return 8;
    }
    var invalid: array<u8, 3> = [192, 175, 0];
    if (open(&invalid[0] as str, FS_O_RDONLY, 0) != -84) {
        return 9;
    }
    if (unlink("변경_🚀.bin") != 0 || chdir(&saved[0] as str) != 0 || rmdir("경로_😀") != 0) {
        return 10;
    }
    return 0;
}
