// SPDX-License-Identifier: MPL-2.0
extern(c) fun choose(n: i32);
extern(c) fun live_allocations() -> i32;
fun main() -> i32 {
    var buffer: array<u8, 16>;
    var mode: i32 = 0;
    while (mode <= 6) {
        choose(mode);
        buffer[0] = 85;
        var result: i64 = env_get("KEY", &buffer[0], 16);
        var expected: i64 = -5;
        if (mode == 1) { expected = -6; }
        if (mode == 3) { expected = -7; }
        if (mode == 5) { expected = 5; }
        if (mode == 6) { expected = -2; }
        if (result != expected || live_allocations() != 0) { return mode + 1; }
        if (mode != 5 && buffer[0] != 85) { return mode + 20; }
        if (mode == 5 && (buffer[0] != 118 || buffer[5] != 0)) { return 40; }
        mode += 1;
    }
    return 0;
}
