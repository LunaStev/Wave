fun increment(value: ptr<i32>) {
    deref value += 1;
}

fun sum(values: ptr<i32>, count: i32) -> i32 {
    var result: i32 = 0;
    var index: i32 = 0;
    while (index < count) {
        result += deref values[index];
        index += 1;
    }
    return result;
}

fun main() -> i32 {
    var value: i32 = 4;
    increment(&value);
    var values: array<i32, 3> = [value, 6, 7];
    values[1] = 8;
    if (sum(&values[0], 3) != 20) {
        return 1;
    }
    return 0;
}
