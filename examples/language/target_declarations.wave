// The same interface has one declaration per selected OS.
#[target(os="linux")]
fun platform_number() -> i32 {
    return 1;
}

#[target(os="windows")]
fun platform_number() -> i32 {
    return 2;
}

#[target(os="macos")]
fun platform_number() -> i32 {
    return 3;
}

#[target(os="freebsd")]
fun platform_number() -> i32 {
    return 4;
}

#[target(os="wasm")]
fun platform_number() -> i32 {
    return 5;
}

fun main() -> i32 {
    if (platform_number() < 1) {
        return 1;
    }
    return 0;
}
