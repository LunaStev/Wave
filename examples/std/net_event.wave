import("std::net::tcp")::{
    TcpListener, TcpStream,
    tcp_bind_loopback, tcp_listener_local_addr_v4, tcp_connect, tcp_accept,
    tcp_write_all_result, tcp_read_result, tcp_close, tcp_close_listener,
};
import("std::net::event")::{
    NET_EVENT_READABLE, NetEvent, NetEventLoop, NetEventWaitResult,
    net_event_loop_create, net_event_add, net_event_modify,
    net_event_remove, net_event_wait, net_event_loop_close,
};
import("std::net::address")::{SocketAddrV4};
import("std::net::error")::{NetError, NetIoResult, NetResult};

fun main() -> i32 {
    var listener: NetResult<TcpListener> = tcp_bind_loopback(0);
    if (!listener.ok) { return 1; }
    var address: NetResult<SocketAddrV4> = tcp_listener_local_addr_v4(listener.value);
    if (!address.ok) { return 2; }
    var client: NetResult<TcpStream> = tcp_connect(address.value);
    if (!client.ok) { return 3; }
    var server: NetResult<TcpStream> = tcp_accept(listener.value);
    if (!server.ok) { return 4; }

    var event_loop: NetResult<NetEventLoop> = net_event_loop_create(8);
    if (!event_loop.ok || event_loop.value.backend < 1 || event_loop.value.backend > 3) {
        return 5;
    }
    var added: NetError = net_event_add(
        event_loop.value, server.value.fd, 42, NET_EVENT_READABLE
    );
    if (added.kind != 0) { return 6; }

    var events: array<NetEvent, 8>;
    var idle: NetEventWaitResult = net_event_wait(event_loop.value, &events[0], 8, 0);
    if (idle.error.kind != 0 || idle.count != 0) { return 7; }

    var sent: NetIoResult = tcp_write_all_result(client.value, "ready" as ptr<u8>, 5);
    if (sent.error.kind != 0 || sent.count != 5) { return 8; }
    var ready: NetEventWaitResult = net_event_wait(event_loop.value, &events[0], 8, 1000);
    if (ready.error.kind != 0 || ready.count < 1
        || events[0].token != 42 || !events[0].readable) { return 9; }

    var modified: NetError = net_event_modify(
        event_loop.value, server.value.fd, 77, NET_EVENT_READABLE
    );
    if (modified.kind != 0) { return 10; }
    var incoming: array<u8, 5>;
    var received: NetIoResult = tcp_read_result(server.value, &incoming[0], 5);
    if (received.error.kind != 0 || received.count != 5) { return 11; }

    var removed: NetError = net_event_remove(event_loop.value, server.value.fd);
    if (removed.kind != 0) { return 12; }
    var closed: NetError = net_event_loop_close(event_loop.value);
    if (closed.kind != 0) { return 13; }
    tcp_close(server.value);
    tcp_close(client.value);
    tcp_close_listener(listener.value);
    return 0;
}
