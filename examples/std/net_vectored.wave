import("std::net::address")::{SocketAddrV4, socket_addr_v4_loopback};
import("std::net::error")::{NetIoResult, NetResult};
import("std::net::tcp")::{
    TcpListener, TcpStream,
    tcp_bind_loopback, tcp_listener_local_addr_v4, tcp_connect, tcp_accept,
    tcp_write_vectored, tcp_read_vectored, tcp_close, tcp_close_listener,
};
import("std::net::vectored")::{NetIoSlice};

fun main() -> i32 {
    var listener: NetResult<TcpListener> = tcp_bind_loopback(0);
    if (!listener.ok) { return 1; }
    var address: NetResult<SocketAddrV4> = tcp_listener_local_addr_v4(listener.value);
    if (!address.ok) { return 2; }
    var client: NetResult<TcpStream> = tcp_connect(address.value);
    if (!client.ok) { return 3; }
    var server: NetResult<TcpStream> = tcp_accept(listener.value);
    if (!server.ok) { return 4; }

    var outgoing: array<NetIoSlice, 2> = [
        NetIoSlice { data: "wave" as ptr<u8>, length: 4 },
        NetIoSlice { data: "net" as ptr<u8>, length: 3 }
    ];
    var sent: NetIoResult = tcp_write_vectored(client.value, &outgoing[0], 2);
    if (sent.error.kind != 0 || sent.count != 7) { return 5; }

    var first: array<u8, 4>;
    var second: array<u8, 3>;
    var incoming: array<NetIoSlice, 2> = [
        NetIoSlice { data: &first[0], length: 4 },
        NetIoSlice { data: &second[0], length: 3 }
    ];
    var received: NetIoResult = tcp_read_vectored(server.value, &incoming[0], 2);
    if (received.error.kind != 0 || received.count != 7
        || first[0] != 119 || first[3] != 101
        || second[0] != 110 || second[2] != 116) { return 6; }

    tcp_close(server.value);
    tcp_close(client.value);
    tcp_close_listener(listener.value);
    return 0;
}
