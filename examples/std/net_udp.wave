import("std::net::address")::{
    SocketAddrV4, ipv4_loopback, ipv4_unspecified, socket_addr_v4_loopback,
};
import("std::net::error")::{NetError, NetIoResult, NetResult};
import("std::net::udp")::{
    UdpSocket,
    udp_bind_loopback, udp_local_addr_v4,
    udp_connect_existing_v4, udp_send, udp_recv_from, udp_close,
    udp_set_broadcast, udp_broadcast, udp_set_ipv4_ttl, udp_ipv4_ttl,
    udp_set_multicast_ttl_v4, udp_multicast_ttl_v4,
    udp_set_multicast_loop_v4, udp_multicast_loop_v4,
    udp_join_multicast_v4,
};

fun main() -> i32 {
    var receiver: NetResult<UdpSocket> = udp_bind_loopback(0);
    if (!receiver.ok) { return 1; }
    var sender: NetResult<UdpSocket> = udp_bind_loopback(0);
    if (!sender.ok) { udp_close(receiver.value); return 2; }

    var destination: NetResult<SocketAddrV4> = udp_local_addr_v4(receiver.value);
    if (!destination.ok || destination.value.port == 0) { return 3; }

    var broadcast_result: NetError = udp_set_broadcast(sender.value, true);
    if (broadcast_result.kind != 0) { return 4; }
    var broadcast: NetResult<bool> = udp_broadcast(sender.value);
    if (!broadcast.ok || !broadcast.value) { return 5; }
    var ttl_result: NetError = udp_set_ipv4_ttl(sender.value, 42);
    if (ttl_result.kind != 0) { return 6; }
    var ttl: NetResult<i64> = udp_ipv4_ttl(sender.value);
    if (!ttl.ok || ttl.value != 42) { return 7; }

    var multicast_ttl_result: NetError = udp_set_multicast_ttl_v4(sender.value, 7);
    if (multicast_ttl_result.kind != 0) { return 8; }
    var multicast_ttl: NetResult<i64> = udp_multicast_ttl_v4(sender.value);
    if (!multicast_ttl.ok || multicast_ttl.value != 7) { return 9; }
    var multicast_loop_result: NetError = udp_set_multicast_loop_v4(sender.value, true);
    if (multicast_loop_result.kind != 0) { return 10; }
    var multicast_loop: NetResult<bool> = udp_multicast_loop_v4(sender.value);
    if (!multicast_loop.ok || !multicast_loop.value) { return 11; }
    var invalid_group: NetError = udp_join_multicast_v4(
        sender.value, ipv4_loopback(), ipv4_unspecified()
    );
    if (invalid_group.kind == 0) { return 12; }

    var connected: NetError = udp_connect_existing_v4(sender.value, destination.value);
    if (connected.kind != 0) { return 13; }

    var sent: NetIoResult = udp_send(sender.value, "wave" as ptr<u8>, 4);
    if (sent.error.kind != 0 || sent.count != 4) { return 14; }

    var data: array<u8, 8>;
    var peer: SocketAddrV4 = socket_addr_v4_loopback(0);
    var received: NetIoResult = udp_recv_from(receiver.value, &data[0], 8, &peer);
    if (received.error.kind != 0 || received.count != 4) { return 15; }
    if (data[0] != 119 || data[1] != 97 || data[2] != 118 || data[3] != 101) { return 16; }
    if (peer.port == 0) { return 17; }

    var empty: NetIoResult = udp_send(sender.value, null, 0);
    if (empty.error.kind != 0 || empty.count != 0) { return 18; }
    var empty_received: NetIoResult = udp_recv_from(receiver.value, &data[0], 8, &peer);
    if (empty_received.error.kind != 0 || empty_received.count != 0) { return 19; }

    udp_close(sender.value);
    udp_close(receiver.value);
    return 0;
}
