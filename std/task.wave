    if (slot.registered && iocp_cancel(slot.id) == 0) { slot.registered = false; }
}
#[target(os="windows")]
fun _watch_start(token: i64, fd: i64, flags: i32) -> i64 { return iocp_watch(token, fd, flags); }
#[target(os="windows")]
fun _watch_stop(token: i64, fd: i64) -> bool { return iocp_cancel(token) != 0; }
#[target(os="windows")]
fun _close_io(slot: ptr<TaskSlot>) {
    slot.terminal = -9; slot.deadline = -1;
    _cancel_registration(slot);
    if (!slot.registered) { _io_result(slot, -9); }
}
#[target(os="windows")]
fun _shutdown_native() { iocp_shutdown(); }
#[target(os="windows")]
fun _io_result(slot: ptr<TaskSlot>, value: i64) {
    var output: ptr<i64> = slot.result as ptr<i64>;
    deref output = value; slot.registered = false; _complete(slot.id);
}
#[target(os="windows")]
fun _arm(slot: ptr<TaskSlot>) {
    slot.state = 4;
    if (slot.fd < 0) { return; }
    if (slot.kind == 1) { _refresh_watch(slot.fd); return; }
    var status: i64 = iocp_start_io(slot.id, slot.fd, slot.buffer, slot.length, slot.writing);
    if (status < 0) { _io_result(slot, status); } else { slot.registered = true; }
}
#[target(os="windows")]
fun _park(blocking: bool) -> bool {
    var deadline: i64 = -1; var registered: bool = false; var waiting: bool = false;
    var group: ptr<WatchGroup> = _watches;
    while (group != null) {
        if (group.active || group.draining) { registered = true; waiting = true; }
        group = group.next;
    }
    var slot: ptr<TaskSlot> = _head;
    while (slot != null) {
        if (slot.state == 4 || slot.state == 7) {
            if (slot.registered) { registered = true; waiting = true; }
            if (slot.state == 4 && (slot.kind == 1 || slot.kind == 2)) {
                waiting = true;
                if (slot.deadline >= 0 && (deadline < 0 || slot.deadline < deadline)) { deadline = slot.deadline; }
            }
        }
        slot = slot.next;
    }
    if (!waiting) { return false; }
    var timeout: i32 = -1;
    if (deadline >= 0) {
        var remaining: i64 = deadline - _now_ms();
        if (remaining < 0) { remaining = 0; }
        if (remaining > 2147483647) { remaining = 2147483647; }
        timeout = remaining as i32;
    }
    if (!blocking) { timeout = 0; }
    if (registered) {
        var completion: IocpCompletion;
        var count: i64 = iocp_wait(&completion, timeout);
        if (count < 0) { proc_exit(73); }
        if (count > 0) {
            if (completion.kind == 1) { _deliver_watch(completion.token, completion.value as i32); }
            else {
                slot = _head;
                while (slot != null) {
                    if (slot.id == completion.token && slot.registered) {
                        slot.registered = false;
                        if (slot.state == 7) { _settle_cancelled(); }
                        else {
                            var value: i64 = completion.value;
                            if (slot.terminal != 0) { value = slot.terminal; }
                            _io_result(slot, value);
                        }
                        break;
                    }
                    slot = slot.next;
                }
            }
        }
    } else { if (timeout < 0) { return false; } time_sleep_ms(timeout as i64); }
    var now: i64 = _now_ms(); slot = _head;
    while (slot != null) {
        if (slot.state == 4 && (slot.kind == 1 || slot.kind == 2) && slot.deadline >= 0 && slot.deadline <= now) {
            slot.deadline = -1;
            if (slot.kind == 1) {
                if (slot.fd < 0) { _event_result(slot, 0); } else { _event_result(slot, -110); }
            } else {
                slot.terminal = -110; _cancel_registration(slot);
                if (!slot.registered) { _io_result(slot, -110); }
            }
        }
        slot = slot.next;
    }
    _settle_cancelled(); return true;
}
#[target(os="windows")]
export(c, "__wave_task_io") fun _io(fd: i64, buffer: ptr<u8>, length: i64, writing: i32, timeout_ms: i64) -> i64 {
    var memory: ptr<u8> = _allocate(8);
    var id: i64 = _new(memory, 8, memory, null); var slot: ptr<TaskSlot> = _find(id);
    slot.kind = 2; slot.fd = fd; slot.buffer = buffer; slot.length = length; slot.writing = writing != 0;
    if (fd < 0 || buffer == null || length <= 0 || length > 4294967295 || timeout_ms < -1) { _io_result(slot, -22); return id; }
    if (timeout_ms >= 0) {
        var now: i64 = _now_ms(); if (timeout_ms > 9223372036854775807 - now) { _io_result(slot, -22); return id; }
        slot.deadline = now + timeout_ms;
    }
    return id;
}
// cancel() requests cancellation; cancel_and_join() consumes the handle and waits for cleanup.
pub fun cancel_and_join<T>(future: Future<T>) -> Future<void> { return __wave_async_cancel_join(future); }
#[target(os="windows")]
pub fun overlapped_read(fd: i64, buffer: ptr<u8>, length: i64, timeout_ms: i64) -> Future<i64> { return __wave_async_io(fd, buffer, length, 0, timeout_ms); }
#[target(os="windows")]
pub fun overlapped_write(fd: i64, buffer: ptr<u8>, length: i64, timeout_ms: i64) -> Future<i64> { return __wave_async_io(fd, buffer, length, 1, timeout_ms); }
