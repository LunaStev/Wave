}
export(c, "__wave_task_yield") fun _yield() -> i64 {
    return _new(null, 0, null, null);
}
export(c, "__wave_task_shutdown") fun _shutdown() {
    if (_driving) { proc_exit(72); }
    _shutdown_native();
    var slot: ptr<TaskSlot> = _head;
    while (slot != null) {
        var next: ptr<TaskSlot> = slot.next;
        if (slot.frame != null) { mem_free(slot.frame, slot.size); }
        // Compiler supplies the exact target layout, including padding.
        __wave_async_free_slot(slot);
        slot = next;
    }
    _head = null;
    var group: ptr<WatchGroup> = _watches;
    while (group != null) { var next: ptr<WatchGroup> = group.next; __wave_async_free_slot(group); group = next; }
    _watches = null;
    if (_event_handle >= 0) { net_event_loop_close(NetEventLoop { handle: _event_handle, backend: _event_backend }); _event_handle = -1; }
