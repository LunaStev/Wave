import("std::buffer::alloc")::{
    Buffer,
    buffer_is_valid,
    buffer_reserve,
    buffer_reserve_additional,
};
import("std::buffer::error")::{
    BUFFER_OK,
    BUFFER_ERR_INVALID,
    BUFFER_ERR_BOUNDS,
    BUFFER_ERR_OVERFLOW,
};
import("std::mem::consts")::{MEM_ERR_OVERFLOW};
import("std::mem::ops")::{mem_move, mem_size_add_checked};

pub fun buffer_push(buf: ptr<Buffer>, value: u8) -> i64 {
    var ret: i64 = buffer_reserve_additional(buf, 1);

    if (ret < 0) {
        return ret;
    }

    var needed: i64 = deref buf.len + 1;
    var p: ptr<u8> = deref buf.data;
    deref p[deref buf.len] = value;
    deref buf.len = needed;

    return BUFFER_OK;
}

// Appends size initialized bytes. If src aliases this buffer, its offset is
// retained across growth so reserve cannot turn it into a dangling pointer.
pub fun buffer_append(buf: ptr<Buffer>, src: ptr<u8>, size: i64) -> i64 {
    if (!buffer_is_valid(buf) || size < 0) {
        return BUFFER_ERR_INVALID;
    }

    if (size == 0) {
        return BUFFER_OK;
    }

    if (src == null) {
        return BUFFER_ERR_INVALID;
    }

    var base: i64 = deref buf.len;
    var needed: i64 = 0;
    var add_result: i64 = mem_size_add_checked(base, size, &needed);
    if (add_result == MEM_ERR_OVERFLOW) {
        return BUFFER_ERR_OVERFLOW;
    }
    if (add_result < 0) {
        return BUFFER_ERR_INVALID;
    }

    var source_offset: i64 = -1;
    var old_data: ptr<u8> = deref buf.data;
    if (old_data != null) {
        var data_addr: u64 = old_data as u64;
        var src_addr: u64 = src as u64;
        if (src_addr >= data_addr) {
            var offset_value: u64 = src_addr - data_addr;
            if (offset_value <= deref buf.cap as u64) {
                var offset: i64 = offset_value as i64;
                if (offset > deref buf.len || size > deref buf.len - offset) {
                    return BUFFER_ERR_INVALID;
                }
                source_offset = offset;
            }
        }
    }

    var ret: i64 = buffer_reserve(buf, needed);

    if (ret < 0) {
        return ret;
    }

    var dst: ptr<u8> = deref buf.data;
    var actual_src: ptr<u8> = src;
    if (source_offset >= 0) {
        actual_src = dst + source_offset;
    }

    mem_move(dst + base, actual_src, size);
    deref buf.len = needed;
    return BUFFER_OK;
}

pub fun buffer_append_str(buf: ptr<Buffer>, s: str) -> i64 {
    var size: i64 = 0;
    while (s[size] != 0) {
        size += 1;
    }

    return buffer_append(buf, s as ptr<u8>, size);
}

pub fun buffer_set(buf: ptr<Buffer>, index: i64, value: u8) -> bool {
    return buffer_set_checked(buf, index, value) == BUFFER_OK;
}

pub fun buffer_set_checked(buf: ptr<Buffer>, index: i64, value: u8) -> i64 {
    if (!buffer_is_valid(buf)) {
        return BUFFER_ERR_INVALID;
    }

    if (index < 0 || index >= deref buf.len) {
        return BUFFER_ERR_BOUNDS;
    }

    var data: ptr<u8> = deref buf.data;
    deref data[index] = value;
    return BUFFER_OK;
}

pub fun buffer_pop(buf: ptr<Buffer>, out_value: ptr<u8>) -> i64 {
    if (!buffer_is_valid(buf) || out_value == null) {
        return BUFFER_ERR_INVALID;
    }

    if (deref buf.len == 0) {
        return BUFFER_ERR_BOUNDS;
    }

    var next_len: i64 = deref buf.len - 1;
    var data: ptr<u8> = deref buf.data;
    deref out_value = data[next_len];
    deref buf.len = next_len;
    return BUFFER_OK;
}

pub fun buffer_append_buffer(dst: ptr<Buffer>, src: ptr<Buffer>) -> i64 {
    if (!buffer_is_valid(src)) {
        return BUFFER_ERR_INVALID;
    }

    return buffer_append(dst, deref src.data, deref src.len);
}
