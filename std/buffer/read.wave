import("std::buffer::types")::{
    Buffer,
    TypedBuffer,
};

pub fun buffer_at(buf: Buffer, index: i64) -> u8 {
    if (index < 0 || index >= buf.len) {
        return 0;
    }

    return buf.data[index];
}

pub fun tbuffer_ptr<T>(buf: TypedBuffer<T>) -> ptr<T> {
    return buf.data as ptr<T>;
}

pub fun tbuffer_len<T>(buf: TypedBuffer<T>) -> i64 {
    return buf.len;
}

pub fun tbuffer_at<T>(buf: TypedBuffer<T>, index: i64, out_value: ptr<T>) -> bool {
    if (index < 0 || index >= buf.len) {
        return false;
    }

    var offset_bytes: i64 = index * buf.elem_size;
    var slot: ptr<T> = (buf.data + offset_bytes) as ptr<T>;
    deref out_value = deref slot;

    return true;
}
