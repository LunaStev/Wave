import("std::buffer::alloc")::{
    Buffer,
    buffer_is_valid,
};
import("std::buffer::error")::{BUFFER_OK, BUFFER_ERR_INVALID, BUFFER_ERR_BOUNDS};

pub fun buffer_len(buf: ptr<Buffer>) -> i64 {
    if (!buffer_is_valid(buf)) {
        return BUFFER_ERR_INVALID;
    }
    return deref buf.len;
}

pub fun buffer_capacity(buf: ptr<Buffer>) -> i64 {
    if (!buffer_is_valid(buf)) {
        return BUFFER_ERR_INVALID;
    }
    return deref buf.cap;
}

pub fun buffer_is_empty(buf: ptr<Buffer>) -> bool {
    return buffer_is_valid(buf) && deref buf.len == 0;
}

pub fun buffer_as_ptr(buf: ptr<Buffer>) -> ptr<u8> {
    if (!buffer_is_valid(buf)) {
        return null;
    }
    return deref buf.data;
}

// Reads one byte without using 0 as an out-of-bounds sentinel.
pub fun buffer_get(buf: ptr<Buffer>, index: i64, out_value: ptr<u8>) -> i64 {
    if (!buffer_is_valid(buf) || out_value == null) {
        return BUFFER_ERR_INVALID;
    }

    if (index < 0 || index >= deref buf.len) {
        return BUFFER_ERR_BOUNDS;
    }

    deref out_value = deref buf.data[index];
    return BUFFER_OK;
}

// Convenience accessor retained for simple code. Use buffer_get when zero and
// out-of-bounds must be distinguished.
pub fun buffer_at(buf: Buffer, index: i64) -> u8 {
    var value: u8 = 0;
    if (buffer_get(&buf, index, &value) < 0) {
        return 0;
    }

    return value;
}
