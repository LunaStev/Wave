import("std::mem::alloc")::{
    mem_alloc,
    mem_free,
};
import("std::mem::ops")::{
    mem_set,
    mem_copy,
    mem_size_add_checked,
};
import("std::mem::consts")::{MEM_ERR_OVERFLOW};
pub import("std::buffer::error")::{
    BUFFER_OK,
    BUFFER_ERR_INVALID,
    BUFFER_ERR_BOUNDS,
    BUFFER_ERR_OVERFLOW,
    BUFFER_ERR_ALLOC,
};
pub import("std::buffer::types")::{Buffer};

fun _buffer_empty() -> Buffer {
    return Buffer { data: null, len: 0, cap: 0 };
}

// Reports whether the public Buffer fields describe one valid owned byte
// allocation. Empty buffers use the canonical { null, 0, 0 } state.
pub fun buffer_is_valid(buf: ptr<Buffer>) -> bool {
    if (buf == null) {
        return false;
    }

    var data: ptr<u8> = deref buf.data;
    var len: i64 = deref buf.len;
    var cap: i64 = deref buf.cap;

    if (len < 0 || cap < 0 || len > cap) {
        return false;
    }

    if (cap == 0) {
        return data == null && len == 0;
    }

    return data != null;
}

// Initializes caller-owned storage. Unlike buffer_new, allocation failure is
// explicit in the return value.
// Example: var b: Buffer; if (buffer_init(&b, 128) < 0) { return; }
pub fun buffer_init(out_buf: ptr<Buffer>, capacity: i64) -> i64 {
    if (out_buf == null || capacity < 0) {
        return BUFFER_ERR_INVALID;
    }

    deref out_buf.data = null;
    deref out_buf.len = 0;
    deref out_buf.cap = 0;

    if (capacity == 0) {
        return BUFFER_OK;
    }

    var data: ptr<u8> = mem_alloc(capacity);
    if (data == null) {
        return BUFFER_ERR_ALLOC;
    }

    deref out_buf.data = data;
    deref out_buf.cap = capacity;
    return BUFFER_OK;
}

pub fun buffer_new(capacity: i64) -> Buffer {
    var created: Buffer = _buffer_empty();
    buffer_init(&created, capacity);
    return created;
}

pub fun buffer_new_default() -> Buffer {
    return buffer_new(64);
}

pub fun buffer_free(buf: ptr<Buffer>) -> i64 {
    if (!buffer_is_valid(buf)) {
        return BUFFER_ERR_INVALID;
    }

    if (deref buf.cap == 0) {
        return BUFFER_OK;
    }

    var ret: i64 = mem_free(deref buf.data, deref buf.cap);
    if (ret < 0) {
        return BUFFER_ERR_ALLOC;
    }

    deref buf.data = null;
    deref buf.len = 0;
    deref buf.cap = 0;

    return BUFFER_OK;
}

pub fun buffer_clear(buf: ptr<Buffer>) -> i64 {
    if (!buffer_is_valid(buf)) {
        return BUFFER_ERR_INVALID;
    }

    deref buf.len = 0;
    return BUFFER_OK;
}

pub fun buffer_reserve(buf: ptr<Buffer>, required_cap: i64) -> i64 {
    if (!buffer_is_valid(buf) || required_cap < 0) {
        return BUFFER_ERR_INVALID;
    }

    if (required_cap <= deref buf.cap) {
        return BUFFER_OK;
    }

    var new_cap: i64 = deref buf.cap;
    if (new_cap <= 0) {
        new_cap = 64;
    }

    while (new_cap < required_cap) {
        if (new_cap > 4611686018427387903) {
            new_cap = required_cap;
        } else {
            new_cap = new_cap * 2;
        }
    }

    var new_data: ptr<u8> = mem_alloc(new_cap);
    if (new_data == null) {
        return BUFFER_ERR_ALLOC;
    }

    if (deref buf.len > 0) {
        mem_copy(new_data, deref buf.data, deref buf.len);
    }

    if (deref buf.cap > 0) {
        var free_result: i64 = mem_free(deref buf.data, deref buf.cap);
        if (free_result < 0) {
            mem_free(new_data, new_cap);
            return BUFFER_ERR_ALLOC;
        }
    }

    deref buf.data = new_data;
    deref buf.cap = new_cap;

    return BUFFER_OK;
}

// Ensures room for additional bytes without evaluating len + additional in
// unchecked signed arithmetic.
pub fun buffer_reserve_additional(buf: ptr<Buffer>, additional: i64) -> i64 {
    if (!buffer_is_valid(buf) || additional < 0) {
        return BUFFER_ERR_INVALID;
    }

    var required: i64 = 0;
    var add_result: i64 = mem_size_add_checked(deref buf.len, additional, &required);
    if (add_result == MEM_ERR_OVERFLOW) {
        return BUFFER_ERR_OVERFLOW;
    }
    if (add_result < 0) {
        return BUFFER_ERR_INVALID;
    }

    return buffer_reserve(buf, required);
}

// Reduces the visible length without releasing capacity.
pub fun buffer_truncate(buf: ptr<Buffer>, new_len: i64) -> i64 {
    if (!buffer_is_valid(buf) || new_len < 0) {
        return BUFFER_ERR_INVALID;
    }

    if (new_len < deref buf.len) {
        deref buf.len = new_len;
    }
    return BUFFER_OK;
}

// Changes the visible length, filling newly exposed bytes with value.
pub fun buffer_resize(buf: ptr<Buffer>, new_len: i64, value: u8) -> i64 {
    if (!buffer_is_valid(buf) || new_len < 0) {
        return BUFFER_ERR_INVALID;
    }

    var old_len: i64 = deref buf.len;
    if (new_len <= old_len) {
        deref buf.len = new_len;
        return BUFFER_OK;
    }

    var reserve_result: i64 = buffer_reserve(buf, new_len);
    if (reserve_result < 0) {
        return reserve_result;
    }

    var data: ptr<u8> = deref buf.data;
    mem_set(data + old_len, value, new_len - old_len);
    deref buf.len = new_len;
    return BUFFER_OK;
}
