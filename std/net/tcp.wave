pub struct TcpAddr {
    ip: i32;      // network byte order
    port: i16;    // network byte order
}

pub struct TcpListener {
    fd: i64;
}

pub struct TcpStream {
    fd: i64;
}

pub fun _tcp_to_net_addr(addr: TcpAddr) -> NetAddrV4 {
    var value: NetAddrV4;
    value.ip = addr.ip;
    value.port = addr.port;
    return value;
}

pub fun _tcp_from_net_addr(addr: NetAddrV4) -> TcpAddr {
    var value: TcpAddr;
    value.ip = addr.ip;
    value.port = addr.port;
    return value;
}

pub fun htons(x: i16) -> i16 {
    return net_htons(x);
}

pub fun htonl(x: i32) -> i32 {
    return net_htonl(x);
}

pub fun tcp_addr(ip_host_order: i32, port_host_order: i16) -> TcpAddr {
    return _tcp_from_net_addr(net_addr_v4(ip_host_order, port_host_order));
}

pub fun tcp_addr_any(port_host_order: i16) -> TcpAddr {
    return _tcp_from_net_addr(net_addr_any_v4(port_host_order));
}

pub fun tcp_addr_loopback(port_host_order: i16) -> TcpAddr {
    return _tcp_from_net_addr(net_addr_loopback_v4(port_host_order));
}

pub fun tcp_set_reuseaddr(fd: i64) -> i64 {
    return net_set_reuseaddr(fd);
}

pub fun tcp_bind(port: i16) -> TcpListener {
    return tcp_bind_with_backlog(port, 128);
}

pub fun tcp_bind_with_backlog(port: i16, backlog: i32) -> TcpListener {
    var addr: TcpAddr = tcp_addr_any(port);
    return tcp_bind_addr(addr, backlog);
}

pub fun tcp_bind_addr(addr: TcpAddr, backlog: i32) -> TcpListener {
    var fd: i64 = net_socket_tcp_v4();
    net_set_reuseaddr(fd);

    net_bind_v4(fd, _tcp_to_net_addr(addr));
    listen(fd, backlog);

    return TcpListener { fd: fd };
}

pub fun tcp_accept(listener: TcpListener) -> TcpStream {
    var cfd: i64 = net_accept_v4(listener.fd, null);
    return TcpStream { fd: cfd };
}

pub fun tcp_accept_addr(listener: TcpListener, src: ptr<TcpAddr>) -> TcpStream {
    var peer: NetAddrV4;
    var cfd: i64 = net_accept_v4(listener.fd, &peer);
    if (cfd >= 0) {
        deref src = _tcp_from_net_addr(peer);
    }
    return TcpStream { fd: cfd };
}

pub fun tcp_close_listener(listener: TcpListener) {
    net_shutdown_close(listener.fd);
}

pub fun tcp_connect(addr: TcpAddr) -> TcpStream {
    var fd: i64 = net_socket_tcp_v4();
    net_connect_v4(fd, _tcp_to_net_addr(addr));
    return TcpStream { fd: fd };
}

pub fun tcp_try_connect(addr: TcpAddr) -> i64 {
    var fd: i64 = net_socket_tcp_v4();
    var r: i64 = net_connect_v4(fd, _tcp_to_net_addr(addr));
    if (r < 0) {
        close(fd);
        return r;
    }
    return fd;
}

pub fun tcp_read(stream: TcpStream, buf: ptr<u8>, len: i64) -> i64 {
    return recv(stream.fd, buf, len, 0);
}

pub fun tcp_write(stream: TcpStream, buf: ptr<u8>, len: i64) -> i64 {
    return send(stream.fd, buf, len, 0);
}

pub fun tcp_write_all(stream: TcpStream, buf: ptr<u8>, len: i64) -> i64 {
    return net_send_all(stream.fd, buf, len, 0);
}

pub fun tcp_read_exact(stream: TcpStream, buf: ptr<u8>, len: i64) -> i64 {
    return net_recv_exact(stream.fd, buf, len, 0);
}

pub fun tcp_write_str(stream: TcpStream, s: str) -> i64 {
    var n: i64 = len(s) as i64;
    if (n <= 0) {
        return 0;
    }
    return tcp_write_all(stream, s as ptr<u8>, n);
}

pub fun tcp_stream_set_nonblock(stream: TcpStream, enabled: i32) -> i64 {
    return net_set_nonblock(stream.fd, enabled);
}

pub fun tcp_stream_get_nonblock(stream: TcpStream) -> i64 {
    return net_get_nonblock(stream.fd);
}

pub fun tcp_listener_set_nonblock(listener: TcpListener, enabled: i32) -> i64 {
    return net_set_nonblock(listener.fd, enabled);
}

pub fun tcp_listener_get_nonblock(listener: TcpListener) -> i64 {
    return net_get_nonblock(listener.fd);
}

pub fun tcp_from_fd(fd: i64) -> TcpStream {
    return TcpStream { fd: fd };
}

pub fun tcp_listener_from_fd(fd: i64) -> TcpListener {
    return TcpListener { fd: fd };
}

pub fun tcp_stream_valid(stream: TcpStream) -> bool {
    return net_fd_valid(stream.fd);
}

pub fun tcp_listener_valid(listener: TcpListener) -> bool {
    return net_fd_valid(listener.fd);
}

pub fun tcp_close(stream: TcpStream) {
    net_shutdown_close(stream.fd);
}
