import("std::sys::socket")::{
    AF_INET,
    AF_INET6,
    SOCK_STREAM,
    SOCK_DGRAM,
    IPPROTO_IP,
    IPPROTO_TCP,
    IPPROTO_UDP,
    SHUT_RD,
    SHUT_WR,
    SHUT_RDWR,
    SOL_SOCKET,
    SO_REUSEADDR,
    SO_REUSEPORT,
    POLLIN,
    POLLOUT,
    POLLERR,
    POLLHUP,
    POLLNVAL,
    PollFd,
    socket,
    bind,
    listen,
    accept,
    connect,
    shutdown,
    setsockopt,
    getsockopt,
    poll,
    send,
    recv,
    sendto,
    recvfrom,
};
pub import("std::sys::socket")::{
    PollFd,
};

pub const NET_POLLIN: i16 = POLLIN;
pub const NET_POLLOUT: i16 = POLLOUT;
pub const NET_POLLERR: i16 = POLLERR;
pub const NET_POLLHUP: i16 = POLLHUP;
pub const NET_POLLNVAL: i16 = POLLNVAL;

pub fun net_poll(fds: ptr<PollFd>, nfds: i64, timeout_ms: i32) -> i64 {
    return poll(fds, nfds, timeout_ms);
}

pub fun net_wait_readable(fd: i64, timeout_ms: i32) -> i64 {
    var pfd: PollFd = PollFd {
        fd: fd as i32,
        events: NET_POLLIN,
        revents: 0
    };

    var r: i64 = net_poll(&pfd, 1, timeout_ms);
    if (r <= 0) {
        return r;
    }

    if ((pfd.revents & (NET_POLLERR | NET_POLLHUP | NET_POLLNVAL)) != 0) {
        return -1;
    }

    if ((pfd.revents & NET_POLLIN) != 0) {
        return 1;
    }

    return 0;
}

pub fun net_wait_writable(fd: i64, timeout_ms: i32) -> i64 {
    var pfd: PollFd = PollFd {
        fd: fd as i32,
        events: NET_POLLOUT,
        revents: 0
    };

    var r: i64 = net_poll(&pfd, 1, timeout_ms);
    if (r <= 0) {
        return r;
    }

    if ((pfd.revents & (NET_POLLERR | NET_POLLHUP | NET_POLLNVAL)) != 0) {
        return -1;
    }

    if ((pfd.revents & NET_POLLOUT) != 0) {
        return 1;
    }

    return 0;
}
