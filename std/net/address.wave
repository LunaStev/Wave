// Portable IP and socket addresses. Native sockaddr layouts belong to
// std::sys::socket_addr and never become part of this public representation.

pub const NET_ADDRESS_IPV4: i32 = 4;
pub const NET_ADDRESS_IPV6: i32 = 6;
pub const NET_ADDRESS_TEXT_INVALID: i64 = -22;
pub const NET_ADDRESS_TEXT_NO_SPACE: i64 = -28;

pub struct Ipv4Addr {
    value: u32;
}

pub struct Ipv6Addr {
    octets: array<u8, 16>;
}

pub struct SocketAddrV4 {
    ip: Ipv4Addr;
    port: u16;
}

pub struct SocketAddrV6 {
    ip: Ipv6Addr;
    port: u16;
    flowinfo: u32;
    scope_id: u32;
}

// A backend-neutral address container usable until payload variants are
// available in every backend. IPv4 uses the first four octets.
pub struct IpAddr {
    family: i32;
    octets: array<u8, 16>;
}

pub struct SocketAddr {
    ip: IpAddr;
    port: u16;
    flowinfo: u32;
    scope_id: u32;
}

pub struct Ipv4ParseResult {
    ok: bool;
    value: Ipv4Addr;
}

pub struct Ipv6ParseResult {
    ok: bool;
    value: Ipv6Addr;
}

pub struct IpAddrV4Result {
    ok: bool;
    value: Ipv4Addr;
}

pub struct IpAddrV6Result {
    ok: bool;
    value: Ipv6Addr;
}

pub struct SocketAddrV4Result {
    ok: bool;
    value: SocketAddrV4;
}

pub struct SocketAddrV6Result {
    ok: bool;
    value: SocketAddrV6;
}

pub fun net_hton_u16(value: u16) -> u16 {
    return ((value & 255) << 8) | ((value >> 8) & 255);
}

pub fun net_ntoh_u16(value: u16) -> u16 {
    return net_hton_u16(value);
}

pub fun net_hton_u32(value: u32) -> u32 {
    return ((value & 0x000000FF) << 24)
         | ((value & 0x0000FF00) << 8)
         | ((value & 0x00FF0000) >> 8)
         | ((value & 0xFF000000) >> 24);
}

pub fun net_ntoh_u32(value: u32) -> u32 {
    return net_hton_u32(value);
}

// Signed compatibility helpers preserve the previous API while performing
// all shifts through unsigned values.
pub fun net_htons(value: i16) -> i16 {
    return net_hton_u16(value as u16) as i16;
}

pub fun net_ntohs(value: i16) -> i16 {
    return net_ntoh_u16(value as u16) as i16;
}

pub fun net_htonl(value: i32) -> i32 {
    return net_hton_u32(value as u32) as i32;
}

pub fun net_ntohl(value: i32) -> i32 {
    return net_ntoh_u32(value as u32) as i32;
}

pub fun ipv4_from_u32(value: u32) -> Ipv4Addr {
    return Ipv4Addr { value: value };
}

pub fun ipv4_to_u32(value: Ipv4Addr) -> u32 {
    return value.value;
}

pub fun ipv4_addr(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
    var value: u32 = (a as u32 << 24)
                   | (b as u32 << 16)
                   | (c as u32 << 8)
                   | d as u32;
    return ipv4_from_u32(value);
}

pub fun ipv4_unspecified() -> Ipv4Addr {
    return ipv4_from_u32(0);
}

pub fun ipv4_loopback() -> Ipv4Addr {
    return ipv4_addr(127, 0, 0, 1);
}

pub fun ipv4_broadcast() -> Ipv4Addr {
    return ipv4_from_u32(4294967295 as u32);
}

pub fun ipv4_octet(value: Ipv4Addr, index: i32) -> u8 {
    if (index == 0) { return ((value.value >> 24) & 255) as u8; }
    if (index == 1) { return ((value.value >> 16) & 255) as u8; }
    if (index == 2) { return ((value.value >> 8) & 255) as u8; }
    if (index == 3) { return (value.value & 255) as u8; }
    return 0;
}

pub fun socket_addr_v4(ip: Ipv4Addr, port: u16) -> SocketAddrV4 {
    return SocketAddrV4 { ip: ip, port: port };
}

pub fun socket_addr_v4_any(port: u16) -> SocketAddrV4 {
    return socket_addr_v4(ipv4_unspecified(), port);
}

pub fun socket_addr_v4_loopback(port: u16) -> SocketAddrV4 {
    return socket_addr_v4(ipv4_loopback(), port);
}

pub fun ipv6_unspecified() -> Ipv6Addr {
    var value: Ipv6Addr;
    var i: i32 = 0;
    while (i < 16) {
        value.octets[i] = 0;
        i += 1;
    }
    return value;
}

pub fun ipv6_loopback() -> Ipv6Addr {
    var value: Ipv6Addr = ipv6_unspecified();
    value.octets[15] = 1;
    return value;
}

pub fun ipv6_from_octets(octets: ptr<u8>) -> Ipv6Addr {
    var value: Ipv6Addr;
    var i: i32 = 0;
    while (i < 16) {
        value.octets[i] = octets[i];
        i += 1;
    }
    return value;
}

fun _ipv6_hex_value(c: u8) -> i32 {
    if (c >= 48 && c <= 57) { return (c - 48) as i32; }
    if (c >= 65 && c <= 70) { return (c - 65 + 10) as i32; }
    if (c >= 97 && c <= 102) { return (c - 97 + 10) as i32; }
    return -1;
}

pub fun ipv6_parse(text: str) -> Ipv6ParseResult {
    var groups: array<u16, 8>;
    var group_count: i32 = 0;
    var compression: i32 = -1;
    var i: i32 = 0;

    if (text[0] == 0) {
        return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
    }

    if (text[0] == 58) {
        if (text[1] != 58) {
            return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
        }
        compression = 0;
        i = 2;
    }

    while (text[i] != 0) {
        if (group_count >= 8) {
            return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
        }

        var digits: i32 = 0;
        var group: u16 = 0;
        while (text[i] != 0 && text[i] != 58) {
            var digit: i32 = _ipv6_hex_value(text[i]);
            if (digit < 0 || digits >= 4) {
                return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
            }
            group = (group << 4) | digit as u16;
            digits += 1;
            i += 1;
        }
        if (digits == 0) {
            return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
        }

        groups[group_count] = group;
        group_count += 1;
        if (text[i] == 0) { break; }

        i += 1;
        if (text[i] == 58) {
            if (compression >= 0) {
                return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
            }
            compression = group_count;
            i += 1;
            if (text[i] == 0) { break; }
        } else if (text[i] == 0) {
            return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
        }
    }

    if (compression >= 0) {
        var zeros: i32 = 8 - group_count;
        if (zeros <= 0) {
            return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
        }
        var move: i32 = group_count - 1;
        while (move >= compression) {
            var destination: i32 = move + zeros;
            groups[destination] = groups[move];
            move -= 1;
        }
        var fill: i32 = compression;
        while (fill < compression + zeros) {
            groups[fill] = 0;
            fill += 1;
        }
        group_count = 8;
    }

    if (group_count != 8) {
        return Ipv6ParseResult { ok: false, value: ipv6_unspecified() };
    }

    var value: Ipv6Addr;
    var group_index: i32 = 0;
    while (group_index < 8) {
        var octet_index: i32 = group_index * 2;
        value.octets[octet_index] = (groups[group_index] >> 8) as u8;
        octet_index += 1;
        value.octets[octet_index] = (groups[group_index] & 255) as u8;
        group_index += 1;
    }
    return Ipv6ParseResult { ok: true, value: value };
}

pub fun socket_addr_v6(
    ip: Ipv6Addr,
    port: u16,
    flowinfo: u32,
    scope_id: u32
) -> SocketAddrV6 {
    return SocketAddrV6 {
        ip: ip,
        port: port,
        flowinfo: flowinfo,
        scope_id: scope_id
    };
}

pub fun socket_addr_v6_any(port: u16) -> SocketAddrV6 {
    return socket_addr_v6(ipv6_unspecified(), port, 0, 0);
}

pub fun socket_addr_v6_loopback(port: u16) -> SocketAddrV6 {
    return socket_addr_v6(ipv6_loopback(), port, 0, 0);
}

pub fun ip_addr_from_v4(ip: Ipv4Addr) -> IpAddr {
    var value: IpAddr;
    value.family = NET_ADDRESS_IPV4;
    var i: i32 = 0;
    while (i < 16) {
        value.octets[i] = 0;
        i += 1;
    }
    value.octets[0] = ipv4_octet(ip, 0);
    value.octets[1] = ipv4_octet(ip, 1);
    value.octets[2] = ipv4_octet(ip, 2);
    value.octets[3] = ipv4_octet(ip, 3);
    return value;
}

pub fun ip_addr_from_v6(ip: Ipv6Addr) -> IpAddr {
    var value: IpAddr;
    value.family = NET_ADDRESS_IPV6;
    var i: i32 = 0;
    while (i < 16) {
        value.octets[i] = ip.octets[i];
        i += 1;
    }
    return value;
}

pub fun socket_addr_from_v4(addr: SocketAddrV4) -> SocketAddr {
    return SocketAddr {
        ip: ip_addr_from_v4(addr.ip),
        port: addr.port,
        flowinfo: 0,
        scope_id: 0
    };
}

pub fun socket_addr_from_v6(addr: SocketAddrV6) -> SocketAddr {
    return SocketAddr {
        ip: ip_addr_from_v6(addr.ip),
        port: addr.port,
        flowinfo: addr.flowinfo,
        scope_id: addr.scope_id
    };
}

pub fun ip_addr_as_v4(ip: IpAddr) -> IpAddrV4Result {
    if (ip.family != NET_ADDRESS_IPV4) {
        return IpAddrV4Result { ok: false, value: ipv4_unspecified() };
    }
    return IpAddrV4Result {
        ok: true,
        value: ipv4_addr(ip.octets[0], ip.octets[1], ip.octets[2], ip.octets[3])
    };
}

pub fun ip_addr_as_v6(ip: IpAddr) -> IpAddrV6Result {
    if (ip.family != NET_ADDRESS_IPV6) {
        return IpAddrV6Result { ok: false, value: ipv6_unspecified() };
    }
    var value: Ipv6Addr;
    var i: i32 = 0;
    while (i < 16) {
        value.octets[i] = ip.octets[i];
        i += 1;
    }
    return IpAddrV6Result { ok: true, value: value };
}

pub fun socket_addr_as_v4(addr: SocketAddr) -> SocketAddrV4Result {
    var ip = ip_addr_as_v4(addr.ip);
    if (!ip.ok) {
        return SocketAddrV4Result {
            ok: false,
            value: socket_addr_v4_any(0)
        };
    }
    return SocketAddrV4Result {
        ok: true,
        value: socket_addr_v4(ip.value, addr.port)
    };
}

pub fun socket_addr_as_v6(addr: SocketAddr) -> SocketAddrV6Result {
    var ip = ip_addr_as_v6(addr.ip);
    if (!ip.ok) {
        return SocketAddrV6Result {
            ok: false,
            value: socket_addr_v6_any(0)
        };
    }
    return SocketAddrV6Result {
        ok: true,
        value: socket_addr_v6(ip.value, addr.port, addr.flowinfo, addr.scope_id)
    };
}

pub fun ipv4_parse(text: str) -> Ipv4ParseResult {
    var parts: array<u32, 4>;
    var part: i32 = 0;
    var digits: i32 = 0;
    var current: u32 = 0;
    var i: i32 = 0;

    while (text[i] != 0) {
        var c: u8 = text[i];
        if (c >= 48 && c <= 57) {
            if (digits >= 3) {
                return Ipv4ParseResult { ok: false, value: ipv4_unspecified() };
            }
            current = current * 10 + (c - 48) as u32;
            if (current > 255) {
                return Ipv4ParseResult { ok: false, value: ipv4_unspecified() };
            }
            digits += 1;
        } else if (c == 46) {
            if (digits == 0 || part >= 3) {
                return Ipv4ParseResult { ok: false, value: ipv4_unspecified() };
            }
            parts[part] = current;
            part += 1;
            digits = 0;
            current = 0;
        } else {
            return Ipv4ParseResult { ok: false, value: ipv4_unspecified() };
        }
        i += 1;
    }

    if (digits == 0 || part != 3) {
        return Ipv4ParseResult { ok: false, value: ipv4_unspecified() };
    }
    parts[3] = current;

    return Ipv4ParseResult {
        ok: true,
        value: ipv4_addr(
            parts[0] as u8,
            parts[1] as u8,
            parts[2] as u8,
            parts[3] as u8
        )
    };
}

fun _write_decimal_u32(value: u32, dst: ptr<u8>, start: i64, cap: i64) -> i64 {
    var divisor: u32 = 1;
    while (value / divisor >= 10) {
        divisor = divisor * 10;
    }

    var index: i64 = start;
    var remaining: u32 = value;
    while (divisor > 0) {
        if (index >= cap) {
            return NET_ADDRESS_TEXT_NO_SPACE;
        }
        var digit: u32 = remaining / divisor;
        deref dst[index] = (48 + digit) as u8;
        remaining = remaining % divisor;
        divisor = divisor / 10;
        index += 1;
    }
    return index;
}

fun _ipv6_group(ip: Ipv6Addr, index: i32) -> u16 {
    var octet_index: i32 = index * 2;
    var high: u16 = ip.octets[octet_index] as u16;
    octet_index += 1;
    return (high << 8) | ip.octets[octet_index] as u16;
}

fun _write_hex_u16(value: u16, dst: ptr<u8>, start: i64, cap: i64) -> i64 {
    var divisor: u16 = 4096;
    var started: bool = false;
    var index: i64 = start;

    while (divisor > 0) {
        var digit: u16 = (value / divisor) & 15;
        if (digit != 0 || started || divisor == 1) {
            if (index >= cap) { return NET_ADDRESS_TEXT_NO_SPACE; }
            if (digit < 10) { deref dst[index] = (48 + digit) as u8; }
            else { deref dst[index] = (87 + digit) as u8; }
            index += 1;
            started = true;
        }
        divisor = divisor / 16;
    }
    return index;
}

pub fun ipv4_format(ip: Ipv4Addr, dst: ptr<u8>, cap: i64) -> i64 {
    if (dst == null || cap <= 0) {
        return NET_ADDRESS_TEXT_INVALID;
    }

    var index: i64 = 0;
    var part: i32 = 0;
    while (part < 4) {
        index = _write_decimal_u32(ipv4_octet(ip, part) as u32, dst, index, cap - 1);
        if (index < 0) {
            return index;
        }
        if (part < 3) {
            if (index >= cap - 1) {
                return NET_ADDRESS_TEXT_NO_SPACE;
            }
            deref dst[index] = 46;
            index += 1;
        }
        part += 1;
    }

    deref dst[index] = 0;
    return index;
}

pub fun socket_addr_v4_format(addr: SocketAddrV4, dst: ptr<u8>, cap: i64) -> i64 {
    var index: i64 = ipv4_format(addr.ip, dst, cap);
    if (index < 0) {
        return index;
    }
    if (index >= cap - 1) {
        return NET_ADDRESS_TEXT_NO_SPACE;
    }
    deref dst[index] = 58;
    index += 1;
    var end: i64 = _write_decimal_u32(addr.port as u32, dst, index, cap - 1);
    if (end < 0) {
        return end;
    }
    deref dst[end] = 0;
    return end;
}

pub fun ipv6_format(ip: Ipv6Addr, dst: ptr<u8>, cap: i64) -> i64 {
    if (dst == null || cap <= 0) { return NET_ADDRESS_TEXT_INVALID; }

    var best_start: i32 = -1;
    var best_length: i32 = 0;
    var scan: i32 = 0;
    while (scan < 8) {
        if (_ipv6_group(ip, scan) != 0) {
            scan += 1;
        } else {
            var start: i32 = scan;
            while (scan < 8 && _ipv6_group(ip, scan) == 0) { scan += 1; }
            var length: i32 = scan - start;
            if (length >= 2 && length > best_length) {
                best_start = start;
                best_length = length;
            }
        }
    }

    var index: i64 = 0;
    var group_index: i32 = 0;
    while (group_index < 8) {
        if (group_index == best_start) {
            if (index + 2 > cap - 1) { return NET_ADDRESS_TEXT_NO_SPACE; }
            deref dst[index] = 58;
            var second_colon: i64 = index + 1;
            deref dst[second_colon] = 58;
            index += 2;
            group_index += best_length;
        } else {
            var previous: i64 = index - 1;
            if (index > 0 && dst[previous] != 58) {
                if (index >= cap - 1) { return NET_ADDRESS_TEXT_NO_SPACE; }
                deref dst[index] = 58;
                index += 1;
            }
            index = _write_hex_u16(
                _ipv6_group(ip, group_index), dst, index, cap - 1
            );
            if (index < 0) { return index; }
            group_index += 1;
        }
    }

    deref dst[index] = 0;
    return index;
}

pub fun socket_addr_v6_format(addr: SocketAddrV6, dst: ptr<u8>, cap: i64) -> i64 {
    if (dst == null || cap <= 0) { return NET_ADDRESS_TEXT_INVALID; }
    if (cap < 5) { return NET_ADDRESS_TEXT_NO_SPACE; }

    deref dst[0] = 91;
    var ip_length: i64 = ipv6_format(addr.ip, dst + 1, cap - 1);
    if (ip_length < 0) { return ip_length; }
    var index: i64 = ip_length + 1;

    if (addr.scope_id != 0) {
        if (index >= cap - 1) { return NET_ADDRESS_TEXT_NO_SPACE; }
        deref dst[index] = 37;
        index += 1;
        index = _write_decimal_u32(addr.scope_id, dst, index, cap - 1);
        if (index < 0) { return index; }
    }

    if (index + 2 > cap - 1) { return NET_ADDRESS_TEXT_NO_SPACE; }
    deref dst[index] = 93;
    var colon: i64 = index + 1;
    deref dst[colon] = 58;
    index += 2;
    index = _write_decimal_u32(addr.port as u32, dst, index, cap - 1);
    if (index < 0) { return index; }
    deref dst[index] = 0;
    return index;
}

// Compatibility constructors retain the old names with unsigned fields.
pub struct NetAddrV4 {
    ip: u32;
    port: u16;
}

pub fun net_addr_v4(ip_host_order: u32, port_host_order: u16) -> NetAddrV4 {
    return NetAddrV4 {
        ip: net_hton_u32(ip_host_order),
        port: net_hton_u16(port_host_order)
    };
}

pub fun net_addr_any_v4(port_host_order: u16) -> NetAddrV4 {
    return net_addr_v4(0, port_host_order);
}

pub fun net_addr_loopback_v4(port_host_order: u16) -> NetAddrV4 {
    return net_addr_v4(0x7F000001, port_host_order);
}

pub fun net_addr_to_socket_v4(addr: NetAddrV4) -> SocketAddrV4 {
    return socket_addr_v4(
        ipv4_from_u32(net_ntoh_u32(addr.ip)),
        net_ntoh_u16(addr.port)
    );
}

pub fun socket_addr_to_net_v4(addr: SocketAddrV4) -> NetAddrV4 {
    return net_addr_v4(addr.ip.value, addr.port);
}
