import("std::math::int");

fun abs_f32(x: f32) -> f32 {
    return num_abs<f32>(x, 0.0);
}

fun min_f32(a: f32, b: f32) -> f32 {
    return num_min<f32>(a, b);
}

fun max_f32(a: f32, b: f32) -> f32 {
    return num_max<f32>(a, b);
}

fun clamp_f32(x: f32, lo: f32, hi: f32) -> f32 {
    return num_clamp<f32>(x, lo, hi);
}
