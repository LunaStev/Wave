import("std::math::constants")::{
    MATH_I32_MIN,
    MATH_I32_MAX,
    MATH_I64_MIN,
    MATH_I64_MAX,
};
import("std::math::result")::{
    MATH_ERROR_DIVIDE_BY_ZERO,
    MATH_ERROR_INVALID_ARGUMENT,
    MATH_ERROR_OVERFLOW,
    MathResult,
    math_result_ok,
    math_result_error,
};

// Generic compatibility helpers. Prefer the width-specific APIs below when
// overflow or invalid ranges need to be reported.
pub fun num_abs<T>(x: T, zero: T) -> T {
    if (x < zero) {
        return -x;
    }

    return x;
}

pub fun num_min<T>(a: T, b: T) -> T {
    if (a < b) {
        return a;
    }

    return b;
}

pub fun num_max<T>(a: T, b: T) -> T {
    if (a > b) {
        return a;
    }

    return b;
}

pub fun num_clamp<T>(x: T, lo: T, hi: T) -> T {
    if (x < lo) {
        return lo;
    }

    if (x > hi) {
        return hi;
    }

    return x;
}

// Swaps two pointed-to values and reports false instead of dereferencing null.
pub fun ptr_swap<T>(a: ptr<T>, b: ptr<T>) -> bool {
    if (a == null || b == null) {
        return false;
    }
    var t: T = deref a;

    deref a = deref b;
    deref b = t;
    return true;
}

pub fun abs_i32(x: i32) -> i32 {
    return num_abs<i32>(x, 0);
}

pub fun abs_i64(x: i64) -> i64 {
    return num_abs<i64>(x, 0);
}

pub fun abs_i32_checked(x: i32) -> MathResult<i32> {
    if (x == MATH_I32_MIN) {
        return math_result_error<i32>(0, MATH_ERROR_OVERFLOW);
    }

    return math_result_ok<i32>(abs_i32(x));
}

pub fun abs_i64_checked(x: i64) -> MathResult<i64> {
    if (x == MATH_I64_MIN) {
        return math_result_error<i64>(0, MATH_ERROR_OVERFLOW);
    }

    return math_result_ok<i64>(abs_i64(x));
}

pub fun abs_i32_saturating(x: i32) -> i32 {
    if (x == MATH_I32_MIN) {
        return MATH_I32_MAX;
    }

    return abs_i32(x);
}

pub fun abs_i64_saturating(x: i64) -> i64 {
    if (x == MATH_I64_MIN) {
        return MATH_I64_MAX;
    }

    return abs_i64(x);
}

pub fun min_i32(a: i32, b: i32) -> i32 {
    return num_min<i32>(a, b);
}

pub fun min_i64(a: i64, b: i64) -> i64 {
    return num_min<i64>(a, b);
}

pub fun max_i32(a: i32, b: i32) -> i32 {
    return num_max<i32>(a, b);
}

pub fun max_i64(a: i64, b: i64) -> i64 {
    return num_max<i64>(a, b);
}

pub fun clamp_i32(x: i32, lo: i32, hi: i32) -> i32 {
    return num_clamp<i32>(x, lo, hi);
}

pub fun clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    return num_clamp<i64>(x, lo, hi);
}

pub fun clamp_i32_checked(x: i32, lo: i32, hi: i32) -> MathResult<i32> {
    if (lo > hi) {
        return math_result_error<i32>(0, MATH_ERROR_INVALID_ARGUMENT);
    }

    return math_result_ok<i32>(clamp_i32(x, lo, hi));
}

pub fun clamp_i64_checked(x: i64, lo: i64, hi: i64) -> MathResult<i64> {
    if (lo > hi) {
        return math_result_error<i64>(0, MATH_ERROR_INVALID_ARGUMENT);
    }

    return math_result_ok<i64>(clamp_i64(x, lo, hi));
}

pub fun sign_i32(x: i32) -> i32 {
    if (x < 0) {
        return -1;
    }

    if (x > 0) {
        return 1;
    }

    return 0;
}

pub fun sign_i64(x: i64) -> i32 {
    if (x < 0) {
        return -1;
    }

    if (x > 0) {
        return 1;
    }

    return 0;
}

pub fun is_even_i32(x: i32) -> bool {
    return (x % 2) == 0;
}

pub fun is_odd_i32(x: i32) -> bool {
    return (x % 2) != 0;
}

pub fun is_even_i64(x: i64) -> bool {
    return (x % 2) == 0;
}

pub fun is_odd_i64(x: i64) -> bool {
    return (x % 2) != 0;
}

pub fun div_floor_i32_checked(a: i32, b: i32) -> MathResult<i32> {
    if (b == 0) {
        return math_result_error<i32>(0, MATH_ERROR_DIVIDE_BY_ZERO);
    }

    if (a == MATH_I32_MIN && b == -1) {
        return math_result_error<i32>(0, MATH_ERROR_OVERFLOW);
    }

    var quotient: i32 = a / b;
    var remainder: i32 = a % b;
    if (remainder != 0 && ((remainder < 0 && b > 0) || (remainder > 0 && b < 0))) {
        quotient -= 1;
    }

    return math_result_ok<i32>(quotient);
}

pub fun div_ceil_i32_checked(a: i32, b: i32) -> MathResult<i32> {
    if (b == 0) {
        return math_result_error<i32>(0, MATH_ERROR_DIVIDE_BY_ZERO);
    }

    if (a == MATH_I32_MIN && b == -1) {
        return math_result_error<i32>(0, MATH_ERROR_OVERFLOW);
    }

    var quotient: i32 = a / b;
    var remainder: i32 = a % b;
    if (remainder != 0 && ((remainder > 0 && b > 0) || (remainder < 0 && b < 0))) {
        quotient += 1;
    }

    return math_result_ok<i32>(quotient);
}

pub fun div_floor_i64_checked(a: i64, b: i64) -> MathResult<i64> {
    if (b == 0) {
        return math_result_error<i64>(0, MATH_ERROR_DIVIDE_BY_ZERO);
    }

    if (a == MATH_I64_MIN && b == -1) {
        return math_result_error<i64>(0, MATH_ERROR_OVERFLOW);
    }

    var quotient: i64 = a / b;
    var remainder: i64 = a % b;
    if (remainder != 0 && ((remainder < 0 && b > 0) || (remainder > 0 && b < 0))) {
        quotient -= 1;
    }

    return math_result_ok<i64>(quotient);
}

pub fun div_ceil_i64_checked(a: i64, b: i64) -> MathResult<i64> {
    if (b == 0) {
        return math_result_error<i64>(0, MATH_ERROR_DIVIDE_BY_ZERO);
    }

    if (a == MATH_I64_MIN && b == -1) {
        return math_result_error<i64>(0, MATH_ERROR_OVERFLOW);
    }

    var quotient: i64 = a / b;
    var remainder: i64 = a % b;
    if (remainder != 0 && ((remainder > 0 && b > 0) || (remainder < 0 && b < 0))) {
        quotient += 1;
    }

    return math_result_ok<i64>(quotient);
}

// Compatibility names for the original i32-only API.
pub fun abs(x: i32) -> i32 {
    return abs_i32(x);
}

pub fun min(a: i32, b: i32) -> i32 {
    return min_i32(a, b);
}

pub fun max(a: i32, b: i32) -> i32 {
    return max_i32(a, b);
}

pub fun clamp(x: i32, lo: i32, hi: i32) -> i32 {
    return clamp_i32(x, lo, hi);
}

pub fun sign(x: i32) -> i32 {
    return sign_i32(x);
}

pub fun is_even(x: i32) -> bool {
    return is_even_i32(x);
}

pub fun is_odd(x: i32) -> bool {
    return is_odd_i32(x);
}

pub fun div_ceil_pos(a: i32, b: i32) -> i32 {
    if (b <= 0) {
        return 0;
    }

    if (a <= 0) {
        return 0;
    }

    var result: i32 = a / b;
    if ((a % b) != 0) {
        result += 1;
    }
    return result;
}

pub fun div_floor_pos(a: i32, b: i32) -> i32 {
    if (b <= 0) {
        return 0;
    }

    if (a <= 0) {
        return 0;
    }

    return a / b;
}

pub fun swap_i32(a: ptr<i32>, b: ptr<i32>) {
    ptr_swap<i32>(a, b);
}
