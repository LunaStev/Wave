    if (out_value == null) { return BYTES_ERROR_INVALID; }
    var value: u32 = 0;
    var status: i32 = bytes_read_le_u32(src, offset, &value);
    if (status != BYTES_OK) { return status; }
    deref out_value = value as i32;
    return BYTES_OK;
}

pub fun bytes_read_be_i64(src: Bytes, offset: i64, out_value: ptr<i64>) -> i32 {
    if (out_value == null) { return BYTES_ERROR_INVALID; }
    var value: u64 = 0;
    var status: i32 = bytes_read_be_u64(src, offset, &value);
    if (status != BYTES_OK) { return status; }
    deref out_value = value as i64;
    return BYTES_OK;
}

pub fun bytes_read_le_i64(src: Bytes, offset: i64, out_value: ptr<i64>) -> i32 {
    if (out_value == null) { return BYTES_ERROR_INVALID; }
    var value: u64 = 0;
    var status: i32 = bytes_read_le_u64(src, offset, &value);
