// Copies exactly dst.len bytes. A failed range check leaves dst unchanged.
pub fun bytes_read_exact(src: Bytes, offset: i64, dst: BytesMut) -> i32 {
    if (dst.len < 0 || (dst.len > 0 && dst.data == null)) {
        return BYTES_ERROR_INVALID;
    }
    var status: i32 = _bytes_check_read(src, offset, dst.len);
    if (status != BYTES_OK) { return status; }
    if (dst.len > 0) { mem_move(dst.data, src.data + offset, dst.len); }
    return BYTES_OK;
}
