pub import("std::bytes::types")::{Bytes, BytesMut, ByteReader, ByteWriter};
pub import("std::bytes::errors")::{
    BYTES_OK,
    BYTES_ERROR_INVALID,
    BYTES_ERROR_EOF,
    BYTES_ERROR_NO_SPACE,
    BYTES_ERROR_OVERFLOW,
};
import("std::bytes::read")::{
    bytes_read_u8,
    bytes_read_be_u16,
    bytes_read_le_u16,
    bytes_read_be_u32,
    bytes_read_le_u32,
    bytes_read_be_u64,
    bytes_read_le_u64,
    bytes_read_exact,
};
import("std::bytes::write")::{
    bytes_write_u8,
    bytes_write_be_u16,
    bytes_write_le_u16,
    bytes_write_be_u32,
    bytes_write_le_u32,
    bytes_write_be_u64,
    bytes_write_le_u64,
    bytes_write_exact,
};

pub fun bytes_reader(data: ptr<u8>, len: i64) -> ByteReader {
    return ByteReader { data: data, len: len, position: 0 };
}

pub fun bytes_reader_from(src: Bytes) -> ByteReader {
    return bytes_reader(src.data, src.len);
}

pub fun bytes_writer(data: ptr<u8>, len: i64) -> ByteWriter {
    return ByteWriter { data: data, len: len, position: 0 };
}

pub fun bytes_writer_from(dst: BytesMut) -> ByteWriter {
    return bytes_writer(dst.data, dst.len);
}

fun _bytes_reader_is_valid(reader: ptr<ByteReader>) -> bool {
    if (reader == null) { return false; }
    if (deref reader.len < 0 || deref reader.position < 0) { return false; }
    if (deref reader.position > deref reader.len) { return false; }
    if (deref reader.len > 0 && deref reader.data == null) { return false; }
    return true;
}

fun _bytes_writer_is_valid(writer: ptr<ByteWriter>) -> bool {
    if (writer == null) { return false; }
    if (deref writer.len < 0 || deref writer.position < 0) { return false; }
    if (deref writer.position > deref writer.len) { return false; }
    if (deref writer.len > 0 && deref writer.data == null) { return false; }
    return true;
}

pub fun bytes_reader_position(reader: ByteReader) -> i64 { return reader.position; }
pub fun bytes_writer_position(writer: ByteWriter) -> i64 { return writer.position; }

pub fun bytes_reader_remaining(reader: ByteReader) -> i64 {
    if (reader.len < 0 || reader.position < 0 || reader.position > reader.len) {
        return BYTES_ERROR_INVALID as i64;
    }
    if (reader.len > 0 && reader.data == null) {
        return BYTES_ERROR_INVALID as i64;
    }
    return reader.len - reader.position;
}

pub fun bytes_writer_remaining(writer: ByteWriter) -> i64 {
    if (writer.len < 0 || writer.position < 0 || writer.position > writer.len) {
        return BYTES_ERROR_INVALID as i64;
    }
    if (writer.len > 0 && writer.data == null) {
        return BYTES_ERROR_INVALID as i64;
    }
    return writer.len - writer.position;
}

pub fun bytes_reader_seek(reader: ptr<ByteReader>, position: i64) -> i32 {
    if (!_bytes_reader_is_valid(reader) || position < 0) {
        return BYTES_ERROR_INVALID;
    }
    if (position > deref reader.len) { return BYTES_ERROR_EOF; }
    deref reader.position = position;
    return BYTES_OK;
}

pub fun bytes_writer_seek(writer: ptr<ByteWriter>, position: i64) -> i32 {
    if (!_bytes_writer_is_valid(writer) || position < 0) {
        return BYTES_ERROR_INVALID;
    }
    if (position > deref writer.len) { return BYTES_ERROR_NO_SPACE; }
    deref writer.position = position;
    return BYTES_OK;
}

pub fun bytes_reader_skip(reader: ptr<ByteReader>, count: i64) -> i32 {
    if (!_bytes_reader_is_valid(reader) || count < 0) {
        return BYTES_ERROR_INVALID;
    }
    if (count > deref reader.len - deref reader.position) {
        return BYTES_ERROR_EOF;
    }
    deref reader.position = deref reader.position + count;
    return BYTES_OK;
}

pub fun bytes_writer_skip(writer: ptr<ByteWriter>, count: i64) -> i32 {
    if (!_bytes_writer_is_valid(writer) || count < 0) {
        return BYTES_ERROR_INVALID;
    }
    if (count > deref writer.len - deref writer.position) {
        return BYTES_ERROR_NO_SPACE;
    }
    deref writer.position = deref writer.position + count;
    return BYTES_OK;
}

pub fun bytes_reader_peek_u8(reader: ptr<ByteReader>, out_value: ptr<u8>) -> i32 {
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: deref reader.data, len: deref reader.len };
    return bytes_read_u8(src, deref reader.position, out_value);
}

pub fun bytes_reader_read_u8(reader: ptr<ByteReader>, out_value: ptr<u8>) -> i32 {
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: deref reader.data, len: deref reader.len };
    var status: i32 = bytes_read_u8(src, deref reader.position, out_value);
    if (status != BYTES_OK) { return status; }
    deref reader.position = deref reader.position + 1;
    return BYTES_OK;
}

pub fun bytes_reader_read_be_u16(reader: ptr<ByteReader>, out_value: ptr<u16>) -> i32 {
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: deref reader.data, len: deref reader.len };
    var status: i32 = bytes_read_be_u16(src, deref reader.position, out_value);
    if (status != BYTES_OK) { return status; }
    deref reader.position = deref reader.position + 2;
    return BYTES_OK;
}

