pub fun bytes_reader_read_exact(reader: ptr<ByteReader>, dst: BytesMut) -> i32 {
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: deref reader.data, len: deref reader.len };
    var status: i32 = bytes_read_exact(src, deref reader.position, dst);
    if (status != BYTES_OK) { return status; }
    deref reader.position = deref reader.position + dst.len;
    return BYTES_OK;
}

