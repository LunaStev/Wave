}

pub fun bytes_reader_read_le_u64(reader: ptr<ByteReader>, out_value: ptr<u64>) -> i32 {
    if (!_bytes_reader_is_valid(reader)) { return BYTES_ERROR_INVALID; }
    var src: Bytes = Bytes { data: deref reader.data, len: deref reader.len };
    var status: i32 = bytes_read_le_u64(src, deref reader.position, out_value);
    if (status != BYTES_OK) { return status; }
    deref reader.position = deref reader.position + 8;
    return BYTES_OK;
}

pub fun bytes_reader_read_be_i16(reader: ptr<ByteReader>, out_value: ptr<i16>) -> i32 {
    if (out_value == null) { return BYTES_ERROR_INVALID; }
    var value: u16 = 0;
    var status: i32 = bytes_reader_read_be_u16(reader, &value);
    if (status != BYTES_OK) { return status; }
    deref out_value = value as i16;
    return BYTES_OK;
}

pub fun bytes_reader_read_le_i16(reader: ptr<ByteReader>, out_value: ptr<i16>) -> i32 {
    if (out_value == null) { return BYTES_ERROR_INVALID; }
    var value: u16 = 0;
    var status: i32 = bytes_reader_read_le_u16(reader, &value);
    if (status != BYTES_OK) { return status; }
    deref out_value = value as i16;
    return BYTES_OK;
}

