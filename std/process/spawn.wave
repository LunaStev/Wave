import("std::io::consts")::{
    IO_STDIN_FD,
    IO_STDOUT_FD,
    IO_STDERR_FD,
    IO_ERR_INVALID,
    IO_ERR_EOF,
    IO_ERR_NO_SPACE,
    IO_ERR_INTR,
};
import("std::io::fd")::{
    io_close,
    io_seek,
    io_read,
    io_write,
    io_write_all,
    io_read_exact,
    io_read_at_most,
    io_copy,
    io_pipe,
    io_dup,
    io_dup2,
};
import("std::process::consts")::{
    PROC_ERR_INTR,
    PROC_WAIT_NOHANG,
    PROC_EXIT_EXEC_FAIL,
    PROC_EXIT_DUP_FAIL,
};
import("std::process::core")::{
    proc_exit,
    proc_getpid,
    proc_getppid,
    proc_fork,
    proc_execve,
    proc_waitpid_raw,
    proc_kill,
};

pub struct ProcPipeResult {
    status: i64;
    read_fd: i64;
    write_fd: i64;
}

pub struct ProcSpawnStdoutResult {
    status: i64;
    pid: i64;
    read_fd: i64;
}

pub fun _proc_dup_child_fd(src_fd: i64, dst_fd: i64) -> i64 {
    if (src_fd < 0) {
        return 0;
    }

    if (src_fd == dst_fd) {
        return 0;
    }

    var r: i64 = io_dup2(src_fd, dst_fd);
    if (r < 0) {
        return r;
    }

    io_close(src_fd);
    return 0;
}

pub fun proc_spawn_exec_raw(
    path: str,
    argv: ptr<ptr<i8>>,
    envp: ptr<ptr<i8>>,
    stdin_fd: i64,
    stdout_fd: i64,
    stderr_fd: i64
) -> i64 {
    var pid: i64 = proc_fork();
    if (pid < 0) {
        return pid;
    }

    if (pid == 0) {
        if (_proc_dup_child_fd(stdin_fd, IO_STDIN_FD) < 0) {
            proc_exit(PROC_EXIT_DUP_FAIL);
        }

        if (_proc_dup_child_fd(stdout_fd, IO_STDOUT_FD) < 0) {
            proc_exit(PROC_EXIT_DUP_FAIL);
        }

        if (_proc_dup_child_fd(stderr_fd, IO_STDERR_FD) < 0) {
            proc_exit(PROC_EXIT_DUP_FAIL);
        }

        var er: i64 = proc_execve(path, argv, envp);
        if (er < 0) {
            proc_exit(PROC_EXIT_EXEC_FAIL);
        }

        proc_exit(0);
    }

    return pid;
}

pub fun proc_spawn(path: str, argv: ptr<ptr<i8>>, envp: ptr<ptr<i8>>) -> i64 {
    return proc_spawn_exec_raw(path, argv, envp, -1, -1, -1);
}

pub fun proc_make_pipe() -> ProcPipeResult {
    var fds: array<i32, 2>;
    var r: i64 = io_pipe(&fds[0]);
    if (r < 0) {
        return ProcPipeResult {
            status: r,
            read_fd: -1,
            write_fd: -1
        };
    }

    return ProcPipeResult {
        status: 0,
        read_fd: fds[0] as i64,
        write_fd: fds[1] as i64
    };
}

pub fun proc_spawn_capture_stdout(
    path: str,
    argv: ptr<ptr<i8>>,
    envp: ptr<ptr<i8>>
) -> ProcSpawnStdoutResult {
    var pipe_r: ProcPipeResult = proc_make_pipe();
    if (pipe_r.status < 0) {
        return ProcSpawnStdoutResult {
            status: pipe_r.status,
            pid: -1,
            read_fd: -1
        };
    }

    var pid: i64 = proc_spawn_exec_raw(path, argv, envp, -1, pipe_r.write_fd, -1);
    io_close(pipe_r.write_fd);
    if (pid < 0) {
        io_close(pipe_r.read_fd);
        return ProcSpawnStdoutResult {
            status: pid,
            pid: -1,
            read_fd: -1
        };
    }

    return ProcSpawnStdoutResult {
        status: 0,
        pid: pid,
        read_fd: pipe_r.read_fd
    };
}
