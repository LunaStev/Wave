import("std::io::consts")::{IO_STDERR_FD};
import("std::io::fd")::{io_write_all};
import("std::process::core")::{proc_exit};
import("std::string::len")::{len};

fun _debug_write(text: str) {
    io_write_all(IO_STDERR_FD, text as ptr<u8>, len(text) as i64);
}

fun _debug_write_line(prefix: str, message: str) {
    _debug_write(prefix);
    _debug_write(message);
    _debug_write("\n");
}

// Writes one clearly marked diagnostic message.
// Example: debug_log("connected to cache");
pub fun debug_log(message: str) {
    _debug_write_line("[debug] ", message);
}

// Writes a label and value accepted by Wave's `{}` formatter.
// Example: debug_value<i32>("retry_count", retries);
pub fun debug_value<T>(label: str, value: T) {
    println("[debug] {} = {}", label, value);
}

// Reports an unrecoverable debug failure and terminates with exit code 1.
pub fun debug_fail(message: str) -> ! {
    _debug_write_line("[debug][fatal] ", message);
    proc_exit(1);
}

// Terminates with a readable message when condition is false.
// Example: debug_assert(index < length, "index must be in bounds");
pub fun debug_assert(condition: bool, message: str) {
    if (!condition) {
        _debug_write_line("[debug][assertion failed] ", message);
        proc_exit(1);
    }
}
