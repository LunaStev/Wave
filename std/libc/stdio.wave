// Direct C stdio declarations for explicit interoperability. Portable Wave
// I/O is implemented by std::io rather than this module.

extern(c) {
    fun puts(s: ptr<i8>) -> i32;
    fun getchar() -> i32;
    fun putchar(c: i32) -> i32;
}
