pub struct TimeSpec {
    sec: i64;
    nsec: i64;
}

pub const CLOCK_REALTIME: i32 = 0;
pub const CLOCK_MONOTONIC: i32 = 1;

extern(c) {
    fun nanosleep(ptr<TimeSpec>, ptr<TimeSpec>) -> i32;
    fun clock_gettime(i32, ptr<TimeSpec>) -> i32;
    fun c_time(ptr<i64>) -> i64 "time";
    fun sleep(i32) -> i32;
    fun usleep(i32) -> i32;
}
