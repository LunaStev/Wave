pub const AF_LOCAL: i32 = 1;
pub const NATIVE_LOCAL_PATH_CAPACITY: i32 = 104;

pub struct NativeLocalAddr {
    len: u8;
    family: u8;
    path: array<u8, 104>;
}

pub fun native_local_addr(path: str, output: ptr<NativeLocalAddr>) -> i32 {
    if (output == null) { return -22; }
    var value: NativeLocalAddr;
    value.family = AF_LOCAL as u8;
    var i: i32 = 0;
    while (path[i] != 0) {
        if (i >= NATIVE_LOCAL_PATH_CAPACITY - 1) { return -36; }
        value.path[i] = path[i];
        i += 1;
    }
    value.path[i] = 0;
    value.len = (i + 3) as u8;
    deref output = value;
    return i + 3;
}

pub fun native_local_abstract(name: str, output: ptr<NativeLocalAddr>) -> i32 {
    return -95;
}
