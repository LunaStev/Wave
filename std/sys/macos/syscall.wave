// macOS syscall entry selected by target architecture.

#[target(arch="x86_64")]
pub import("std::sys::macos::amd64::syscall")::{
    syscall0, syscall1, syscall2, syscall3, syscall4, syscall5, syscall6,
};

#[target(arch="aarch64")]
pub import("std::sys::macos::arm64::syscall")::{
    syscall0, syscall1, syscall2, syscall3, syscall4, syscall5, syscall6,
};
