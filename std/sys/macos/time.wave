// macOS clock provider selected by target architecture.

#[target(arch="x86_64")]
pub import("std::sys::macos::amd64::time")::{TimeSpec, nanosleep, clock_gettime};

#[target(arch="aarch64")]
pub import("std::sys::macos::arm64::time")::{TimeSpec, nanosleep, clock_gettime};
