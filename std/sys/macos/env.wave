// macOS environment provider selected by target architecture.

#[target(arch="x86_64")]
pub import("std::sys::macos::amd64::env")::{ERR_NOT_IMPLEMENTED, env_read};

#[target(arch="aarch64")]
pub import("std::sys::macos::arm64::env")::{ERR_NOT_IMPLEMENTED, env_read};
