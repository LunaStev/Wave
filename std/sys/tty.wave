// Selects the target terminal ABI. These operations expose native terminal
// state; higher-level terminal code is responsible for restoring that state.

#[target(os="linux")]
pub import("std::sys::linux::tty")::{
    TTY_SYS_IOCTL,
    TTY_SYS_FCNTL,
    TTY_TCGETS,
    TTY_TCSETS,
    TTY_TCSETSW,
    TTY_TCSETSF,
    TTY_TCSANOW,
    TTY_TCSADRAIN,
    TTY_TCSAFLUSH,
    TTY_F_GETFL,
    TTY_F_SETFL,
    TTY_O_NONBLOCK,
    TTY_ICANON,
    TTY_ECHO,
    TTY_VTIME_IDX,
    TTY_VMIN_IDX,
    Termios,
    TtyRawState,
    tty_getattr,
    tty_setattr,
    tty_getfl,
    tty_setfl,
    tty_enable_raw_nonblock,
    tty_restore,
};

