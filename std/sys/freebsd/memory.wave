// FreeBSD virtual-memory provider selected by target architecture.

#[target(arch="x86_64")]
pub import("std::sys::freebsd::amd64::memory")::{
    PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS,
    mmap, munmap, brk, sys_alloc, sys_free, sys_page_size,
};
