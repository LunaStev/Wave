// =======================================================
// FreeBSD time syscalls
// =======================================================

import("std::sys::freebsd::amd64::syscall")::{
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6,
};

pub struct TimeSpec {
    sec: i64;
    nsec: i64;
}

pub fun nanosleep(req: ptr<TimeSpec>, rem: ptr<TimeSpec>) -> i64 {
    return syscall2(240, req as i64, rem as i64);
}

pub fun clock_gettime(clock_id: i32, tp: ptr<TimeSpec>) -> i64 {
    // Wave clock ids are portable: FreeBSD uses 4 for CLOCK_MONOTONIC.
    if (clock_id == 0) {
        return syscall2(232, 0, tp as i64);
    }
    if (clock_id == 1) {
        return syscall2(232, 4, tp as i64);
    }
    return -22;
}
