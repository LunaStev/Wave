// FreeBSD 14 LP64 syscall ABI; failures are normalized to negative errno.
// svc carries an immediate operand; x0 and x1 are both kernel return values.

pub fun syscall0(id: i64) -> i64 {
    var secondary: i64;
    var result: i64;
    asm {
        "svc %3"
        "cneg x0, x0, cs"
        in("x8") id
        in("i") 0

        out("x0") result
        out("x1") secondary
        clobber("memory")
    }
    return result;
}

pub fun syscall1(id: i64, a1: i64) -> i64 {
    var secondary: i64;
    var result: i64;
    asm {
        "svc %3"
        "cneg x0, x0, cs"
        in("x8") id
        in("i") 0
        in("x0") a1
        out("x0") result
        out("x1") secondary
        clobber("memory")
    }
    return result;
}

