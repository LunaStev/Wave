// FreeBSD 14 LP64 syscall ABI; failures are normalized to negative errno.

pub fun syscall0(id: i64) -> i64 {
    var secondary: i64;
    var error: i64;
    var result: i64;
    asm {
        "ecall"
        "beqz t0, 1f"
        "neg a0, a0"
        "1:"
        in("t0") id

        out("a0") result
        out("t0") error
        out("a1") secondary
        clobber("memory")
    }
    return result;
}

pub fun syscall1(id: i64, a1: i64) -> i64 {
    var secondary: i64;
    var error: i64;
    var result: i64;
    asm {
        "ecall"
        "beqz t0, 1f"
        "neg a0, a0"
        "1:"
        in("t0") id
        in("a0") a1
        out("a0") result
        out("t0") error
        out("a1") secondary
        clobber("memory")
    }
    return result;
}

