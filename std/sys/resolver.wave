    NativeAddrInfo, resolver_open, resolver_close, resolver_family,
    resolver_address, resolver_address_length, resolver_next,
};
#[target(os="windows")]
pub import("std::sys::windows::resolver")::{
    NativeAddrInfo, resolver_open, resolver_close, resolver_family,
    resolver_address, resolver_address_length, resolver_next,
};
