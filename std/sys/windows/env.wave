// Preserve every entry (including =C: drive entries) and both final NULs.
import("std::sys::windows::fs_errors")::{windows_fs_error};
extern(system, "GetEnvironmentStringsW") fun win_get_environment_strings() -> ptr<u16>;
extern(system, "FreeEnvironmentStringsW") fun win_free_environment_strings(block: ptr<u16>) -> i32;
extern(system, "GetLastError") fun env_last_error() -> u32;
extern(system, "WideCharToMultiByte") fun env_to_utf8(
    code_page: u32, flags: u32, source: ptr<u16>, units: i32,
    destination: ptr<u8>, capacity: i32, default_char: ptr<u8>, used_default: ptr<i32>
) -> i32;

fun release_environment(block: ptr<u16>, status: i64) -> i64 {
    if (win_free_environment_strings(block) == 0 && status >= 0) {
        return windows_fs_error(env_last_error());
    }
    return status;
}

pub fun env_read(buf: ptr<u8>, cap: i64) -> i64 {
    if (buf == null || cap <= 0) { return -22; }
    var block: ptr<u16> = win_get_environment_strings();
    if (block == null) { return windows_fs_error(env_last_error()); }

    var units: i64 = 0;
    while (units < 2147483646) {
        if (block[units] == 0 && block[units + 1] == 0) { break; }
        units += 1;
    }
    if (units >= 2147483646) { return release_environment(block, -75); }
    units += 2;
    // A positive explicit length converts embedded NULs too. Query the byte
    // count before writing, so insufficient capacity leaves the caller intact.
    var needed: i32 = env_to_utf8(65001, 128, block, units as i32, null, 0, null, null);
    if (needed == 0) { return release_environment(block, windows_fs_error(env_last_error())); }
    if (needed as i64 > cap) { return release_environment(block, -28); }
    var written: i32 = env_to_utf8(65001, 128, block, units as i32, buf, needed, null, null);
    if (written == 0) { return release_environment(block, windows_fs_error(env_last_error())); }
    return release_environment(block, written as i64);
}
