// Translate Win32 failures to the portable negative errno domain.
// Unknown errors remain failures (EIO); they are never raw Win32 numbers.
pub fun windows_fs_error(code: u32) -> i64 {
    if (code == 2 || code == 3) {
        return -2;
    }
    if (code == 5) {
        return -13;
    }
    if (code == 6) {
        return -9;
    }
    if (code == 8 || code == 14) {
        return -12;
    }
    if (code == 17) {
        return -18;
    }
    if (code == 19) {
        return -30;
    }
    if (code == 32) {
        return -16;
    }
    if (code == 33) {
        return -11;
    }
    if (code == 50 || code == 1) {
        return -95;
    }
    if (code == 80 || code == 183) {
        return -17;
    }
    if (code == 87 || code == 123) {
        return -22;
    }
    if (code == 109) {
        return -32;
    }
    if (code == 112) {
        return -28;
    }
    if (code == 122) {
        return -34;
    }
    if (code == 145) {
        return -39;
    }
    if (code == 206) {
        return -36;
    }
    if (code == 267) {
        return -20;
    }
    if (code == 995) {
        return -4;
    }
    if (code == 1113) {
        return -84;
    }
    return -5;
}
