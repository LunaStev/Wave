// A positive result always covers the whole source through EOF. -28 means
// the caller must retry with more space; partial entries are never success.
pub fun env_read(buf: ptr<u8>, cap: i64) -> i64 {
    if (buf == null || cap <= 0) { return -22; }
    var fd: i64 = open("/proc/self/environ", 0, 0);
    if (fd < 0) { return fd; }
    var total: i64 = 0;
    while (total < cap) {
        var count: i64 = read(fd, &buf[total], cap - total);
        if (count == -4) { continue; }
        if (count < 0) { close(fd); return count; }
        if (count == 0) { close(fd); return total; }
        total += count;
    }
    // Distinguish an exact fit from a truncated source, including when the
    // last available byte happens to be a complete entry's NUL terminator.
    var extra: u8 = 0;
    var count: i64 = read(fd, &extra, 1);
    while (count == -4) { count = read(fd, &extra, 1); }
    close(fd);
    if (count < 0) { return count; }
    if (count == 0) { return total; }
    return -28;
}
