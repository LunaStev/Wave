pub fun syscall6(
    id: i64,
    a1: i64,
    a2: i64,
    a3: i64,
    a4: i64,
    a5: i64,
    a6: i64
) -> i64 {
    var ret: i64;
    asm {
        "syscall 0"
        in("a7") id
        in("a0") a1
        in("a1") a2
        in("a2") a3
        in("a3") a4
        in("a4") a5
        in("a5") a6
        out("a0") ret
    }
    return ret;
}
