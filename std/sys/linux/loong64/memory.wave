// LoongArch64 uses Linux's generic 64-bit virtual-memory syscall ABI.
pub import("std::sys::linux::riscv64::memory")::{
    PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS,
    mmap, munmap, brk, sys_alloc, sys_free, sys_page_size,
};
