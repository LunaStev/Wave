import("std::sys::linux::fs");

fun env_read(buf: ptr<u8>, cap: i64) -> i64 {
    if (cap <= 0) {
        return -22;
    }

    let mut fd: i64 = open("/proc/self/environ", 0, 0);
    if (fd < 0) {
        return fd;
    }

    let mut n: i64 = read(fd, buf, cap);
    close(fd);
    return n;
}
