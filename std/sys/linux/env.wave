import("std::sys::linux::fs")::{
    FS_O_RDONLY,
    FS_O_WRONLY,
    FS_O_RDWR,
    FS_O_CREAT,
    FS_O_EXCL,
    FS_O_TRUNC,
    FS_O_APPEND,
    FS_O_NONBLOCK,
    FS_F_OK,
    FS_X_OK,
    FS_W_OK,
    FS_R_OK,
    FS_SEEK_SET,
    FS_SEEK_CUR,
    FS_SEEK_END,
    FS_F_GETFL,
    FS_F_SETFL,
    open,
    close,
    dup,
    dup2,
    pipe,
    fsync,
    fcntl,
    read,
    write,
    getcwd,
    chdir,
    access,
    lseek,
    unlink,
    mkdir,
    rmdir,
    Stat,
    stat,
    fstat,
};

pub fun env_read(buf: ptr<u8>, cap: i64) -> i64 {
    if (cap <= 0) {
        return -22;
    }

    var fd: i64 = open("/proc/self/environ", 0, 0);
    if (fd < 0) {
        return fd;
    }

    var n: i64 = read(fd, buf, cap);
    close(fd);
    return n;
}
