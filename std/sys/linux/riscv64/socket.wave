// Linux asm-generic 64-bit socket syscalls used by AArch64, RV64, and LoongArch64.

import("std::sys::linux::syscall")::{
    syscall0,
    syscall1,
    syscall2,
    syscall3,
    syscall4,
    syscall5,
    syscall6,
};
import("std::sys::linux::fs")::{close};


// -----------------------
// constants (minimal)
// -----------------------

// address families
pub const AF_INET: i32 = 2;
pub const AF_INET6: i32 = 10;

// socket types
pub const SOCK_STREAM: i32 = 1;
pub const SOCK_DGRAM: i32 = 2;

// protocol
pub const IPPROTO_IP: i32 = 0;
pub const IPPROTO_IPV6: i32 = 41;
pub const IPPROTO_TCP: i32 = 6;
pub const IPPROTO_UDP: i32 = 17;

// shutdown how
pub const SHUT_RD: i32 = 0;
pub const SHUT_WR: i32 = 1;
pub const SHUT_RDWR: i32 = 2;

// socket options
pub const SOL_SOCKET: i32 = 1;
pub const SO_REUSEADDR: i32 = 2;
pub const SO_REUSEPORT: i32 = 15;
pub const SO_ERROR: i32 = 4;
pub const SO_RCVBUF: i32 = 8;
pub const SO_SNDBUF: i32 = 7;
pub const SO_BROADCAST: i32 = 6;
pub const SO_KEEPALIVE: i32 = 9;
pub const TCP_NODELAY: i32 = 1;
pub const IP_TTL: i32 = 2;
pub const IP_MULTICAST_IF: i32 = 32;
pub const IP_MULTICAST_TTL: i32 = 33;
pub const IP_MULTICAST_LOOP: i32 = 34;
pub const IP_ADD_MEMBERSHIP: i32 = 35;
pub const IP_DROP_MEMBERSHIP: i32 = 36;
pub const IPV6_MULTICAST_IF: i32 = 17;
pub const IPV6_MULTICAST_HOPS: i32 = 18;
pub const IPV6_MULTICAST_LOOP: i32 = 19;
pub const IPV6_JOIN_GROUP: i32 = 20;
pub const IPV6_LEAVE_GROUP: i32 = 21;
pub const MSG_NOSIGNAL: i32 = 0x4000;

// poll events
pub const POLLIN: i16 = 0x001;
pub const POLLOUT: i16 = 0x004;
pub const POLLERR: i16 = 0x008;
pub const POLLHUP: i16 = 0x010;
pub const POLLNVAL: i16 = 0x020;

pub struct PollFd {
    fd: i32;
    events: i16;
    revents: i16;
}

struct PollTimeSpec {
    sec: i64;
    nsec: i64;
}


// -----------------------
// basic socket syscalls
// -----------------------

pub fun socket(domain: i32, ty: i32, protocol: i32) -> i64 {
    return syscall3(198, domain as i64, ty as i64, protocol as i64);
}

pub fun bind(fd: i64, addr: ptr<i8>, len: i32) -> i64 {
    return syscall3(200, fd, addr as i64, len as i64);
}

pub fun listen(fd: i64, backlog: i32) -> i64 {
    return syscall2(201, fd, backlog as i64);
}

pub fun accept(fd: i64, addr: ptr<i8>, len: ptr<i32>) -> i64 {
    return syscall3(202, fd, addr as i64, len as i64);
}

pub fun connect(fd: i64, addr: ptr<i8>, len: i32) -> i64 {
    return syscall3(203, fd, addr as i64, len as i64);
}

pub fun getsockname(fd: i64, addr: ptr<i8>, len: ptr<i32>) -> i64 {
    return syscall3(204, fd, addr as i64, len as i64);
}

pub fun getpeername(fd: i64, addr: ptr<i8>, len: ptr<i32>) -> i64 {
    return syscall3(205, fd, addr as i64, len as i64);
}

pub fun shutdown(fd: i64, how: i32) -> i64 {
    return syscall2(210, fd, how as i64);
}

pub fun close_socket(fd: i64) -> i64 { return close(fd); }

pub fun setsockopt(
    fd: i64,
    level: i32,
    optname: i32,
    optval: ptr<i8>,
    optlen: i32
) -> i64 {
    return syscall5(
        208,
        fd,
        level as i64,
        optname as i64,
        optval as i64,
        optlen as i64
    );
}

pub fun getsockopt(
    fd: i64,
    level: i32,
    optname: i32,
    optval: ptr<i8>,
    optlen: ptr<i32>
) -> i64 {
    return syscall5(
        209,
        fd,
        level as i64,
        optname as i64,
        optval as i64,
        optlen as i64
    );
}

pub fun poll(fds: ptr<PollFd>, nfds: i64, timeout_ms: i32) -> i64 {
    if (timeout_ms < 0) {
        return syscall5(73, fds as i64, nfds, 0, 0, 0);
    }

    var timeout: PollTimeSpec;
    timeout.sec = (timeout_ms / 1000) as i64;
    timeout.nsec = ((timeout_ms % 1000) * 1000000) as i64;
    return syscall5(73, fds as i64, nfds, &timeout as i64, 0, 0);
}


// -----------------------
// send / recv
// -----------------------

pub fun send(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> i64 {
    return sendto(fd, buf, len, flags, null, 0);
}

pub fun recv(fd: i64, buf: ptr<u8>, len: i64, flags: i32) -> i64 {
    return recvfrom(fd, buf, len, flags, null, null);
}

pub fun sendto(
    fd: i64,
    buf: ptr<u8>,
    len: i64,
    flags: i32,
    addr: ptr<i8>,
    addrlen: i32
) -> i64 {
    return syscall6(
        206,
        fd,
        buf as i64,
        len,
        flags as i64,
        addr as i64,
        addrlen as i64
    );
}

pub fun recvfrom(
    fd: i64,
    buf: ptr<u8>,
    len: i64,
    flags: i32,
    addr: ptr<i8>,
    addrlen: ptr<i32>
) -> i64 {
    return syscall6(
        207,
        fd,
        buf as i64,
        len,
        flags as i64,
        addr as i64,
        addrlen as i64
    );
}
