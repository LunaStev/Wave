// Selects the target filesystem ABI. These raw operations return nonnegative
// results on success and negative -errno values on failure.

#[target(os="linux")]
pub import("std::sys::linux::fs")::{
    FS_O_RDONLY,
    FS_O_WRONLY,
    FS_O_RDWR,
    FS_O_CREAT,
    FS_O_EXCL,
    FS_O_TRUNC,
    FS_O_APPEND,
    FS_O_NONBLOCK,
    FS_F_OK,
    FS_X_OK,
    FS_W_OK,
    FS_R_OK,
    FS_SEEK_SET,
    FS_SEEK_CUR,
    FS_SEEK_END,
    FS_F_GETFL,
    FS_F_SETFL,
    open,
    close,
    dup,
    dup2,
    pipe,
    fsync,
    fcntl,
    read,
    write,
    getcwd,
    chdir,
    access,
    lseek,
    unlink,
    mkdir,
    rmdir,
    rename_path,
    Stat,
    stat,
    fstat,
};

