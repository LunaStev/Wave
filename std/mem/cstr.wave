pub fun mem_len_cstr(s: str) -> i64 {
    var i: i64 = 0;

    while (s[i] != 0) {
        i += 1;
    }

    return i;
}

pub fun mem_copy_cstr(dst: ptr<u8>, s: str) -> i64 {
    var i: i64 = 0;

    while (s[i] != 0) {
        deref dst[i] = s[i];
        i += 1;
    }

    deref dst[i] = 0;
    return i;
}

pub fun mem_copy_cstr_n(dst: ptr<u8>, dst_cap: i64, s: str) -> i64 {
    if (dst_cap <= 0) {
        return -1;
    }

    var i: i64 = 0;
    var max_copy: i64 = dst_cap - 1;

    while (s[i] != 0 && i < max_copy) {
        deref dst[i] = s[i];
        i += 1;
    }

    deref dst[i] = 0;
    return i;
}

pub fun mem_eq_cstr(a: str, b: str) -> bool {
    var i: i64 = 0;
    while (true) {
        if (a[i] != b[i]) {
            return false;
        }
        if (a[i] == 0) {
            return true;
        }
        i += 1;
    }

    return true;
}

pub fun mem_starts_with_cstr(s: str, prefix: str) -> bool {
    var i: i64 = 0;
    while (prefix[i] != 0) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

pub fun mem_find_cstr_char(s: str, c: u8) -> i64 {
    var i: i64 = 0;
    while (s[i] != 0) {
        if (s[i] == c) {
            return i;
        }
        i += 1;
    }
    return -1;
}
