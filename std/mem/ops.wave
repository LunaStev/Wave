import("std::mem::consts")::{
    MEM_ERR_INVALID,
    MEM_ERR_NO_SPACE,
    MEM_ERR_OVERFLOW,
    MEM_MAX_SIZE,
};

// Adds two non-negative byte counts without signed overflow.
// Example: var total: i64 = 0; mem_size_add_checked(8, 16, &total);
pub fun mem_size_add_checked(a: i64, b: i64, out_value: ptr<i64>) -> i64 {
    if (out_value == null || a < 0 || b < 0) {
        return MEM_ERR_INVALID;
    }

    if (a > MEM_MAX_SIZE - b) {
        return MEM_ERR_OVERFLOW;
    }

    deref out_value = a + b;
    return 0;
}

// Multiplies two non-negative byte counts without signed overflow.
pub fun mem_size_mul_checked(a: i64, b: i64, out_value: ptr<i64>) -> i64 {
    if (out_value == null || a < 0 || b < 0) {
        return MEM_ERR_INVALID;
    }

    if (a != 0 && b > MEM_MAX_SIZE / a) {
        return MEM_ERR_OVERFLOW;
    }

    deref out_value = a * b;
    return 0;
}

// Raw byte operations treat a zero length as a no-op. Non-zero operations
// require non-null pointers; checked callers should use the *_checked forms.
pub fun mem_set(dst: ptr<u8>, value: u8, size: i64) {
    if (dst == null || size <= 0) {
        return;
    }

    var i: i64 = 0;
    while (i < size) {
        deref dst[i] = value;
        i += 1;
    }
}

pub fun mem_zero(dst: ptr<u8>, size: i64) {
    mem_set(dst, 0, size);
}

pub fun mem_copy(dst: ptr<u8>, src: ptr<u8>, size: i64) {
    if (dst == null || src == null || size <= 0) {
        return;
    }

    var i: i64 = 0;
    while (i < size) {
        deref dst[i] = src[i];
        i += 1;
    }
}

pub fun mem_move(dst: ptr<u8>, src: ptr<u8>, size: i64) {
    if (dst == null || src == null || size <= 0) {
        return;
    }

    if (dst == src) {
        return;
    }

    // Compare the raw addresses as unsigned values. A valid address with its
    // high bit set must not be mistaken for a negative signed integer.
    if ((dst as u64) < (src as u64)) {
        var i: i64 = 0;
        while (i < size) {
            deref dst[i] = src[i];
            i += 1;
        }
        return;
    }

    var i: i64 = size;
    while (i > 0) {
        i -= 1;
        deref dst[i] = src[i];
    }
}

pub fun mem_cmp(a: ptr<u8>, b: ptr<u8>, size: i64) -> i32 {
    if (size <= 0 || a == b) {
        return 0;
    }

    if (a == null) {
        return -1;
    }

    if (b == null) {
        return 1;
    }

    var i: i64 = 0;

    while (i < size) {
        var av: u8 = a[i];
        var bv: u8 = b[i];

        if (av < bv) {
            return -1;
        }

        if (av > bv) {
            return 1;
        }

        i += 1;
    }

    return 0;
}

pub fun mem_eq(a: ptr<u8>, b: ptr<u8>, size: i64) -> bool {
    if (mem_cmp(a, b, size) == 0) {
        return true;
    }

    return false;
}

pub fun mem_find_byte(src: ptr<u8>, size: i64, value: u8) -> i64 {
    if (src == null || size <= 0) {
        return -1;
    }

    var i: i64 = 0;
    while (i < size) {
        if (src[i] == value) {
            return i;
        }
        i += 1;
    }
    return -1;
}

pub fun mem_swap<T>(a: ptr<T>, b: ptr<T>) {
    if (a == null || b == null || a == b) {
        return;
    }

    var tmp: T = deref a;
    deref a = deref b;
    deref b = tmp;
}

pub fun mem_copy_items<T>(dst: ptr<T>, src: ptr<T>, count: i64, elem_size: i64) {
    if (count <= 0 || elem_size <= 0) {
        return;
    }

    var byte_len: i64 = 0;
    if (mem_size_mul_checked(count, elem_size, &byte_len) < 0) {
        return;
    }

    mem_copy(dst as ptr<u8>, src as ptr<u8>, byte_len);
}

pub fun mem_set_items<T>(dst: ptr<T>, value: T, count: i64, elem_size: i64) {
    if (count <= 0 || elem_size <= 0) {
        return;
    }

    var byte_len: i64 = 0;
    if (mem_size_mul_checked(count, elem_size, &byte_len) < 0) {
        return;
    }

    var i: i64 = 0;
    while (i < count) {
        deref dst[i] = value;
        i += 1;
    }
}

pub fun mem_move_items<T>(dst: ptr<T>, src: ptr<T>, count: i64, elem_size: i64) {
    if (count <= 0 || elem_size <= 0) {
        return;
    }

    var byte_len: i64 = 0;
    if (mem_size_mul_checked(count, elem_size, &byte_len) < 0) {
        return;
    }

    mem_move(dst as ptr<u8>, src as ptr<u8>, byte_len);
}

pub fun mem_zero_items<T>(dst: ptr<T>, count: i64, elem_size: i64) {
    if (count <= 0 || elem_size <= 0) {
        return;
    }

    var byte_len: i64 = 0;
    if (mem_size_mul_checked(count, elem_size, &byte_len) < 0) {
        return;
    }

    mem_zero(dst as ptr<u8>, byte_len);
}

pub fun mem_copy_checked(dst: ptr<u8>, dst_cap: i64, src: ptr<u8>, src_len: i64) -> i64 {
    if (dst_cap < 0 || src_len < 0) {
        return MEM_ERR_INVALID;
    }

    if (src_len > dst_cap) {
        return MEM_ERR_NO_SPACE;
    }

    if (src_len == 0) {
        return 0;
    }

    if (dst == null || src == null) {
        return MEM_ERR_INVALID;
    }

    mem_move(dst, src, src_len);
    return src_len;
}

pub fun mem_move_checked(dst: ptr<u8>, dst_cap: i64, src: ptr<u8>, src_len: i64) -> i64 {
    if (dst_cap < 0 || src_len < 0) {
        return MEM_ERR_INVALID;
    }

    if (src_len > dst_cap) {
        return MEM_ERR_NO_SPACE;
    }

    if (src_len == 0) {
        return 0;
    }

    if (dst == null || src == null) {
        return MEM_ERR_INVALID;
    }

    mem_move(dst, src, src_len);
    return src_len;
}

pub fun mem_set_checked(dst: ptr<u8>, dst_cap: i64, value: u8, len: i64) -> i64 {
    if (dst_cap < 0 || len < 0) {
        return MEM_ERR_INVALID;
    }

    if (len > dst_cap) {
        return MEM_ERR_NO_SPACE;
    }

    if (len == 0) {
        return 0;
    }

    if (dst == null) {
        return MEM_ERR_INVALID;
    }

    mem_set(dst, value, len);
    return len;
}

pub fun mem_zero_checked(dst: ptr<u8>, dst_cap: i64, len: i64) -> i64 {
    return mem_set_checked(dst, dst_cap, 0, len);
}

// Compares two byte regions and writes -1, 0, or 1 to out_order.
pub fun mem_cmp_checked(
    a: ptr<u8>,
    a_len: i64,
    b: ptr<u8>,
    b_len: i64,
    out_order: ptr<i32>
) -> i64 {
    if (out_order == null || a_len < 0 || b_len < 0) {
        return MEM_ERR_INVALID;
    }

    if ((a_len > 0 && a == null) || (b_len > 0 && b == null)) {
        return MEM_ERR_INVALID;
    }

    var shared: i64 = a_len;
    if (b_len < shared) {
        shared = b_len;
    }

    var order: i32 = mem_cmp(a, b, shared);
    if (order == 0) {
        if (a_len < b_len) {
            order = -1;
        } else if (a_len > b_len) {
            order = 1;
        }
    }

    deref out_order = order;
    return 0;
}
