pub import("std::sys::time")::{
    TimeSpec,
    nanosleep,
    clock_gettime,
};
import("std::time::consts")::{TIME_CLOCK_MONOTONIC, TIME_CLOCK_REALTIME};
import("std::time::duration")::{
    Duration, DurationValueResult,
    time_duration_new, time_duration_to_ns,
};

pub fun time_now_realtime(tp: ptr<TimeSpec>) -> i64 {
    return clock_gettime(TIME_CLOCK_REALTIME, tp);
}

pub fun time_now_monotonic(tp: ptr<TimeSpec>) -> i64 {
    return clock_gettime(TIME_CLOCK_MONOTONIC, tp);
}

pub fun time_now_realtime_duration(output: ptr<Duration>) -> i64 {
    if (output == null) { return -22; }
    var timestamp: TimeSpec;
    var result: i64 = time_now_realtime(&timestamp);
    if (result < 0) { return result; }
    deref output = time_duration_new(timestamp.sec, timestamp.nsec);
    return 0;
}

pub fun time_now_monotonic_duration(output: ptr<Duration>) -> i64 {
    if (output == null) { return -22; }
    var timestamp: TimeSpec;
    var result: i64 = time_now_monotonic(&timestamp);
    if (result < 0) { return result; }
    deref output = time_duration_new(timestamp.sec, timestamp.nsec);
    return 0;
}

pub fun time_now_realtime_ns() -> i64 {
    var ts: TimeSpec;
    var r: i64 = time_now_realtime(&ts);

    if (r < 0) {
        return r;
    }

    var converted: DurationValueResult = time_duration_to_ns(
        time_duration_new(ts.sec, ts.nsec)
    );
    if (!converted.ok) { return -1; }
    return converted.value;
}

pub fun time_now_monotonic_ns() -> i64 {
    var ts: TimeSpec;
    var r: i64 = time_now_monotonic(&ts);

    if (r < 0) {
        return r;
    }

    var converted: DurationValueResult = time_duration_to_ns(
        time_duration_new(ts.sec, ts.nsec)
    );
    if (!converted.ok) { return -1; }
    return converted.value;
}
