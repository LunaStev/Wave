import("std::sys::time")::{
    TimeSpec,
    nanosleep,
    clock_gettime,
};

pub fun time_sleep_ns(ns: i64) -> i64 {
    if (ns <= 0) {
        return 0;
    }

    var req: TimeSpec = TimeSpec {
        sec: ns / 1000000000,
        nsec: ns % 1000000000
    };

    var rem: TimeSpec;

    return nanosleep(&req, &rem);
}

pub fun time_sleep_us(us: i64) -> i64 {
    if (us <= 0) {
        return 0;
    }

    return time_sleep_ns(us * 1000);
}

pub fun time_sleep_ms(ms: i64) -> i64 {
    if (ms <= 0) {
        return 0;
    }

    return time_sleep_ns(ms * 1000000);
}
