import("std::io::consts")::{
    IO_STDIN_FD,
    IO_STDOUT_FD,
    IO_STDERR_FD,
    IO_ERR_INVALID,
    IO_ERR_EOF,
    IO_ERR_NO_SPACE,
    IO_ERR_INTR,
};
import("std::io::fd")::{
    io_close,
    io_seek,
    io_read,
    io_write,
    io_write_all,
    io_read_exact,
    io_read_at_most,
    io_copy,
    io_pipe,
    io_dup,
    io_dup2,
};
import("std::sys::fs")::{
    FS_O_RDONLY,
    FS_O_WRONLY,
    FS_O_RDWR,
    FS_O_CREAT,
    FS_O_EXCL,
    FS_O_TRUNC,
    FS_O_APPEND,
    FS_O_NONBLOCK,
    FS_F_OK,
    FS_X_OK,
    FS_W_OK,
    FS_R_OK,
    FS_SEEK_SET,
    FS_SEEK_CUR,
    FS_SEEK_END,
    FS_F_GETFL,
    FS_F_SETFL,
    open,
    close,
    dup,
    dup2,
    pipe,
    fsync,
    fcntl,
    read,
    write,
    getcwd,
    chdir,
    access,
    lseek,
    unlink,
    mkdir,
    rmdir,
    Stat,
    stat,
    fstat,
};

pub fun fs_exists(path: str) -> bool {
    if (access(path, FS_F_OK) == 0) {
        return true;
    }

    return false;
}

pub fun fs_open(path: str, flags: i32, mode: i32) -> i64 {
    return open(path, flags, mode);
}

pub fun fs_open_read(path: str) -> i64 {
    return fs_open(path, FS_O_RDONLY, 0);
}

pub fun fs_open_write(path: str, mode: i32) -> i64 {
    return fs_open(path, FS_O_WRONLY | FS_O_CREAT | FS_O_TRUNC, mode);
}

pub fun fs_open_append(path: str, mode: i32) -> i64 {
    return fs_open(path, FS_O_WRONLY | FS_O_CREAT | FS_O_APPEND, mode);
}

pub fun fs_open_rw(path: str, mode: i32) -> i64 {
    return fs_open(path, FS_O_RDWR | FS_O_CREAT, mode);
}

pub fun fs_close(fd: i64) -> i64 {
    return io_close(fd);
}

pub fun fs_file_size(path: str) -> i64 {
    var fd: i64 = fs_open_read(path);
    if (fd < 0) {
        return fd;
    }

    var sz: i64 = fs_file_size_fd(fd);
    var cr: i64 = io_close(fd);

    if (sz < 0) {
        return sz;
    }

    if (cr < 0) {
        return cr;
    }

    return sz;
}

pub fun fs_file_size_fd(fd: i64) -> i64 {
    var cur: i64 = lseek(fd, 0, FS_SEEK_CUR);
    if (cur < 0) {
        return cur;
    }

    var end: i64 = lseek(fd, 0, FS_SEEK_END);
    if (end < 0) {
        lseek(fd, cur, FS_SEEK_SET);
        return end;
    }

    var restore: i64 = lseek(fd, cur, FS_SEEK_SET);
    if (restore < 0) {
        return restore;
    }

    return end;
}

pub fun fs_remove(path: str) -> i64 {
    return unlink(path);
}

pub fun fs_mkdir(path: str, mode: i32) -> i64 {
    return mkdir(path, mode);
}

pub fun fs_rmdir(path: str) -> i64 {
    return rmdir(path);
}

pub fun fs_read_all(path: str, dst: ptr<u8>, dst_cap: i64) -> i64 {
    if (dst_cap < 0) {
        return IO_ERR_INVALID;
    }

    var fd: i64 = fs_open_read(path);
    if (fd < 0) {
        return fd;
    }

    var sz: i64 = fs_file_size_fd(fd);
    if (sz < 0) {
        io_close(fd);
        return sz;
    }

    if (sz > dst_cap) {
        io_close(fd);
        return IO_ERR_NO_SPACE;
    }

    var n: i64 = io_read_exact(fd, dst, sz);
    var cr: i64 = io_close(fd);

    if (n < 0) {
        return n;
    }

    if (cr < 0) {
        return cr;
    }

    return n;
}

pub fun fs_write_all(path: str, src: ptr<u8>, len: i64, mode: i32) -> i64 {
    if (len < 0) {
        return IO_ERR_INVALID;
    }

    var fd: i64 = fs_open_write(path, mode);
    if (fd < 0) {
        return fd;
    }

    var n: i64 = io_write_all(fd, src, len);
    var cr: i64 = io_close(fd);

    if (n < 0) {
        return n;
    }

    if (cr < 0) {
        return cr;
    }

    return n;
}

pub fun fs_append_all(path: str, src: ptr<u8>, len: i64, mode: i32) -> i64 {
    if (len < 0) {
        return IO_ERR_INVALID;
    }

    var fd: i64 = fs_open_append(path, mode);
    if (fd < 0) {
        return fd;
    }

    var n: i64 = io_write_all(fd, src, len);
    var cr: i64 = io_close(fd);

    if (n < 0) {
        return n;
    }

    if (cr < 0) {
        return cr;
    }

    return n;
}

pub fun fs_copy(
    src_path: str,
    dst_path: str,
    scratch: ptr<u8>,
    scratch_cap: i64,
    mode: i32
) -> i64 {
    if (scratch_cap <= 0) {
        return IO_ERR_INVALID;
    }

    var src_fd: i64 = fs_open_read(src_path);
    if (src_fd < 0) {
        return src_fd;
    }

    var dst_fd: i64 = fs_open_write(dst_path, mode);
    if (dst_fd < 0) {
        io_close(src_fd);
        return dst_fd;
    }

    var copied: i64 = io_copy(src_fd, dst_fd, scratch, scratch_cap);

    var src_cr: i64 = io_close(src_fd);
    var dst_cr: i64 = io_close(dst_fd);

    if (copied < 0) {
        return copied;
    }

    if (src_cr < 0) {
        return src_cr;
    }

    if (dst_cr < 0) {
        return dst_cr;
    }

    return copied;
}
